&НаСервере
// ДопДанные502 - Структура с полями, перечисленными в README.
// Дополнительные поля не подменяются вымышленными значениями.
Функция ВозвратПокупателя_СформироватьXML_УКД_502(ДокВыгрузки, ДопДанные502 = Неопределено) Экспорт
	ИдОтпр = УКД502_Поле(ДопДанные502, "ИдОтпр");
	ИдПол = УКД502_Поле(ДопДанные502, "ИдПол");
	Если Не ЗначениеЗаполнено(ИдОтпр) Или Не ЗначениеЗаполнено(ИдПол) Тогда
		ВызватьИсключение "УКД 5.02: передайте реальные ИдОтпр и ИдПол в ДопДанные502.";
	КонецЕсли;  
	
	ДатаУКД = ДокВыгрузки.Дата;
	
	СведенияОПоставщике = ЗначенияСервера.СведенияОЮрФизЛице(ДокВыгрузки.Организация, ДатаУКД);
	СведенияОПокупателе = ЗначенияСервера.СведенияОЮРФизЛице(ДокВыгрузки.Контрагент, ДатаУКД);
	
	НовыйУникальныйИдентификатор = Новый УникальныйИдентификатор;
	ДатаДляИндифик = ТекущаяДата();
	Год   = Строка(Формат(ДатаДляИндифик, "ДФ=гггг")); // Год
	Месяц = Строка(Формат(ДатаДляИндифик, "ДФ=ММ"));   // Месяц
	День  = Строка(Формат(ДатаДляИндифик, "ДФ=дд"));   // День
	
	ДатаПреобразоваянная = Год + Месяц + День;
	
	ЗаписьXML = Новый ЗаписьXML;
	
	ЗаписьXML.УстановитьСтроку();
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Файл");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsd","http://www.w3.org/2001/XMLSchema");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi","http://www.w3.org/2001/XMLSchema-instance");
	
	// Значение ИдФайл должно использоваться и как имя файла при сохранении.
	ИдФайл = "ON_NKORSCHFDOPPR_" + ИдПол + "_" + ИдОтпр + "_" + ДатаПреобразоваянная + "_" + Строка(НовыйУникальныйИдентификатор);
	СуффиксИмени = УКД502_Поле(ДопДанные502, "СуффиксИмениФайла", "");
	Если ЗначениеЗаполнено(СуффиксИмени) Тогда
		ИдФайл = ИдФайл + "_" + СуффиксИмени;
	КонецЕсли;
	Если СтрДлина(ИдФайл) > 255 Тогда
		ВызватьИсключение "УКД 5.02: длина ИдФайл превышает 255 символов.";
	КонецЕсли;
	ЗаписьXML.ЗаписатьАтрибут("ИдФайл", ИдФайл);	
	ЗаписьXML.ЗаписатьАтрибут("ВерсФорм", "5.02");
	ЗаписьXML.ЗаписатьАтрибут("ВерсПрог", "1.0");
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Документ");	
	ЗаписьXML.ЗаписатьАтрибут("КНД", "1115133");
	УКД502_АтрибутИз(ЗаписьXML, ДопДанные502, "УИД"); 	
	ЗаписьXML.ЗаписатьАтрибут("ПоФактХЖ", "Документ, подтверждающий согласие (факт уведомления) покупателя на изменение стоимости отгруженных товаров (выполненных работ, оказанных услуг), переданных имущественных прав");
	ЗаписьXML.ЗаписатьАтрибут("НаимДокОпр", "Корректировочный счет-фактура и документ об изменении стоимости отгруженных товаров (выполненных работ, оказанных услуг), переданных имущественных прав");
	ЗаписьXML.ЗаписатьАтрибут("ДатаИнфПр", УКД502_Дата(ДатаУКД));
	ЗаписьXML.ЗаписатьАтрибут("ВремИнфПр", Формат(ТекущаяДата(), "ДФ=ЧЧ.мм.сс"));
	ЗаписьXML.ЗаписатьАтрибут("НаимЭконСубОформ", ДокВыгрузки.Организация.НаименованиеПолное);
	ЗаписьXML.ЗаписатьАтрибут("Функция", "КСЧФДИС");
	УКД502_АтрибутИз(ЗаписьXML, ДопДанные502, "СоглСтрДопИнф");
	// В порядке XSD ОснДоверОргОформ расположен ПЕРЕД СвКСчФ.
	ОснДоверОргОформ = УКД502_Поле(ДопДанные502, "ОснДоверОргОформ");
	Если ОснДоверОргОформ <> Неопределено Тогда
		УКД502_ЗаписатьРеквДок(ЗаписьXML, "ОснДоверОргОформ", ОснДоверОргОформ);
	КонецЕсли;
	
	УчетныйНомер = ?(ЗначениеЗаполнено(ДокВыгрузки.НомерКоррСчф),ДокВыгрузки.НомерКоррСчф,ДокВыгрузки.Номер);
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвКСчФ");
	ЗаписьXML.ЗаписатьАтрибут("НомерДок", УчетныйНомер);
	ЗаписьXML.ЗаписатьАтрибут("ДатаДок", УКД502_Дата(ДокВыгрузки.Дата));
	ИспрКСчФ = УКД502_Поле(ДопДанные502, "ИспрКСчФ");
	Если ИспрКСчФ <> Неопределено Тогда
		УКД502_Обязательное(УКД502_Поле(ИспрКСчФ, "НомИспрКСчФ"), "ИспрКСчФ.НомИспрКСчФ");
		УКД502_Обязательное(УКД502_Поле(ИспрКСчФ, "ДатаИспрКСчФ"), "ИспрКСчФ.ДатаИспрКСчФ");
		ЗаписьXML.ЗаписатьНачалоЭлемента("ИспрКСчФ");
		УКД502_Атрибуты(ЗаписьXML, ИспрКСчФ, "НомИспрКСчФ,ДатаИспрКСчФ");
		ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЕсли;
	
	
	
	ИсходныйДокНомер = ?(ЗначениеЗаполнено(ДокВыгрузки.ДокументОснование.НомерСчф),ДокВыгрузки.ДокументОснование.НомерСчф,ДокВыгрузки.ДокументОснование.Номер);
	ИсходныйДокДата =ДокВыгрузки.ДокументОснование.Дата;
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("СчФ");
	ЗаписьXML.ЗаписатьАтрибут("НомерСчФ", ИсходныйДокНомер);
	ЗаписьXML.ЗаписатьАтрибут("ДатаСчФ", УКД502_Дата(ИсходныйДокДата));
	ИспрСчФ = УКД502_Поле(ДопДанные502, "ИспрСчФ");
	Если ИспрСчФ <> Неопределено Тогда
		Если ТипЗнч(ИспрСчФ) <> Тип("Массив") Тогда
			ОднаПравка = ИспрСчФ;
			ИспрСчФ = Новый Массив;
			ИспрСчФ.Добавить(ОднаПравка);
		КонецЕсли;
		Для Каждого Правка Из ИспрСчФ Цикл
			ЗаписьXML.ЗаписатьНачалоЭлемента("ИспрСчФ");
			УКД502_Обязательное(УКД502_Поле(Правка, "НомИспрСчФ"), "ИспрСчФ.НомИспрСчФ");
			УКД502_Обязательное(УКД502_Поле(Правка, "ДатаИспрСчФ"), "ИспрСчФ.ДатаИспрСчФ");
			УКД502_Атрибуты(ЗаписьXML, Правка, "НомИспрСчФ,ДатаИспрСчФ");
			ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЦикла;
	КонецЕсли;
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	// Участники; адреса ГАР / РФ / текстовые - взаимоисключающие варианты XSD.
	УКД502_ЗаписатьУчастника(ЗаписьXML, "СвПрод", ДокВыгрузки.Организация,
		СведенияОПоставщике, УКД502_Поле(ДопДанные502, "Продавец"),
		УКД502_Поле(ДопДанные502, "АдрГАРПродавца"));
	УКД502_ЗаписатьУчастника(ЗаписьXML, "СвПокуп", ДокВыгрузки.Контрагент,
		СведенияОПокупателе, УКД502_Поле(ДопДанные502, "Покупатель"),
		УКД502_Поле(ДопДанные502, "АдрГАРПокупателя"));

	ЗаписьXML.ЗаписатьНачалоЭлемента("ДенИзм");
	ЗаписьXML.ЗаписатьАтрибут("КодОКВ", "643");
	ЗаписьXML.ЗаписатьАтрибут("НаимОКВ", "Российский рубль");
	ЗаписьXML.ЗаписатьАтрибут("КурсВал", "1.0000");
	ЗаписьXML.ЗаписатьКонецЭлемента();

	ЗаписьXML.ЗаписатьНачалоЭлемента("ДопСвФХЖ1");
	ДопСвДок = УКД502_Поле(ДопДанные502, "ДопСвФХЖ1");
	УКД502_Атрибуты(ЗаписьXML, ДопСвДок, "СпОбстФКСЧФ,СпОбстФКСЧФДИС,СпОбстФДИС");
	ИдГосКон = УКД502_Поле(ДопСвДок, "ИдГосКон");
	Если Не УКД502_Заполнено(ИдГосКон) Тогда
		Попытка
			ИдГосКон = ДокВыгрузки.ДоговорВзаиморасчетов.ИдентификаторГосударственногоКонтракта;
		Исключение
			ИдГосКон = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если УКД502_Заполнено(ИдГосКон) Тогда
		ЗаписьXML.ЗаписатьАтрибут("ИдГосКон", УКД502_Текст(ИдГосКон));
	КонецЕсли;
	// Новые реквизиты обязательств и казначейского сопровождения.
	УКД502_ЗаписатьВидОбяз(ЗаписьXML, УКД502_Поле(ДопДанные502, "ВидОбяз"));
	УКД502_ЗаписатьИнфПродЗаГоскКазн(ЗаписьXML,
		УКД502_Поле(ДопДанные502, "ИнфПродЗаГоскКазн"));
	ЗаписьXML.ЗаписатьКонецЭлемента();

	// Если переданы реквизиты 5.02 - используем их; иначе оставляем существующий
	// генератор из конфигурации (его результат отдельно необходимо проверять).
	ИнфПолФХЖ1_502 = УКД502_Поле(ДопДанные502, "ИнфПолФХЖ1");
	Если ИнфПолФХЖ1_502 <> Неопределено Тогда
		УКД502_ЗаписатьИнфПолФХЖ1(ЗаписьXML, ИнфПолФХЖ1_502);
	Иначе
		ЗаписатьИнфПолФХЖ1(ЗаписьXML, ДокВыгрузки.Контрагент);
	КонецЕсли;

	ЗаписьXML.ЗаписатьКонецЭлемента();

	//Табличная часть
	ЗаписьXML.ЗаписатьНачалоЭлемента("ТаблКСчФ");
	СуммаБезНДСУменьшение = 0;
	СуммаНДСУменьшение = 0;
	СуммаУменьшение = 0;
	
	Для Каждого ТекСтрока Из ДокВыгрузки.Товары Цикл
		ДопТовар = УКД502_Поле(УКД502_Поле(ДопДанные502, "Товары"),
			Строка(ТекСтрока.НомерСтроки));
		ЗаписьXML.ЗаписатьНачалоЭлемента("СведТов");
		
		Стр_ПозНомер = ТекСтрока.НомерСтроки;
		Стр_ПозНаименование = ТекСтрока.Номенклатура;
		Стр_ЕИНаименование = ТекСтрока.Номенклатура.ЕдиницаИзмерения;
		Стр_ЕИКод = ТекСтрока.Номенклатура.ЕдиницаИзмерения.Код;
		
		Стр_СтавкаНДС = ТекСтрока.СтавкаНДС;
		Стр_ЦенаБезНДСДо = 0;
		СтавкаНДСДо = ТекСтрока.СтавкаНДС;
		
		Стр_КоличествоДо = 0;
		Стр_СуммаБезНДСДо = 0;			
		Стр_СуммаНДСДо = 0;			
		Стр_СуммаДо = 0;			
		
		НайденныеСтроки = ДокВыгрузки.ДокументОснование.Товары.НайтиСтроки(Новый Структура("Номенклатура", ТекСтрока.Номенклатура));
		Для каждого текСтрокаОснование Из НайденныеСтроки Цикл
			Стр_КоличествоДо = текСтрокаОснование.Количество;			
			Стр_СуммаБезНДСДо = текСтрокаОснование.Сумма - текСтрокаОснование.СуммаНДС;			
			Стр_СуммаНДСДо = текСтрокаОснование.СуммаНДС;			
			Стр_СуммаДо = текСтрокаОснование.Сумма;
			Если Стр_КоличествоДо <> 0 Тогда
				Стр_ЦенаБезНДСДо = Стр_СуммаБезНДСДо / Стр_КоличествоДо;
			КонецЕсли;
			СтавкаНДСДо = текСтрокаОснование.СтавкаНДС;
		КонецЦикла; 
		
		Стр_КоличествоПосле = Стр_КоличествоДо - ТекСтрока.Количество;
		Если Стр_КоличествоПосле=0 Тогда
			Стр_ЦенаБезНДСПосле = 0;
		Иначе
			Стр_ЦенаБезНДСПосле = Стр_ЦенаБезНДСДо;			
		КонецЕсли; 
		
		Стр_СуммаБезНДСПосле = Стр_СуммаБезНДСДо - (ТекСтрока.Сумма - ТекСтрока.СуммаНДС);			
		Стр_СуммаБезНДСУвеличение = 0;			
		Стр_СуммаБезНДСУменьшение = ТекСтрока.Сумма - ТекСтрока.СуммаНДС;	
		
		Стр_СуммаНДСПосле = Стр_СуммаНДСДо - ТекСтрока.СуммаНДС;			
		Стр_СуммаНДСУвеличение = 0;			
		Стр_СуммаНДСУменьшение = ТекСтрока.СуммаНДС;
		
		Стр_СуммаПосле = Стр_СуммаДо - ТекСтрока.Сумма;			
		Стр_СуммаУвеличение = 0;			
		Стр_СуммаУменьшение = ТекСтрока.Сумма;					
		
		//В поле КодТов выгрузка зависит от настроек:
		//1. В карточке заполнено
		//1.1. В карточке выбран ЧертежныйНомер , то приоритеты в порядке убывания: 	1. Чертежный номер	2. КодКаталога
		//1.2. В карточке выбран Артикул, 		  то приоритеты в порядке убывания: 	1. Артикул,			2. КодКаталога;
		//1.3  В карточке выбран КодКаталога, 	  то приоритеты в порядке убывания:		1. КодКаталога		2. ЧертежныйНомер
		//2. В карточке не заполнено. 			  приоритеты в порядке убывания: 		1. Чертежный номер 	2. Артикул, 		3.КодКаталога. 
		
		КодТов = "";
		Если ДокВыгрузки.Контрагент.ЗаполнениеКодаТовара = "КодКаталога" тогда
			КодТов = ?(ЗначениеЗаполнено(СокрЛП(ТекСтрока.Номенклатура.КодКаталога)), СокрЛП(ТекСтрока.Номенклатура.КодКаталога), ТекСтрока.Номенклатура.ЧертежныйНомер);
		ИначеЕсли ДокВыгрузки.Контрагент.ЗаполнениеКодаТовара = "Артикул" тогда
			КодТов = ?(ЗначениеЗаполнено(СокрЛП(ТекСтрока.Номенклатура.Артикул)), СокрЛП(ТекСтрока.Номенклатура.Артикул), ТекСтрока.Номенклатура.КодКаталога);	
		ИначеЕсли ДокВыгрузки.Контрагент.ЗаполнениеКодаТовара = "ЧертежныйНомер" тогда
			КодТов = ?(ЗначениеЗаполнено(СокрЛП(ТекСтрока.Номенклатура.Артикул)), СокрЛП(ТекСтрока.Номенклатура.Артикул), СокрЛП(ТекСтрока.Номенклатура.КодКаталога));
			КодТов = ?(ЗначениеЗаполнено(СокрЛП(ТекСтрока.Номенклатура.ЧертежныйНомер)),СокрЛП(ТекСтрока.Номенклатура.ЧертежныйНомер), КодТов);	
		Иначе
			КодТов = ?(ЗначениеЗаполнено(СокрЛП(ТекСтрока.Номенклатура.Артикул)), СокрЛП(ТекСтрока.Номенклатура.Артикул), СокрЛП(ТекСтрока.Номенклатура.КодКаталога));
			КодТов = ?(ЗначениеЗаполнено(СокрЛП(ТекСтрока.Номенклатура.ЧертежныйНомер)),СокрЛП(ТекСтрока.Номенклатура.ЧертежныйНомер), КодТов);
		КонецЕсли;
		
		ЗаписьXML.ЗаписатьАтрибут("НомСтр", Строка(Стр_ПозНомер));
		ЗаписьXML.ЗаписатьАтрибут("НаимТов", СокрЛП(Стр_ПозНаименование));
		ЗаписьXML.ЗаписатьАтрибут("ПорНомТовВСЧФ", Строка(Стр_ПозНомер));
		ЗаписьXML.ЗаписатьАтрибут("ОКЕИ_Тов", СокрЛП(Стр_ЕИКод));
		ЗаписьXML.ЗаписатьАтрибут("НаимЕдИзм", Строка(Стр_ЕИНаименование.Наименование));
		ЗаписьXML.ЗаписатьАтрибут("КолТовДо", Строка(Формат(Стр_КоличествоДо,"ЧДЦ=11; ЧРД=.; ЧН=; ЧГ=0")));
		ЗаписьXML.ЗаписатьАтрибут("КолТовПосле", Строка(Формат(Стр_КоличествоПосле,"ЧДЦ=11; ЧРД=.; ЧН=; ЧГ=0")));
		ЗаписьXML.ЗаписатьАтрибут("ЦенаТовДо", Строка(Формат(Стр_ЦенаБезНДСДо,"ЧДЦ=11; ЧРД=.; ЧН=; ЧГ=0")));
		ЗаписьXML.ЗаписатьАтрибут("ЦенаТовПосле", Строка(Формат(Стр_ЦенаБезНДСПосле,"ЧДЦ=11; ЧРД=.; ЧН=; ЧГ=0")));
		Если Стр_СтавкаНДС = Справочники.СтавкиНДС.БезНДС Тогда
			ЗаписьXML.ЗаписатьАтрибут("НалСт", "без НДС");
		Иначе
			ЗаписьXML.ЗаписатьАтрибут("НалСт", ЗначенияСервера.ПреобразуемСтавкиНДС(Стр_СтавкаНДС).Ставка);
		КонецЕсли;
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("СтТовБезНДС");
		ЗаписьXML.ЗаписатьАтрибут("СтоимДоИзм", Строка(Формат(Стр_СуммаБезНДСДо,"ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0")));
		ЗаписьXML.ЗаписатьАтрибут("СтоимПослеИзм", Строка(Формат(Стр_СуммаБезНДСПосле,"ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0")));
		Если Стр_СуммаБезНДСУменьшение > 0 Тогда
			ЗаписьXML.ЗаписатьАтрибут("СтоимУм", Строка(Формат(Стр_СуммаБезНДСУменьшение,"ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0")));
		КонецЕсли;
		ЗаписьXML.ЗаписатьКонецЭлемента(); 
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("АкцизДо");
		ЗаписьXML.ЗаписатьНачалоЭлемента("БезАкциз");
		ЗаписьXML.ЗаписатьТекст("без акциза");
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("АкцизПосле");
		ЗаписьXML.ЗаписатьНачалоЭлемента("БезАкциз");
		ЗаписьXML.ЗаписатьТекст("без акциза");
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		// Для товара без акциза разница равна нулю.
		ЗаписьXML.ЗаписатьНачалоЭлемента("АкцизРазн");
		ЗаписьXML.ЗаписатьНачалоЭлемента("СумУм");
		ЗаписьXML.ЗаписатьТекст("0.00");
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();

		ЗаписьXML.ЗаписатьНачалоЭлемента("СумНалДо");
		Если СтавкаНДСДо=Справочники.СтавкиНДС.БезНДС тогда          
			ЗаписьXML.ЗаписатьНачалоЭлемента("БезНДС");
			ЗаписьXML.ЗаписатьТекст("без НДС");
			ЗаписьXML.ЗаписатьКонецЭлемента();
		иначе
			ЗаписьXML.ЗаписатьНачалоЭлемента("СумНДС");
			ЗаписьXML.ЗаписатьТекст(Строка(Формат(Стр_СуммаНДСДо,"ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0")));
			ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЕсли;
		ЗаписьXML.ЗаписатьКонецЭлемента();//СумНалДо
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("СумНалПосле");
		Если ТекСтрока.СтавкаНДС=Справочники.СтавкиНДС.БезНДС тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента("БезНДС");
			ЗаписьXML.ЗаписатьТекст("без НДС");
			ЗаписьXML.ЗаписатьКонецЭлемента();
		иначе
			ЗаписьXML.ЗаписатьНачалоЭлемента("СумНДС");
			ЗаписьXML.ЗаписатьТекст(Строка(Формат(Стр_СуммаНДСПосле,"ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0")));
			ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЕсли;
		ЗаписьXML.ЗаписатьКонецЭлемента();//СумНалПосле
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("СумНалРазн");
		ЗаписьXML.ЗаписатьНачалоЭлемента("СумУм");
		ЗаписьXML.ЗаписатьТекст(Строка(Формат(Стр_СуммаНДСУменьшение,"ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0")));
		ЗаписьXML.ЗаписатьКонецЭлемента();//СумУм
		ЗаписьXML.ЗаписатьКонецЭлемента();//СумНалРазн
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("СтТовУчНал");
		ЗаписьXML.ЗаписатьАтрибут("СтоимДоИзм", Строка(Формат(Стр_СуммаДо,"ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0")));
		ЗаписьXML.ЗаписатьАтрибут("СтоимПослеИзм", Строка(Формат(Стр_СуммаПосле,"ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0")));
		Если Стр_СуммаУменьшение > 0 Тогда
			ЗаписьXML.ЗаписатьАтрибут("СтоимУм", Строка(Формат(Стр_СуммаУменьшение,"ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0")));
		КонецЕсли;
		ЗаписьXML.ЗаписатьКонецЭлемента();//СтТовУчНал 
		
		// Таможенные декларации и пользовательские поля товара - перед ДопСведТов.
		УКД502_ЗаписатьСвДТ(ЗаписьXML, УКД502_Поле(ДопТовар, "СвДТ"));
		УКД502_ЗаписатьИнфПолФХЖ2(ЗаписьXML, УКД502_Поле(ДопТовар, "ИнфПолФХЖ2"));
		ЗаписьXML.ЗаписатьНачалоЭлемента("ДопСведТов");
		УКД502_Атрибуты(ЗаписьXML, УКД502_Поле(ДопТовар, "ДопСведТов"),
			"ПрТовРаб,ДопПризн,ХарактерТов,СортТов,СерияТов,АртикулТов,КодКат,КодВидТов,КодВидПр,КодТовОКПД2");
		Если КодТов <> "" тогда
			ЗаписьXML.ЗаписатьАтрибут("КодТов", КодТов);   
		КонецЕсли;
		// Порядок в ДопСведТов: прослеживаемость, маркировка, гос. системы.
		УКД502_ЗаписатьСведПрослеж(ЗаписьXML, УКД502_Поле(ДопТовар, "СведПрослеж"));
		///Маркировка///
		мКИЗ_Отгрузки = ПолучитьКИЗ_УКД(ДокВыгрузки.ДокументОснование,ТекСтрока.Номенклатура,ДокВыгрузки.Дата,Ложь);
		мКИЗ_Возврата = ПолучитьКИЗ_УКД(ДокВыгрузки.ДокументОснование,ТекСтрока.Номенклатура,ДокВыгрузки.Дата,Истина);
				
		ДопМаркировка = УКД502_Поле(ДопТовар, "Маркировка");
		УКД502_ЗаписатьМаркировку(ЗаписьXML, "НомСредИдентТовДо", мКИЗ_Отгрузки,
			УКД502_Поле(ДопМаркировка, "До"));
		УКД502_ЗаписатьМаркировку(ЗаписьXML, "НомСредИдентТовПосле", мКИЗ_Возврата,
			УКД502_Поле(ДопМаркировка, "После"));
		УКД502_ЗаписатьСвГосСист(ЗаписьXML, УКД502_Поле(ДопТовар, "СвГосСист"));
		///Маркировка///
		ЗаписьXML.ЗаписатьКонецЭлемента();//ДопСведТов
		
		ЗаписьXML.ЗаписатьКонецЭлемента();//СведТов
		
		СуммаБезНДСУменьшение = СуммаБезНДСУменьшение+Стр_СуммаБезНДСУменьшение;
		СуммаНДСУменьшение = СуммаНДСУменьшение+Стр_СуммаНДСУменьшение;
		СуммаУменьшение = СуммаУменьшение+Стр_СуммаУменьшение;
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ВсегоУм");
	ЗаписьXML.ЗаписатьАтрибут("СтТовБезНДСВсего", Строка(Формат(СуммаБезНДСУменьшение,"ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0")));
	ЗаписьXML.ЗаписатьАтрибут("СтТовУчНалВсего", Строка(Формат(СуммаУменьшение,"ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0")));
	ЗаписьXML.ЗаписатьНачалоЭлемента("СумНалВсего");
	Если СуммаНДСУменьшение = 0 И ДокВыгрузки.Товары.Количество() > 0 И ДокВыгрузки.Товары[0].СтавкаНДС = Справочники.СтавкиНДС.БезНДС Тогда
		ЗаписьXML.ЗаписатьНачалоЭлемента("БезНДС");
		ЗаписьXML.ЗаписатьТекст("без НДС");
	Иначе
		ЗаписьXML.ЗаписатьНачалоЭлемента("СумНДС");
			ЗаписьXML.ЗаписатьТекст(Строка(Формат(СуммаНДСУменьшение,"ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0")));
	КонецЕсли;
	ЗаписьXML.ЗаписатьКонецЭлемента();//СумНДС или БезНДС
	ЗаписьXML.ЗаписатьКонецЭлемента(); 
	ЗаписьXML.ЗаписатьКонецЭлемента();
		
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("СодФХЖ3");   
	ЗаписьXML.ЗаписатьАтрибут("СодОпер", УКД502_Поле(ДопДанные502, "СодОпер", "1"));
	ЗаписьXML.ЗаписатьАтрибут("УточСодОпер", "Изменение стоимости товаров и услуг");
	УКД502_Атрибуты(ЗаписьXML, ДопДанные502, "ИныеСвИзмСтоим,ДатаНапр");
	
	ПередатДок = УКД502_Поле(ДопДанные502, "ПередатДокум");
	Если ПередатДок = Неопределено Тогда
		ПередатДок = Новый Структура("РеквНаимДок,РеквНомерДок,РеквДатаДок",
			"Универсальный передаточный документ", Строка(ИсходныйДокНомер), ИсходныйДокДата);
	КонецЕсли;
	УКД502_ЗаписатьРеквДок(ЗаписьXML, "ПередатДокум", ПередатДок);
	ОснКор = УКД502_Поле(ДопДанные502, "ДокумОснКор");
	Если ОснКор = Неопределено Тогда
		Если ЗначениеЗаполнено(ДокВыгрузки.ДоговорВзаиморасчетов) Тогда
			ОснКор = Новый Структура("РеквНаимДок,РеквНомерДок,РеквДатаДок",
				"Договор", Строка(ДокВыгрузки.ДоговорВзаиморасчетов.Номер),
				ДокВыгрузки.ДоговорВзаиморасчетов.НачПериода);
		Иначе
			ВызватьИсключение "УКД 5.02: не указан документ-основание корректировки (ДокумОснКор).";
		КонецЕсли;
	КонецЕсли;
	УКД502_ЗаписатьРеквДок(ЗаписьXML, "ДокумОснКор", ОснКор);
	ЗаписьXML.ЗаписатьКонецЭлемента();//СодФХЖ3
		
	// Подписант: реальные данные вместо фиктивных Ф/И/О.
	Подписант = УКД502_Поле(ДопДанные502, "Подписант",
		УКД502_Поле(ДокВыгрузки, "Подписант"));
	УКД502_ЗаписатьПодписанта(ЗаписьXML, Подписант);

	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	Возврат ЗаписьXML.Закрыть();
КонецФункции

// --------------------- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ 5.02 ---------------------

Функция УКД502_Поле(Источник, Имя, ПоУмолчанию = Неопределено)
	Если Источник = Неопределено Или Источник = Null Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Попытка
		Если ТипЗнч(Источник) = Тип("Структура") Или ТипЗнч(Источник) = Тип("ФиксированнаяСтруктура") Тогда
			Результат = Неопределено;
			Если Источник.Свойство(Имя, Результат) Тогда
				Возврат Результат;
			КонецЕсли;
		ИначеЕсли ТипЗнч(Источник) = Тип("Соответствие") Или ТипЗнч(Источник) = Тип("ФиксированноеСоответствие") Тогда
			Результат = Источник.Получить(Имя);
			Если Результат <> Неопределено Тогда
				Возврат Результат;
			КонецЕсли;
		Иначе
			Возврат Источник[Имя];
		КонецЕсли;
	Исключение
		// Реквизит может отсутствовать в конкретной конфигурации 1С.
	КонецПопытки;
	Возврат ПоУмолчанию;
КонецФункции

Функция УКД502_Заполнено(Значение)
	Если Значение = Неопределено Или Значение = Null Тогда Возврат Ложь; КонецЕсли;
	// Ноль - допустимое заполненное число для некоторых количеств и сумм.
	Если ТипЗнч(Значение) = Тип("Число") Тогда Возврат Истина; КонецЕсли;
	Возврат ЗначениеЗаполнено(Значение);
КонецФункции

Функция УКД502_Текст(Значение)
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		// XML Schema требует точку как десятичный разделитель и отсутствие групп разрядов.
		Возврат СтрЗаменить(СтрЗаменить(СокрЛП(Строка(Значение)), " ", ""), ",", ".");
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
КонецФункции

Функция УКД502_Дата(Значение)
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=дд.ММ.гггг");
	КонецЕсли;
	Возврат УКД502_Текст(Значение);
КонецФункции

Процедура УКД502_АтрибутИз(Запись, Источник, Имя, ИмяВXML = "")
	Значение = УКД502_Поле(Источник, Имя);
	Если Не УКД502_Заполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	Если ИмяВXML = "" Тогда ИмяВXML = Имя; КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Запись.ЗаписатьАтрибут(ИмяВXML, УКД502_Дата(Значение));
	Иначе
		Запись.ЗаписатьАтрибут(ИмяВXML, УКД502_Текст(Значение));
	КонецЕсли;
КонецПроцедуры

Процедура УКД502_Атрибуты(Запись, Источник, Список)
	Для Каждого Имя Из СтрРазделить(Список, ",") Цикл
		УКД502_АтрибутИз(Запись, Источник, Имя);
	КонецЦикла;
КонецПроцедуры

Процедура УКД502_Обязательное(Значение, Имя)
	Если Не УКД502_Заполнено(Значение) Тогда
		ВызватьИсключение "УКД 5.02: не заполнено обязательное поле " + Имя;
	КонецЕсли;
КонецПроцедуры

Процедура УКД502_ЭлементТекст(Запись, Имя, Значение)
	Если Не УКД502_Заполнено(Значение) Тогда Возврат; КонецЕсли;
	Запись.ЗаписатьНачалоЭлемента(Имя);
	Запись.ЗаписатьТекст(УКД502_Текст(Значение));
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура УКД502_ЗаписатьФИО(Запись, Источник)
	Фамилия = УКД502_Поле(Источник, "Фамилия");
	Имя = УКД502_Поле(Источник, "Имя");
	УКД502_Обязательное(Фамилия, "ФИО.Фамилия");
	УКД502_Обязательное(Имя, "ФИО.Имя");
	Запись.ЗаписатьНачалоЭлемента("ФИО");
	Запись.ЗаписатьАтрибут("Фамилия", УКД502_Текст(Фамилия));
	Запись.ЗаписатьАтрибут("Имя", УКД502_Текст(Имя));
	УКД502_АтрибутИз(Запись, Источник, "Отчество");
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура УКД502_ЗаписатьИдСв(Запись, Лицо, ДопЛицо)
	ИНН = УКД502_Текст(УКД502_Поле(Лицо, "ИНН"));
	ТипЛица = УКД502_Текст(УКД502_Поле(ДопЛицо, "ТипЛица"));
	Если ТипЛица = "" Тогда
		Если СтрДлина(ИНН) = 10 Тогда
			ТипЛица = "ЮЛ";
		ИначеЕсли УКД502_Заполнено(УКД502_Поле(Лицо, "ОГРНИП")) Тогда
			ТипЛица = "ИП";
		Иначе
			ТипЛица = "ФЛ";
		КонецЕсли;
	КонецЕсли;
	Запись.ЗаписатьНачалоЭлемента("ИдСв");
	Если ТипЛица = "ЮЛ" Тогда
		УКД502_Обязательное(ИНН, "СвЮЛУч.ИННЮЛ");
		Запись.ЗаписатьНачалоЭлемента("СвЮЛУч");
		Наименование = УКД502_Поле(Лицо, "НаименованиеПолное");
		УКД502_Обязательное(Наименование, "СвЮЛУч.НаимОрг");
		Запись.ЗаписатьАтрибут("НаимОрг", УКД502_Текст(Наименование));
		Запись.ЗаписатьАтрибут("ИННЮЛ", ИНН);
		УКД502_АтрибутИз(Запись, Лицо, "КПП");
		Запись.ЗаписатьКонецЭлемента();
	ИначеЕсли ТипЛица = "ИП" Тогда
		УКД502_Обязательное(ИНН, "СвИП.ИННФЛ");
		ОГРНИП = УКД502_Поле(ДопЛицо, "ОГРНИП", УКД502_Поле(Лицо, "ОГРНИП"));
		ДатаОГРНИП = УКД502_Поле(ДопЛицо, "ДатаОГРНИП", УКД502_Поле(Лицо, "ДатаОГРНИП"));
		УКД502_Обязательное(ОГРНИП, "СвИП.ОГРНИП");
		УКД502_Обязательное(ДатаОГРНИП, "СвИП.ДатаОГРНИП");
		Запись.ЗаписатьНачалоЭлемента("СвИП");
		Запись.ЗаписатьАтрибут("ИННФЛ", ИНН);
		УКД502_АтрибутИз(Запись, ДопЛицо, "СвГосРегИП");
		Запись.ЗаписатьАтрибут("ОГРНИП", УКД502_Текст(ОГРНИП));
		Запись.ЗаписатьАтрибут("ДатаОГРНИП", УКД502_Дата(ДатаОГРНИП));
		УКД502_АтрибутИз(Запись, ДопЛицо, "ИныеСвед");
		УКД502_ЗаписатьФИО(Запись, УКД502_Поле(ДопЛицо, "ФИО"));
		Запись.ЗаписатьКонецЭлемента();
	ИначеЕсли ТипЛица = "ФЛ" Тогда
		Запись.ЗаписатьНачалоЭлемента("СвФЛУч");
		Если СтрДлина(ИНН) = 12 Тогда Запись.ЗаписатьАтрибут("ИННФЛ", ИНН); КонецЕсли;
		УКД502_Атрибуты(Запись, ДопЛицо, "ИдСтатЛ,ИныеСвед");
		УКД502_ЗаписатьФИО(Запись, УКД502_Поле(ДопЛицо, "ФИО"));
		Запись.ЗаписатьКонецЭлемента();
	Иначе
		ВызватьИсключение "УКД 5.02: неизвестный ТипЛица (ЮЛ/ИП/ФЛ): " + ТипЛица;
	КонецЕсли;
	Запись.ЗаписатьКонецЭлемента(); // ИдСв
КонецПроцедуры

Процедура УКД502_ЗаписатьКонтакт(Запись, Контакт)
	Если Контакт = Неопределено Тогда Возврат; КонецЕсли;
	Запись.ЗаписатьНачалоЭлемента("Контакт");
	УКД502_АтрибутИз(Запись, Контакт, "ИнКонт");
	Телефон = УКД502_Поле(Контакт, "Тлф");
	Если ТипЗнч(Телефон) = Тип("Массив") Тогда
		Для Каждого Номер Из Телефон Цикл УКД502_ЭлементТекст(Запись, "Тлф", Номер); КонецЦикла;
	Иначе
		УКД502_ЭлементТекст(Запись, "Тлф", Телефон);
	КонецЕсли;
	Почта = УКД502_Поле(Контакт, "ЭлПочта");
	Если ТипЗнч(Почта) = Тип("Массив") Тогда
		Для Каждого Адрес Из Почта Цикл УКД502_ЭлементТекст(Запись, "ЭлПочта", Адрес); КонецЦикла;
	Иначе
		УКД502_ЭлементТекст(Запись, "ЭлПочта", Почта);
	КонецЕсли;
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура УКД502_ЗаписатьУчастника(Запись, Имя, Лицо, Сведения, ДопЛицо, ДопГАР)
	Запись.ЗаписатьНачалоЭлемента(Имя);
	УКД502_Атрибуты(Запись, ДопЛицо,
		"ОКПО,КодОПФ,ПолнНаимОПФ,СтруктПодр,ИнфДляУчаст,СокрНаим");
	УКД502_ЗаписатьИдСв(Запись, Лицо, ДопЛицо);
	УКД502_ЗаписатьАдрес(Запись, Сведения, Лицо, ДопГАР, ДопЛицо);
	Если УКД502_Заполнено(УКД502_Поле(Сведения, "НомерСчета")) Тогда
		Запись.ЗаписатьНачалоЭлемента("БанкРекв");
		УКД502_АтрибутИз(Запись, Сведения, "НомерСчета");
		Запись.ЗаписатьНачалоЭлемента("СвБанк");
		Банк = УКД502_Поле(Сведения, "Банк");
		ИмяБанка = УКД502_Поле(Банк, "Наименование");
		УКД502_Обязательное(ИмяБанка, "СвБанк.НаимБанк");
		Запись.ЗаписатьАтрибут("НаимБанк", УКД502_Текст(ИмяБанка));
		УКД502_АтрибутИз(Запись, Сведения, "БИК");
		УКД502_АтрибутИз(Запись, Сведения, "КоррСчет", "КорСчет");
		Запись.ЗаписатьКонецЭлемента(); // СвБанк
		Запись.ЗаписатьКонецЭлемента(); // БанкРекв
	КонецЕсли;
	УКД502_ЗаписатьКонтакт(Запись, УКД502_Поле(ДопЛицо, "Контакт"));
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Функция УКД502_Регион(ЮрАдрес, Лицо, ГАР = Неопределено)
	Код = УКД502_Текст(УКД502_Поле(ГАР, "Регион",
		УКД502_Поле(ЮрАдрес, "region_code", УКД502_Поле(ЮрАдрес, "КодРегион"))));
	Если Код = "" Тогда
		СтранаРегион = УКД502_Поле(Лицо, "Страна");
		Если УКД502_Поле(СтранаРегион, "ЭтоСтрана", Истина) = Ложь Тогда
			Код = УКД502_Текст(УКД502_Поле(СтранаРегион, "Код"));
		КонецЕсли;
	КонецЕсли;
	Если СтрДлина(Код) = 3 И Лев(Код, 1) = "0" Тогда Код = Сред(Код, 2); КонецЕсли;
	Возврат Код;
КонецФункции

Процедура УКД502_ЗаписатьВидНаим(Запись, Имя, Источник, АтрибутВида)
	Если Источник = Неопределено Тогда Возврат; КонецЕсли;
	Вид = УКД502_Поле(Источник, АтрибутВида);
	Наим = УКД502_Поле(Источник, "Наим");
	Если Не УКД502_Заполнено(Вид) Или Не УКД502_Заполнено(Наим) Тогда Возврат; КонецЕсли;
	Запись.ЗаписатьНачалоЭлемента(Имя);
	Запись.ЗаписатьАтрибут(АтрибутВида, УКД502_Текст(Вид));
	Запись.ЗаписатьАтрибут("Наим", УКД502_Текст(Наим));
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура УКД502_ЗаписатьНомер(Запись, Имя, Источник)
	Если Источник = Неопределено Тогда Возврат; КонецЕсли;
	Тип = УКД502_Поле(Источник, "Тип");
	Номер = УКД502_Поле(Источник, "Номер");
	Если Не УКД502_Заполнено(Тип) Или Не УКД502_Заполнено(Номер) Тогда Возврат; КонецЕсли;
	Запись.ЗаписатьНачалоЭлемента(Имя);
	Запись.ЗаписатьАтрибут("Тип", УКД502_Текст(Тип));
	Запись.ЗаписатьАтрибут("Номер", УКД502_Текст(Номер));
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура УКД502_ЗаписатьАдрес(Запись, Сведения, Лицо, ДопГАР, ДопЛицо)
	ЮрАдрес = УКД502_Поле(Сведения, "ЮридическийАдрес");
	ГАР = ДопГАР;
	Если ГАР = Неопределено Тогда
		ГАР = УКД502_Поле(ЮрАдрес, "ГАР", УКД502_Поле(ЮрАдрес, "АдресГАР"));
	КонецЕсли;
	Если ГАР = Неопределено И УКД502_Заполнено(УКД502_Поле(ЮрАдрес, "ИдНом")) Тогда
		ГАР = ЮрАдрес;
	КонецЕсли;
	ИдНом = УКД502_Текст(УКД502_Поле(ГАР, "ИдНом"));
	КодРегион = УКД502_Регион(ЮрАдрес, Лицо, ГАР);
	НаимРегион = УКД502_Текст(УКД502_Поле(ГАР, "НаимРегион",
		УКД502_Поле(ЮрАдрес, "region_with_type", УКД502_Поле(ЮрАдрес, "НаимРегион"))));
	// Неполные данные ГАР не заменяем фиктивными. Выбираем РФ или текст.
	ЕстьГАР = СтрДлина(ИдНом) = 36 И СтрДлина(КодРегион) = 2 И УКД502_Заполнено(НаимРегион);
	ЕстьРФ = СтрДлина(КодРегион) = 2 И УКД502_Заполнено(НаимРегион);
	ТекстАдреса = УКД502_Текст(УКД502_Поле(ЮрАдрес, "ИсходныйАдрес"));
	Запись.ЗаписатьНачалоЭлемента("Адрес");
	УКД502_АтрибутИз(Запись, ДопЛицо, "ГЛНМеста");
	Если ЕстьГАР Тогда
		Запись.ЗаписатьНачалоЭлемента("АдрГАР");
		Запись.ЗаписатьАтрибут("ИдНом", ИдНом);
		ПочтовыйИндекс = УКД502_Поле(ГАР, "Индекс", УКД502_Поле(ЮрАдрес, "postal_code"));
		Если УКД502_Заполнено(ПочтовыйИндекс) Тогда
			Запись.ЗаписатьАтрибут("Индекс", УКД502_Текст(ПочтовыйИндекс));
		КонецЕсли;
		Запись.ЗаписатьНачалоЭлемента("Регион");
		Запись.ЗаписатьТекст(КодРегион);
		Запись.ЗаписатьКонецЭлемента();
		УКД502_ЭлементТекст(Запись, "НаимРегион", НаимРегион);
		УКД502_ЗаписатьВидНаим(Запись, "МуниципРайон", УКД502_Поле(ГАР, "МуниципРайон"), "ВидКод");
		УКД502_ЗаписатьВидНаим(Запись, "ГородСелПоселен", УКД502_Поле(ГАР, "ГородСелПоселен"), "ВидКод");
		УКД502_ЗаписатьВидНаим(Запись, "НаселенПункт", УКД502_Поле(ГАР, "НаселенПункт"), "Вид");
		УКД502_ЗаписатьВидНаим(Запись, "ЭлПланСтруктур", УКД502_Поле(ГАР, "ЭлПланСтруктур"), "Тип");
		УКД502_ЗаписатьВидНаим(Запись, "ЭлУлДорСети", УКД502_Поле(ГАР, "ЭлУлДорСети"), "Тип");
		УКД502_ЭлементТекст(Запись, "ЗемелУчасток", УКД502_Поле(ГАР, "ЗемелУчасток"));
		Здания = УКД502_Поле(ГАР, "Здание");
		Если ТипЗнч(Здания) = Тип("Массив") Тогда
			Для Каждого Здание Из Здания Цикл
				УКД502_ЗаписатьНомер(Запись, "Здание", Здание);
			КонецЦикла;
		Иначе
			УКД502_ЗаписатьНомер(Запись, "Здание", Здания);
		КонецЕсли;
		УКД502_ЗаписатьНомер(Запись, "ПомещЗдания", УКД502_Поле(ГАР, "ПомещЗдания"));
		УКД502_ЗаписатьНомер(Запись, "ПомещКвартиры", УКД502_Поле(ГАР, "ПомещКвартиры"));
		Запись.ЗаписатьКонецЭлемента(); // АдрГАР
	ИначеЕсли ЕстьРФ Тогда
		Запись.ЗаписатьНачалоЭлемента("АдрРФ");
		УКД502_АтрибутИз(Запись, ЮрАдрес, "postal_code", "Индекс");
		Запись.ЗаписатьАтрибут("КодРегион", КодРегион);
		Запись.ЗаписатьАтрибут("НаимРегион", НаимРегион);
		УКД502_АтрибутИз(Запись, ЮрАдрес, "city_district_with_type", "Район");
		УКД502_АтрибутИз(Запись, ЮрАдрес, "city_with_type", "Город");
		УКД502_АтрибутИз(Запись, ЮрАдрес, "settlement_with_type", "НаселПункт");
		УКД502_АтрибутИз(Запись, ЮрАдрес, "street_with_type", "Улица");
		УКД502_АтрибутИз(Запись, ЮрАдрес, "house", "Дом");
		УКД502_АтрибутИз(Запись, ЮрАдрес, "block", "Корпус");
		УКД502_АтрибутИз(Запись, ЮрАдрес, "flat", "Кварт");
		УКД502_АтрибутИз(Запись, ЮрАдрес, "ИныеСвед");
		Запись.ЗаписатьКонецЭлемента(); // АдрРФ
	Иначе
		УКД502_Обязательное(ТекстАдреса, "Адрес.АдрИнф.АдрТекст");
		КодСтр = УКД502_Текст(УКД502_Поле(ДопЛицо, "КодСтр",
			УКД502_Поле(УКД502_Поле(Лицо, "Страна"), "КодОКСМ", "643")));
		НаимСтран = УКД502_Текст(УКД502_Поле(ДопЛицо, "НаимСтран"));
		Если НаимСтран = "" И КодСтр = "643" Тогда НаимСтран = "Россия"; КонецЕсли;
		Если НаимСтран = "" Тогда
			НаимСтран = УКД502_Текст(УКД502_Поле(УКД502_Поле(Лицо, "Страна"), "Наименование"));
		КонецЕсли;
		УКД502_Обязательное(НаимСтран, "Адрес.АдрИнф.НаимСтран");
		Запись.ЗаписатьНачалоЭлемента("АдрИнф");
		Запись.ЗаписатьАтрибут("КодСтр", КодСтр);
		Запись.ЗаписатьАтрибут("НаимСтран", НаимСтран);
		Запись.ЗаписатьАтрибут("АдрТекст", ТекстАдреса);
		Запись.ЗаписатьКонецЭлемента(); // АдрИнф
	КонецЕсли;
	Запись.ЗаписатьКонецЭлемента(); // Адрес
КонецПроцедуры

Процедура УКД502_ЗаписатьРеквДок(Запись, Имя, Источник)
	Для Каждого Реквизит Из СтрРазделить("РеквНаимДок,РеквНомерДок,РеквДатаДок", ",") Цикл
		УКД502_Обязательное(УКД502_Поле(Источник, Реквизит), Имя + "." + Реквизит);
	КонецЦикла;
	Запись.ЗаписатьНачалоЭлемента(Имя);
	УКД502_Атрибуты(Запись, Источник,
		"РеквНаимДок,РеквНомерДок,РеквДатаДок,РеквИдФайлДок,РеквИдДок,РИдСистХранД,РеквУРЛСистДок,РеквДопСведДок");
	Реквизиты = УКД502_Поле(Источник, "РеквИдРекСост");
	Если Реквизиты <> Неопределено Тогда
		Если ТипЗнч(Реквизиты) = Тип("Массив") Тогда
			Для Каждого Рекв Из Реквизиты Цикл УКД502_ЗаписатьИдРекСост(Запись, Рекв); КонецЦикла;
		Иначе
			УКД502_ЗаписатьИдРекСост(Запись, Реквизиты);
		КонецЕсли;
	КонецЕсли;
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура УКД502_ЗаписатьИдРекСост(Запись, Источник)
	Запись.ЗаписатьНачалоЭлемента("РеквИдРекСост");
	Если УКД502_Заполнено(УКД502_Поле(Источник, "ИННЮЛ")) Тогда
		УКД502_ЭлементТекст(Запись, "ИННЮЛ", УКД502_Поле(Источник, "ИННЮЛ"));
	ИначеЕсли УКД502_Заполнено(УКД502_Поле(Источник, "ИННФЛ")) Тогда
		УКД502_ЭлементТекст(Запись, "ИННФЛ", УКД502_Поле(Источник, "ИННФЛ"));
	ИначеЕсли УКД502_Поле(Источник, "ДаннИно") <> Неопределено Тогда
		Ино = УКД502_Поле(Источник, "ДаннИно");
		УКД502_ЗаписатьДаннИно(Запись, Ино);
	ИначеЕсли УКД502_Заполнено(УКД502_Поле(Источник, "НаимОИВ")) Тогда
		УКД502_ЭлементТекст(Запись, "НаимОИВ", УКД502_Поле(Источник, "НаимОИВ"));
	Иначе
		ВызватьИсключение "УКД 5.02: РеквИдРекСост требует ИННЮЛ, ИННФЛ, ДаннИно или НаимОИВ.";
	КонецЕсли;
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура УКД502_ЗаписатьВидОбяз(Запись, МассивВидов)
	Если МассивВидов = Неопределено Тогда Возврат; КонецЕсли;
	Если ТипЗнч(МассивВидов) = Тип("Массив") Тогда
		Для Каждого Вид Из МассивВидов Цикл
			Запись.ЗаписатьНачалоЭлемента("ВидОбяз");
			УКД502_Атрибуты(Запись, Вид, "КодВидОбяз,НаимВидОбяз");
			Запись.ЗаписатьКонецЭлемента();
		КонецЦикла;
	Иначе
		Запись.ЗаписатьНачалоЭлемента("ВидОбяз");
		УКД502_Атрибуты(Запись, МассивВидов, "КодВидОбяз,НаимВидОбяз");
		Запись.ЗаписатьКонецЭлемента();
	КонецЕсли;
КонецПроцедуры

Процедура УКД502_ЗаписатьИнфПродЗаГоскКазн(Запись, Источник)
	Если Источник = Неопределено Тогда Возврат; КонецЕсли;
	УКД502_Обязательное(УКД502_Поле(Источник, "ДатаГосКонт"), "ИнфПродЗаГоскКазн.ДатаГосКонт");
	УКД502_Обязательное(УКД502_Поле(Источник, "НомерГосКонт"), "ИнфПродЗаГоскКазн.НомерГосКонт");
	Запись.ЗаписатьНачалоЭлемента("ИнфПродЗаГоскКазн");
	УКД502_Атрибуты(Запись, Источник,
		"ДатаГосКонт,НомерГосКонт,ЛицСчетПрод,КодПродБюджКласс,КодЦелиПрод,КодКазначПрод,НаимКазначПрод");
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура УКД502_ЗаписатьСвДТ(Запись, Коллекция)
	Если Коллекция = Неопределено Тогда Возврат; КонецЕсли;
	Если ТипЗнч(Коллекция) <> Тип("Массив") Тогда
		ОдинЭлемент = Коллекция;
		Коллекция = Новый Массив;
		Коллекция.Добавить(ОдинЭлемент);
	КонецЕсли;
	Для Каждого ДТ Из Коллекция Цикл
		Запись.ЗаписатьНачалоЭлемента("СвДТ");
		УКД502_Атрибуты(Запись, ДТ, "КодПроисх,НомерДТДо,НомерДТПосле");
		УКД502_ЭлементТекст(Запись, "КрНаимСтрПр", УКД502_Поле(ДТ, "КрНаимСтрПр"));
		НомУв = УКД502_Поле(ДТ, "НомерДТУв");
		Если УКД502_Заполнено(НомУв) Тогда УКД502_ЭлементТекст(Запись, "НомерДТУв", НомУв); КонецЕсли;
		НомУм = УКД502_Поле(ДТ, "НомерДТУм");
		Если УКД502_Заполнено(НомУм) Тогда УКД502_ЭлементТекст(Запись, "НомерДТУм", НомУм); КонецЕсли;
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
КонецПроцедуры

Процедура УКД502_ЗаписатьИнфПолФХЖ2(Запись, Коллекция)
	Если Коллекция = Неопределено Тогда Возврат; КонецЕсли;
	Если ТипЗнч(Коллекция) <> Тип("Массив") Тогда
		ОдинЭлемент = Коллекция;
		Коллекция = Новый Массив;
		Коллекция.Добавить(ОдинЭлемент);
	КонецЕсли;
	Для Каждого Инфо Из Коллекция Цикл
		УКД502_Обязательное(УКД502_Поле(Инфо, "Идентиф"), "ИнфПолФХЖ2.Идентиф");
		УКД502_Обязательное(УКД502_Поле(Инфо, "Значен"), "ИнфПолФХЖ2.Значен");
		Запись.ЗаписатьНачалоЭлемента("ИнфПолФХЖ2");
		УКД502_Атрибуты(Запись, Инфо, "Идентиф,Значен");
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
КонецПроцедуры

Процедура УКД502_ЗаписатьСведПрослеж(Запись, Коллекция)
	Если Коллекция = Неопределено Тогда Возврат; КонецЕсли;
	Если ТипЗнч(Коллекция) <> Тип("Массив") Тогда
		ОдинЭлемент = Коллекция;
		Коллекция = Новый Массив;
		Коллекция.Добавить(ОдинЭлемент);
	КонецЕсли;
	Для Каждого Прослеж Из Коллекция Цикл
		УКД502_Обязательное(УКД502_Поле(Прослеж, "НомТовПрослеж"), "СведПрослеж.НомТовПрослеж");
		Запись.ЗаписатьНачалоЭлемента("СведПрослеж");
		УКД502_Атрибуты(Запись, Прослеж, "НомТовПрослеж,ЕдИзмПрослеж,НаимЕдИзмПрослеж,ДопИнфПрослеж");
		Кол = УКД502_Поле(Прослеж, "ИзмКолВЕдПрослеж");
		УКД502_Обязательное(Кол, "СведПрослеж.ИзмКолВЕдПрослеж");
		Если Кол <> Неопределено Тогда
			УКД502_Обязательное(УКД502_Поле(Кол, "КолТовЕдПрослежДо"), "СведПрослеж.КолТовЕдПрослежДо");
			УКД502_Обязательное(УКД502_Поле(Кол, "КолТовЕдПрослежПосле"), "СведПрослеж.КолТовЕдПрослежПосле");
			Запись.ЗаписатьНачалоЭлемента("ИзмКолВЕдПрослеж");
			УКД502_Атрибуты(Запись, Кол, "КолТовЕдПрослежДо,КолТовЕдПрослежПосле,КолТовЕдПрослежУвел,КолТовЕдПрослежУм");
			Запись.ЗаписатьКонецЭлемента();
		КонецЕсли;
		Стоимость = УКД502_Поле(Прослеж, "ИзмСтТовБезНДСПрослеж");
		УКД502_Обязательное(Стоимость, "СведПрослеж.ИзмСтТовБезНДСПрослеж");
		Если Стоимость <> Неопределено Тогда
			УКД502_Обязательное(УКД502_Поле(Стоимость, "СтТовБезНДСПрослежДо"), "СведПрослеж.СтТовБезНДСПрослежДо");
			УКД502_Обязательное(УКД502_Поле(Стоимость, "СтТовБезНДСПрослежПосле"), "СведПрослеж.СтТовБезНДСПрослежПосле");
			Запись.ЗаписатьНачалоЭлемента("ИзмСтТовБезНДСПрослеж");
			УКД502_Атрибуты(Запись, Стоимость,
				"СтТовБезНДСПрослежДо,СтТовБезНДСПрослежПосле,СтТовБезНДСПрослежУвел,СтТовБезНДСПрослежУм");
			Запись.ЗаписатьКонецЭлемента();
		КонецЕсли;
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
КонецПроцедуры

Процедура УКД502_ЗаписатьМаркировку(Запись, Имя, КИЗИзУчета, ДопМаркировка)
	Если (КИЗИзУчета = Неопределено Или КИЗИзУчета.Количество() = 0) И ДопМаркировка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Запись.ЗаписатьНачалоЭлемента(Имя);
	УКД502_Атрибуты(Запись, ДопМаркировка,
		"ГТИН,КолВедМарк,КолВедВесМарк,ПрПартМарк,ИдентТрансУпак");
	Если КИЗИзУчета <> Неопределено Тогда
		Для Каждого Марка Из КИЗИзУчета Цикл
			КИЗ = УКД502_Текст(УКД502_Поле(Марка, "КИЗ"));
			Если СтрДлина(КИЗ) > 255 Тогда
				ВызватьИсключение "УКД 5.02: длина КИЗ превышает 255 символов.";
			КонецЕсли;
			УКД502_ЭлементТекст(Запись, "КИЗ", КИЗ);
		КонецЦикла;
	КонецЕсли;
	Упаковки = УКД502_Поле(ДопМаркировка, "НомУпак");
	Если ТипЗнч(Упаковки) = Тип("Массив") Тогда
		Для Каждого Номер Из Упаковки Цикл УКД502_ЭлементТекст(Запись, "НомУпак", Номер); КонецЦикла;
	Иначе
		УКД502_ЭлементТекст(Запись, "НомУпак", Упаковки);
	КонецЕсли;
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура УКД502_ЗаписатьСвГосСист(Запись, Коллекция)
	Если Коллекция = Неопределено Тогда Возврат; КонецЕсли;
	Если ТипЗнч(Коллекция) <> Тип("Массив") Тогда
		ОдинЭлемент = Коллекция;
		Коллекция = Новый Массив;
		Коллекция.Добавить(ОдинЭлемент);
	КонецЕсли;
	Для Каждого ГосСист Из Коллекция Цикл
		УКД502_Обязательное(УКД502_Поле(ГосСист, "НаимГосСист"), "СвГосСист.НаимГосСист");
		УКД502_Обязательное(УКД502_Поле(ГосСист, "ИдНомУчетЕд"), "СвГосСист.ИдНомУчетЕд");
		Запись.ЗаписатьНачалоЭлемента("СвГосСист");
		УКД502_Атрибуты(Запись, ГосСист, "НаимГосСист,УчетЕд,ИнаяИнф");
		УКД502_ЭлементТекст(Запись, "ИдНомУчетЕд", УКД502_Поле(ГосСист, "ИдНомУчетЕд"));
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
КонецПроцедуры

Процедура УКД502_ЗаписатьПодписанта(Запись, Данные)
	Если Данные = Неопределено Тогда
		ВызватьИсключение "УКД 5.02: передайте реального Подписанта (ФИО, СпосПодтПолном) в ДопДанные502.";
	КонецЕсли;
	УКД502_Обязательное(УКД502_Поле(Данные, "СпосПодтПолном"), "Подписант.СпосПодтПолном");
	Запись.ЗаписатьНачалоЭлемента("Подписант");
	УКД502_Атрибуты(Запись, Данные,
		"Должн,ТипПодпис,ДатаПодДок,СпосПодтПолном,ДопСведПодп");
	УКД502_ЗаписатьФИО(Запись, УКД502_Поле(Данные, "ФИО", Данные));
	ДоверЭл = УКД502_Поле(Данные, "СвДоверЭл");
	ДоверБум = УКД502_Поле(Данные, "СвДоверБум");
	Если ДоверЭл <> Неопределено И ДоверБум <> Неопределено Тогда
		ВызватьИсключение "УКД 5.02: СвДоверЭл и СвДоверБум взаимоисключающие в одном Подписант.";
	КонецЕсли;
	Если ДоверЭл <> Неопределено Тогда
		УКД502_Обязательное(УКД502_Поле(ДоверЭл, "НомДовер"), "СвДоверЭл.НомДовер");
		УКД502_Обязательное(УКД502_Поле(ДоверЭл, "ДатаВыдДовер"), "СвДоверЭл.ДатаВыдДовер");
		УКД502_Обязательное(УКД502_Поле(ДоверЭл, "ИдСистХран"), "СвДоверЭл.ИдСистХран");
		Запись.ЗаписатьНачалоЭлемента("СвДоверЭл");
		УКД502_Атрибуты(Запись, ДоверЭл,
			"НомДовер,ДатаВыдДовер,ВнНомДовер,ДатаВнРегДовер,ИдСистХран,УРЛСист");
		Запись.ЗаписатьКонецЭлемента();
	КонецЕсли;
	Если ДоверБум <> Неопределено Тогда
		УКД502_Обязательное(УКД502_Поле(ДоверБум, "ДатаВыдДовер"), "СвДоверБум.ДатаВыдДовер");
		УКД502_Обязательное(УКД502_Поле(ДоверБум, "ВнНомДовер"), "СвДоверБум.ВнНомДовер");
		Запись.ЗаписатьНачалоЭлемента("СвДоверБум");
		УКД502_Атрибуты(Запись, ДоверБум, "ДатаВыдДовер,ВнНомДовер,СвИдДовер");
		Если УКД502_Поле(ДоверБум, "ФИО") <> Неопределено Тогда
			УКД502_ЗаписатьФИО(Запись, УКД502_Поле(ДоверБум, "ФИО"));
		КонецЕсли;
		Запись.ЗаписатьКонецЭлемента();
	КонецЕсли;
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура УКД502_ЗаписатьДаннИно(Запись, Данные)
	Для Каждого Атрибут Из СтрРазделить("ИдСтат,КодСтр,НаимСтран,Наим", ",") Цикл
		УКД502_Обязательное(УКД502_Поле(Данные, Атрибут), "ДаннИно." + Атрибут);
	КонецЦикла;
	Запись.ЗаписатьНачалоЭлемента("ДаннИно");
	УКД502_Атрибуты(Запись, Данные, "ИдСтат,КодСтр,НаимСтран,Наим,Идентиф,ИныеСвед");
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура УКД502_ЗаписатьИнфПолФХЖ1(Запись, Данные)
	Запись.ЗаписатьНачалоЭлемента("ИнфПолФХЖ1");
	УКД502_АтрибутИз(Запись, Данные, "ИдФайлИнфПол");
	Коллекция = УКД502_Поле(Данные, "ТекстИнф");
	Если Коллекция <> Неопределено Тогда
		Если ТипЗнч(Коллекция) <> Тип("Массив") Тогда
			Один = Коллекция;
			Коллекция = Новый Массив;
			Коллекция.Добавить(Один);
		КонецЕсли;
		Для Каждого Инфо Из Коллекция Цикл
			УКД502_Обязательное(УКД502_Поле(Инфо, "Идентиф"), "ИнфПолФХЖ1.ТекстИнф.Идентиф");
			УКД502_Обязательное(УКД502_Поле(Инфо, "Значен"), "ИнфПолФХЖ1.ТекстИнф.Значен");
			Запись.ЗаписатьНачалоЭлемента("ТекстИнф");
			УКД502_Атрибуты(Запись, Инфо, "Идентиф,Значен");
			Запись.ЗаписатьКонецЭлемента();
		КонецЦикла;
	КонецЕсли;
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры
