		Если ТипЗнч(СтрТовар.Номенклатура)=Тип("СправочникСсылка.Номенклатура") Тогда
			ЗаписьXML.ЗаписатьАтрибут("НаимЕдИзм", СтрТовар.Номенклатура.ЕдиницаИзмерения.Наименование);
			
			//В поле Артикул всегда выгружаем артикул
			Если НЕ СтрТовар.Номенклатура.Артикул = "" Тогда
				ЗаписьXML.ЗаписатьАтрибут("АртикулТов", Строка(СтрТовар.Номенклатура.Артикул));
			КонецЕсли;
			
			//В поле КодТов выгрузка зависит от настроек:
			//1. В карточке заполнено
			//1.1. В карточке выбран ЧертежныйНомер , то приоритеты в порядке убывания: 	1. Чертежный номер	2. КодКаталога
			//1.2. В карточке выбран Артикул, 		  то приоритеты в порядке убывания: 	1. Артикул,			2. КодКаталога;
			//1.3  В карточке выбран КодКаталога, 	  то приоритеты в порядке убывания:		1. КодКаталога		2. ЧертежныйНомер
			//2. В карточке не заполнено. 			  приоритеты в порядке убывания: 		1. Чертежный номер 	2. Артикул, 		3.КодКаталога. 
			
			КодТов = "";
			Если ДокВыгрузки.Контрагент.ЗаполнениеКодаТовара = "КодКаталога" тогда
				КодТов = ?(ЗначениеЗаполнено(СокрЛП(СтрТовар.Номенклатура.КодКаталога)), СокрЛП(СтрТовар.Номенклатура.КодКаталога), СтрТовар.Номенклатура.ЧертежныйНомер);
			ИначеЕсли ДокВыгрузки.Контрагент.ЗаполнениеКодаТовара = "Артикул" тогда
				КодТов = ?(ЗначениеЗаполнено(СокрЛП(СтрТовар.Номенклатура.Артикул)), СокрЛП(СтрТовар.Номенклатура.Артикул), СтрТовар.Номенклатура.КодКаталога);	
			ИначеЕсли ДокВыгрузки.Контрагент.ЗаполнениеКодаТовара = "ЧертежныйНомер" тогда
				КодТов = ?(ЗначениеЗаполнено(СокрЛП(СтрТовар.Номенклатура.Артикул)), СокрЛП(СтрТовар.Номенклатура.Артикул), СокрЛП(СтрТовар.Номенклатура.КодКаталога));
				КодТов = ?(ЗначениеЗаполнено(СокрЛП(СтрТовар.Номенклатура.ЧертежныйНомер)),СокрЛП(СтрТовар.Номенклатура.ЧертежныйНомер), КодТов);	
			Иначе
				КодТов = ?(ЗначениеЗаполнено(СокрЛП(СтрТовар.Номенклатура.Артикул)), СокрЛП(СтрТовар.Номенклатура.Артикул), СокрЛП(СтрТовар.Номенклатура.КодКаталога));
				КодТов = ?(ЗначениеЗаполнено(СокрЛП(СтрТовар.Номенклатура.ЧертежныйНомер)),СокрЛП(СтрТовар.Номенклатура.ЧертежныйНомер), КодТов);
			КонецЕсли;
			Если КодТов <> "" тогда
				ЗаписьXML.ЗаписатьАтрибут("КодТов", КодТов);   
