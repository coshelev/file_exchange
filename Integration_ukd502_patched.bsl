Функция ПолучитьКодОбмена(Номенклатура, КлючКодаОбмена, КодОбменаУИД)
	КодОбмена = "";
	
	Если ЗначениеЗаполнено(КлючКодаОбмена)=Ложь Тогда
		Возврат КодОбмена;		
	КонецЕсли; 
	Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") тогда
		нСтрока = Номенклатура.КодыПоставщиков.Найти(КлючКодаОбмена, "Поставщик");
		Если нСтрока<>Неопределено Тогда
			КодОбмена = нСтрока.Код;		
		КонецЕсли; 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КодОбмена)=Ложь Тогда
		Если КодОбменаУИД=Ложь Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	СоответствиеИдентификаторов.Идентификатор КАК Идентификатор
			|ИЗ
			|	РегистрСведений.СоответствиеИдентификаторов КАК СоответствиеИдентификаторов
			|ГДЕ
			|	СоответствиеИдентификаторов.Проект = &Проект
			|	И СоответствиеИдентификаторов.СсылкаНаОбъектОУ = &СсылкаНаОбъектОУ
			|	И ПОДСТРОКА(СоответствиеИдентификаторов.Идентификатор, 20, 1) = """"";
			
			Запрос.УстановитьПараметр("Проект", КлючКодаОбмена);
			Запрос.УстановитьПараметр("СсылкаНаОбъектОУ", Номенклатура);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				КодОбмена = СокрЛП(Выборка.Идентификатор);
			КонецЦикла;  
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КодОбмена)=Ложь Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СоответствиеИдентификаторов.Идентификатор КАК Идентификатор
		|ИЗ
		|	РегистрСведений.СоответствиеИдентификаторов КАК СоответствиеИдентификаторов
		|ГДЕ
		|	СоответствиеИдентификаторов.Проект = &Проект
		|	И СоответствиеИдентификаторов.СсылкаНаОбъектОУ = &СсылкаНаОбъектОУ
		|	И ПОДСТРОКА(СоответствиеИдентификаторов.Идентификатор, 20, 1) <> """"";
		
		Запрос.УстановитьПараметр("Проект", КлючКодаОбмена);
		Запрос.УстановитьПараметр("СсылкаНаОбъектОУ", Номенклатура);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			КодОбмена = СокрЛП(Выборка.Идентификатор);
			КодОбменаУИД = Истина;
		КонецЦикла;  
	КонецЕсли; 
	
	Возврат КодОбмена;		
КонецФункции

Функция ПолучитьДокументыРНПТ(ДатаНачала, ДатаОкончания)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПрослеживаемыеТовары.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеТовары КАК ПрослеживаемыеТовары
	|ГДЕ
	|	ПрослеживаемыеТовары.Период >= &ДатаНачала
	|	И ПрослеживаемыеТовары.Период <= &ДатаОкончания";
	
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор"); 
	Возврат Результат;
	
КонецФункции	   


Функция ПолучитьСводныеАкты(ДатаНачала, ДатаОкончания)
	
