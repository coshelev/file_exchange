&НаСервере
Функция УбратьСимволы1013(Строка)
	Возврат СтрЗаменить(СтрЗаменить(Строка, Символы.ПС, ""), Символы.ВК, ""); // Ещё бывают символы "77u/", при необходимости удалять и их.
КонецФункции

&НаСервере
Функция ПолучитьДанныеJSON(Парам)
	
	ЧтениеJSON = Новый ЧтениеJSON; 
	ЧтениеJSON.УстановитьСтроку(Парам);
	ДанныеJSON = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	Возврат ДанныеJSON;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеXML(Парам)
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Парам);
	Фабрика=Новый ФабрикаXDTO;
	ОбXDTO=Фабрика.ПрочитатьXML(ЧтениеXML);
	Возврат ОбXDTO;
КонецФункции

&НаСервере
Функция ЗапонитьСтруктуруПолучения(ПриемкаТоваровИСМП,Решение)
	ДокПриемкаТоваровИСМП = ПриемкаТоваровИСМП;
	
	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("release_order_number",ДокПриемкаТоваровИСМП.ГУИДДокумента);
	СтруктураОтвет.Вставить("document_number",ДокПриемкаТоваровИСМП.НомерПервичногоДокумента);
	СтруктураОтвет.Вставить("document_date",Формат(ДокПриемкаТоваровИСМП.ДатаПервичногоДокумента,"ДФ=yyyy-MM-ddTHH:mm:ssZ"));
	СтруктураОтвет.Вставить("transfer_date",Формат(ДокПриемкаТоваровИСМП.ДатаОтгрузки,"ДФ=yyyy-MM-ddTHH:mm:ssZ"));
	СтруктураОтвет.Вставить("acceptance_date",Формат(НачалоДня(ТекущаяДата()),"ДФ=yyyy-MM-ddTHH:mm:ssZ"));
	СтруктураОтвет.Вставить("trade_sender_inn",ДокПриемкаТоваровИСМП.ИННОтправителя);
	СтруктураОтвет.Вставить("trade_recipient_inn",ДокПриемкаТоваровИСМП.Организация.ИНН);
	СтруктураОтвет.Вставить("turnover_type","SELLING");
	Если Решение = Истина тогда
		СтруктураОтвет.Вставить("accept_all","true");
	ИначеЕсли Решение = Ложь тогда
		СтруктураОтвет.Вставить("reject_all","true");
	КонецЕсли;
	
	Возврат СтруктураОтвет;
КонецФункции

