Функция ЧЗВыбытие_СформироватьXML(ДокВыгрузки) Экспорт
    //Данные для заполнения
	ПервичныйДокумент = ДокВыгрузки.Основание;
    НаименованиеДокумента = ПервичныйДокумент.Метаданные().Имя;	
	
	Если НаименованиеДокумента = "РеализацияТоваров" Тогда
		ИНН = ПервичныйДокумент.Организация.ИНН;
		Причина = "реализации товаров в государства-члены ЕАЭС";
    ИначеЕсли  НаименованиеДокумента = "ПеремещениеТоваровВПроизводство" Тогда
    	ИНН = ПервичныйДокумент.ДокументОснование.Организация.ИНН;
		Причина = "использования для собственных нужд предприятия (в том числе отпуск в производство)";  
	ИначеЕсли  НаименованиеДокумента = "СписаниеТоваров" Тогда
	    ИНН = ПервичныйДокумент.Организация.ИНН;
		Причина = "утрата товаров";
	КонецЕсли;
	
	ДатаДляИндифик = ПервичныйДокумент.Дата;
	ДатаДокумента = Строка(Формат(ДатаДляИндифик,"ДФ=yyyy-MM-dd"));
	НомерДокумента = ПервичныйДокумент.Номер;
		 
	ЗаписьXML = Новый ЗаписьXML; 
    ЗаписьXML.УстановитьСтроку("UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("withdrawal");  
  	ЗаписьXML.ЗаписатьАтрибут("version","8"); 
   
    ЗаписьXML.ЗаписатьНачалоЭлемента("trade_participant_inn");
	ЗаписьXML.ЗаписатьТекст(ИНН);
	ЗаписьXML.ЗаписатьКонецЭлемента();
		
	ЗаписьXML.ЗаписатьНачалоЭлемента("withdrawal_type");
	ЗаписьXML.ЗаписатьТекст("OTHER");
	ЗаписьXML.ЗаписатьКонецЭлемента();
		
	ЗаписьXML.ЗаписатьНачалоЭлемента("withdrawal_type_other");
	ЗаписьXML.ЗаписатьТекст(Причина);
	ЗаписьXML.ЗаписатьКонецЭлемента();
		
	ЗаписьXML.ЗаписатьНачалоЭлемента("withdrawal_date");
	ЗаписьXML.ЗаписатьТекст(ДатаДокумента);
	ЗаписьXML.ЗаписатьКонецЭлемента();
		
	ЗаписьXML.ЗаписатьНачалоЭлемента("primary_document_type");
	ЗаписьXML.ЗаписатьТекст("OTHER");
	ЗаписьXML.ЗаписатьКонецЭлемента();
		
	ЗаписьXML.ЗаписатьНачалоЭлемента("primary_document_number");
	ЗаписьXML.ЗаписатьТекст(НомерДокумента);
	ЗаписьXML.ЗаписатьКонецЭлемента();
		
	ЗаписьXML.ЗаписатьНачалоЭлемента("primary_document_date");
	ЗаписьXML.ЗаписатьТекст(ДатаДокумента);
	ЗаписьXML.ЗаписатьКонецЭлемента();
		
	ЗаписьXML.ЗаписатьНачалоЭлемента("primary_document_custom_name");
	ЗаписьXML.ЗаписатьТекст(НаименованиеДокумента);
	ЗаписьXML.ЗаписатьКонецЭлемента();
		
	ЗаписьXML.ЗаписатьНачалоЭлемента("products_list");
	Для Каждого стрТовар из ДокВыгрузки.Товары цикл
	    ЗаписьXML.ЗаписатьНачалоЭлемента("product");
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("cis");
		//ЗаписьXML.ЗаписатьСекциюCDATA(Лев(стрТовар.КИЗ,31));
		ЗаписьXML.ЗаписатьТекст(Лев(стрТовар.КИЗ,31));
		//ЗаписьXML.ЗаписатьБезОбработки(Лев(стрТовар.КИЗ,31));
	    ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЦикла;	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	Возврат ЗаписьXML.Закрыть();
КонецФункции  

