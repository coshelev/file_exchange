		ЗаписьXML.ЗаписатьАтрибут("СтТовУчНал", Строка(Формат(СтрТовар.Сумма,"ЧДЦ=2; ЧГ=0; ЧРД=.")));	    
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Акциз");
