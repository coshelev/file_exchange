	ИсходныйДокНомер = ?(ЗначениеЗаполнено(ДокВыгрузки.ДокументОснование.НомерСчф),ДокВыгрузки.ДокументОснование.НомерСчф,ДокВыгрузки.ДокументОснование.Номер);
