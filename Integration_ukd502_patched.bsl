		ЗаписьXML.ЗаписатьТекст("без акциза");
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("СумНал"); 
		
		Если СуммаНДСизСуммы > 0 Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента("СумНал");
			ЗаписьXML.ЗаписатьТекст(Строка(Формат(СуммаНДСизСуммы,"ЧДЦ=2; ЧГ=0; ЧРД=.")));
		ИначеЕсли СуммаНДСизСуммы = 0 Тогда		
			ЗаписьXML.ЗаписатьНачалоЭлемента("БезНДС");
			ЗаписьXML.ЗаписатьТекст("без НДС");
		КонецЕсли;
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ИтогКолМест = ИтогКолМест + СтрТовар.Количество; 
		ИтогНетто = ИтогНетто + СтрТовар.Количество;
		ИтогСумБезНДС = ИтогСумБезНДС + СуммаБезНДС;
		ИтогСумНДС = ИтогСумНДС + СтрТовар.СуммаНДС;	
		ИтогСумУчНДС = ИтогСумУчНДС + СтрТовар.Сумма;		
	КонецЦикла;	
	// Конец табличной части
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ВсегоОпл");
	ЗаписьXML.ЗаписатьАтрибут("СтТовБезНДСВсего", Строка(Формат(ИтогСумБезНДС,"ЧДЦ=2; ЧГ=0; ЧРД=.")));
	ЗаписьXML.ЗаписатьАтрибут("СтТовУчНалВсего", Строка(Формат(ИтогСумУчНДС,"ЧДЦ=2; ЧГ=0; ЧРД=.")));
	ЗаписьXML.ЗаписатьАтрибут("КолНеттоВс","0" );	
	ЗаписьXML.ЗаписатьНачалоЭлемента("СумНалВсего");
	Если ИтогСумНДС > 0 Тогда
		ЗаписьXML.ЗаписатьНачалоЭлемента("СумНал");
		ЗаписьXML.ЗаписатьТекст(Строка(Формат(ИтогСумНДС,"ЧДЦ=2; ЧГ=0; ЧРД=."))); 
	Иначе
		ЗаписьXML.ЗаписатьНачалоЭлемента("БезНДС");
		ЗаписьXML.ЗаписатьТекст("без НДС");
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвПродПер");
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвПер");
	ЗаписьXML.ЗаписатьАтрибут("СодОпер", "Товары переданы"); 
	ЗаписьXML.ЗаписатьАтрибут("ДатаПер", Формат(ДатаУПД, "ДЛФ=Д"));
	ЗаписьXML.ЗаписатьНачалоЭлемента("ОснПер");
	Если ЗначениеЗаполнено(ДокВыгрузки.ДоговорВзаиморасчетов) Тогда 
		ЗаписьXML.ЗаписатьАтрибут("РеквНаимДок", "Договор");                                     
		ЗаписьXML.ЗаписатьАтрибут("РеквНомерДок", Строка(ДокВыгрузки.ДоговорВзаиморасчетов.Номер));
		ЗаписьXML.ЗаписатьАтрибут("РеквДатаДок", Строка(Формат(ДокВыгрузки.ДоговорВзаиморасчетов.НачПериода, "ДЛФ=Д")));
	Иначе 
		ЗаписьXML.ЗаписатьАтрибут("РеквНаимДок", "Заказ-наряд");                                     
		ЗаписьXML.ЗаписатьАтрибут("РеквНомерДок", Строка(ДокВыгрузки.Номер));
		ЗаписьXML.ЗаписатьАтрибут("РеквДатаДок", Строка(Формат(ДокВыгрузки.ДатаЗакрытия, "ДЛФ=Д")));
	КонецЕсли;	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	Если ТипЗнч(ДокВыгрузки) = Тип("ДокументСсылка.ЗаказНаряд")
		И ДокВыгрузки.Контрагент.ШаблонСтрокиДанныеТранспортировки = 1 Тогда 
		ЗаписьXML.ЗаписатьНачалоЭлемента("ТранГруз");
		ДатаТранГруз = ?(ЗначениеЗаполнено(ДокВыгрузки.ДатаЗакрытия),ДокВыгрузки.ДатаЗакрытия,ДокВыгрузки.Дата); 
		СтрТранГруз = "Заказ-наряд № "+СокрЛП(ДокВыгрузки.Номер)+" от "+Формат(ДатаТранГруз,"ДЛФ=Д")+" г.";
		ЗаписьXML.ЗаписатьАтрибут("СвТранГруз", СтрТранГруз);
		ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвПерВещи");
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьНачалоЭлемента("ИнфПолФХЖ3");
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	//Подписант
	ЗаписьXML.ЗаписатьНачалоЭлемента("Подписант");
	ЗаписьXML.ЗаписатьАтрибут("ОснПолн", "Должностные обязанности");
	ЗаписьXML.ЗаписатьАтрибут("ОблПолн", "1");
	ЗаписьXML.ЗаписатьАтрибут("Статус", "1");	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ЮЛ");
	
	Если ЗначениеЗаполнено(ДокВыгрузки.Организация.ИНН) Тогда
		ЗаписьXML.ЗаписатьАтрибут("ИННЮЛ", ДокВыгрузки.Организация.ИНН);		
	Иначе 		
		ЗаписьXML.ЗаписатьАтрибут("ИННЮЛ", "0101010108");
	КонецЕсли;
	
	//ПодписантОветственный = "";
	РукФ = "";
	РукИ = "";
	РукО = "";
	Если ЗначениеЗаполнено(ДокВыгрузки.Организация.Руководитель) Тогда
		РукФИО = СтрЗаменить(ДокВыгрузки.Организация.Руководитель, " ", Символы.ПС);
		Если СтрЧислоСтрок(РукФИО) = 3 Тогда
			РукФ = СокрЛП(СтрПолучитьСтроку(РукФИО, 1));
			РукИ = СокрЛП(СтрПолучитьСтроку(РукФИО, 2));
			РукО = СокрЛП(СтрПолучитьСтроку(РукФИО, 3));
		КонецЕсли;			
	КонецЕсли;
	ЗаписьXML.ЗаписатьАтрибут("Должн", "Директор");
	ЗаписьXML.ЗаписатьНачалоЭлемента("ФИО");
	ЗаписьXML.ЗаписатьАтрибут("Фамилия", ?(ЗначениеЗаполнено(РукФ),РукФ,"Ф"));
	ЗаписьXML.ЗаписатьАтрибут("Имя", ?(ЗначениеЗаполнено(РукИ),РукИ,"И"));	
	ЗаписьXML.ЗаписатьАтрибут("Отчество", ?(ЗначениеЗаполнено(РукО),РукО,"О"));
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента(); 
	
	Возврат ЗаписьXML.Закрыть();
КонецФункции

&НаСервере
Функция ТабРаботТоваровЗН(ДокВыгрузки)
	ДанныеТоваров = Новый Массив;
	
	Для Каждого текРабота Из ДокВыгрузки.Работы Цикл
		стрТовар = Новый Структура;
		стрТовар.Вставить("Номенклатура", текРабота.Работа);
		стрТовар.Вставить("Количество", текРабота.Количество); 
		стрТовар.Вставить("Сумма", текРабота.Сумма);
		стрТовар.Вставить("СуммаНДС", Конвертация.НдсОтСуммыПолучить(текРабота.Сумма, ДокВыгрузки.СтавкаНДС));
		стрТовар.Вставить("СтавкаНДС", ДокВыгрузки.СтавкаНДС);
		стрТовар.Вставить("ЭтоРабота", ИСТИНА);
    	ДанныеТоваров.Добавить(стрТовар);
						
		МассивТоваров = ДокВыгрузки.Товары.НайтиСтроки(Новый Структура("Работа", текРабота.Работа));
		Для Каждого текТовар Из МассивТоваров Цикл
			стрТовар = Новый Структура;
			стрТовар.Вставить("Номенклатура", текТовар.Номенклатура);
			стрТовар.Вставить("Количество", текТовар.Количество); 
			стрТовар.Вставить("Сумма", текТовар.Сумма);
			стрТовар.Вставить("СуммаНДС", Конвертация.НдсОтСуммыПолучить(текТовар.Сумма, ДокВыгрузки.СтавкаНДС));
			стрТовар.Вставить("СтавкаНДС", ДокВыгрузки.СтавкаНДС);
			стрТовар.Вставить("ЭтоРабота", ЛОЖЬ);
			ДанныеТоваров.Добавить(стрТовар);
		КонецЦикла;	 
	КонецЦикла;
	
	Возврат ДанныеТоваров;
КонецФункции

&НаСервере
Функция ТабРаботПодрядовЗН(ДокВыгрузки,ДанныеТоваров)
	Для Каждого текРабота Из ДокВыгрузки.Подряды Цикл
		стрТовар = Новый Структура;
		стрТовар.Вставить("Номенклатура", текРабота.Работа);
		стрТовар.Вставить("Количество", текРабота.Количество); 
		стрТовар.Вставить("Сумма", текРабота.Сумма);
		стрТовар.Вставить("СуммаНДС", Конвертация.НдсОтСуммыПолучить(текРабота.Сумма, ДокВыгрузки.СтавкаНДС));
		стрТовар.Вставить("СтавкаНДС", ДокВыгрузки.СтавкаНДС);
		стрТовар.Вставить("ЭтоРабота", ИСТИНА);
		ДанныеТоваров.Добавить(стрТовар);
	КонецЦикла;
	
	Возврат ДанныеТоваров;
КонецФункции

&НаСервере
Функция Реализация_СформироватьXML_УПД503АктСводный(ДокВыгрузки) Экспорт
	ИдОтпр = "2BK-0000000000-0000000";
	ИдПол = "2BK-0000000000-0000000000000";  
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПрослеживаемыеТовары.Номенклатура КАК Номенклатура,
	|	ПрослеживаемыеТовары.РНПТ КАК РНПТ,
	|	ПрослеживаемыеТовары.Количество КАК Количество,
	|	ПрослеживаемыеТовары.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ПрослеживаемыеТовары.СтранаПроисхождения КАК СтранаПроисхождения
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеТовары КАК ПрослеживаемыеТовары
	|ГДЕ
	|	ПрослеживаемыеТовары.Регистратор = &Регистратор";
	
	Запрос.УстановитьПараметр("Регистратор", ДокВыгрузки);
	СведенияОПрослеживаемости = Запрос.Выполнить().Выгрузить();
	
	Если СведенияОПрослеживаемости.Количество() > 0 тогда 
		ВыводитьРНПТ = Истина;
	Иначе
		ВыводитьРНПТ = Ложь;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗначенияСвойствКонтрагентов.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствКонтрагентов КАК ЗначенияСвойствКонтрагентов
	|ГДЕ
	|	ЗначенияСвойствКонтрагентов.Контрагент = &Контрагент
	|	И ЗначенияСвойствКонтрагентов.Свойство = &Свойство";
	
	Запрос.УстановитьПараметр("Контрагент", ДокВыгрузки.Контрагент); 
	Запрос.УстановитьПараметр("Свойство", Справочники.ЗначенияСвойствОбъектов.ГрузотправительПрочерк); 
	СвойствоПрочерк = Запрос.Выполнить().Выгрузить();
	
	Если СвойствоПрочерк.Количество() > 0 тогда 
		ВыводитьПрочерк = Истина;
	Иначе
		ВыводитьПрочерк = Ложь;	
	КонецЕсли;
	
	
	
	
	
	Если (ДокВыгрузки.Контрагент.ТипКонтрагента=Перечисления.ТипКонтрагента.Ип) ИЛИ (ДокВыгрузки.Контрагент.ТипКонтрагента=Перечисления.ТипКонтрагента.Фл ) Тогда
		КонтрИП = Истина;
	КонецЕсли;
	
	Если ТипЗнч(ДокВыгрузки) = Тип("ДокументСсылка.ЗаказНаряд") Тогда 
		ДатаУПД = ДокВыгрузки.ДатаЗакрытия;
	Иначе
		ДатаУПД = ДокВыгрузки.Дата;
	КонецЕсли;
	
	НомУПД = ?(ЗначениеЗаполнено(ДокВыгрузки.НомерСчф), ДокВыгрузки.НомерСчф, ДокВыгрузки.Номер);	
	
	
	ОргИП = Ложь;
	БанковскийСчетКонтрагента = ДокВыгрузки.Контрагент.РасчСчет;
	БанковскийСчетФирмы = ДокВыгрузки.Организация.РасчСчет;
	СведенияОПоставщике = ЗначенияСервера.СведенияОЮрФизЛице(ДокВыгрузки.Организация, ДатаУПД);
	СведенияОПокупателе = ЗначенияСервера.СведенияОЮРФизЛице(ДокВыгрузки.Контрагент, ДатаУПД);
	
	Если ДокВыгрузки.Метаданные().Реквизиты.Найти("Получатель")<>Неопределено И ЗначениеЗаполнено(ДокВыгрузки.Получатель) и ТипЗнч(ДокВыгрузки.Получатель) = Тип("СправочникСсылка.Контрагенты") тогда
		СведенияОГрузополучателе  = ЗначенияСервера.СведенияОЮрФизЛице(ДокВыгрузки.Получатель,  ДатаУПД);
		ПолучательПоДокументу = ДокВыгрузки.Получатель;
	Иначе
		СведенияОГрузополучателе  = СведенияОПокупателе;
		ПолучательПоДокументу = ДокВыгрузки.Контрагент;
	КонецЕсли;  
	
	СведенияОГрузоотправитель = СведенияОПоставщике;
	
	НовыйУникальныйИдентификатор = Новый УникальныйИдентификатор;
	ДатаДляИндифик = ТекущаяДата();
	Год   = Строка(Формат(ДатаДляИндифик, "ДФ=гггг")); // Год
	Месяц = Строка(Формат(ДатаДляИндифик, "ДФ=ММ"));   // Месяц
	День  = Строка(Формат(ДатаДляИндифик, "ДФ=дд"));   // День
	
	ДатаПреобразоваянная = Год + Месяц + День;
	
	ЗаписьXML = Новый ЗаписьXML;
	
	ЗаписьXML.УстановитьСтроку();
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Файл");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsd","http://www.w3.org/2001/XMLSchema");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi","http://www.w3.org/2001/XMLSchema-instance");
	
	ЗаписьXML.ЗаписатьАтрибут("ИдФайл", "ON_NSCHFDOPPR_" + ИдПол + "_" + ИдОтпр + "_" + ДатаПреобразоваянная + "_" + НовыйУникальныйИдентификатор);	
	ЗаписьXML.ЗаписатьАтрибут("ВерсФорм", "5.03");
	ЗаписьXML.ЗаписатьАтрибут("ВерсПрог", "Diadoc 1.0");
	ЗаписьXML.ЗаписатьНачалоЭлемента("Документ");	
	ЗаписьXML.ЗаписатьАтрибут("КНД", "1115131"); 	
	ЗаписьXML.ЗаписатьАтрибут("ПоФактХЖ", "Документ об отгрузке товаров (выполнении работ), передаче имущественных прав (документ об оказании услуг)");
	ЗаписьXML.ЗаписатьАтрибут("НаимДокОпр", "УПД");
	ЗаписьXML.ЗаписатьАтрибут("ДатаИнфПр", Формат(ДатаУПД, "ДЛФ=Д"));
	ЗаписьXML.ЗаписатьАтрибут("ВремИнфПр", "00.00.00");
	ЗаписьXML.ЗаписатьАтрибут("НаимЭконСубСост", ДокВыгрузки.Организация.НаименованиеПолное);
	ЗаписьXML.ЗаписатьАтрибут("Функция", "СЧФДОП");
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвСчФакт");
	ЗаписьXML.ЗаписатьАтрибут("НомерДок", НомУПД);
	Если ТипЗнч(ДокВыгрузки) = Тип("ДокументСсылка.ЗаказНаряд") Тогда 
		ЗаписьXML.ЗаписатьАтрибут("ДатаДок", Формат(ДатаУПД, "ДЛФ=Д"));
	Иначе
		ЗаписьXML.ЗаписатьАтрибут("ДатаДок", Формат(ДатаУПД, "ДЛФ=Д"));   
		
	КонецЕсли;
	
	
	//Продавец
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвПрод");
	ЗаписьXML.ЗаписатьНачалоЭлемента("ИдСв");
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвЮЛУч");  
	ЗаписьXML.ЗаписатьАтрибут("КПП", ДокВыгрузки.Организация.КПП);
	ЗаписьXML.ЗаписатьАтрибут("НаимОрг", ДокВыгрузки.Организация.НаименованиеПолное);
	ЗаписьXML.ЗаписатьАтрибут("ИННЮЛ", ДокВыгрузки.Организация.ИНН);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Адрес");
	ЗаписьXML.ЗаписатьНачалоЭлемента("АдрРФ");
	
	Если ЗначениеЗаполнено(СведенияОПоставщике.ЮридическийАдрес.postal_code) Тогда
		ЗаписьXML.ЗаписатьАтрибут("Индекс", СокрЛП(СведенияОПоставщике.ЮридическийАдрес.postal_code));
	КонецЕсли;
	Если ДокВыгрузки.Организация.Страна.ЭтоСтрана=Ложь тогда
		Если Лев(СокрЛП(ДокВыгрузки.Организация.Страна.Код),1)= "0" тогда
			ЗаписьXML.ЗаписатьАтрибут("КодРегион",Сред(СокрЛП(ДокВыгрузки.Организация.Страна.Код),2));	
		Иначе	
			ЗаписьXML.ЗаписатьАтрибут("КодРегион",СокрЛП(ДокВыгрузки.Организация.Страна.Код));
		КонецЕсли;	
	Иначе 	
