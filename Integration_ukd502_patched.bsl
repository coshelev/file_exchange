Функция РезультатЗапросаВСтруктуру(Знач РезультатЗапроса) Экспорт
	
	Результат = Новый Структура;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Результат.Вставить(Колонка.Имя);
	КонецЦикла;
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	
	Возврат Результат;
	
КонецФункции  

Функция ИнтернетЗаявку_Получи(Телефон, Начало = Неопределено, Окончание = Неопределено) Экспорт 
	//Возвращает только имя сайта	
	Если НЕ ЗначениеЗаполнено(Справочники.ЗначенияСвойствОбъектов.Втор_Резерв6.Комментарий) Тогда
		Возврат "";
	КонецЕсли;  
	
	Доступно = ТипЗнч(Телефон) = Тип("Строка") И СтрДлина(Телефон) = 10; 
	Если Не Доступно Тогда
		Возврат "";
	КонецЕсли;
	
	sql = 
	"ВЫБРАТЬ ПЕРВЫЕ 1 Здч.Инициатор КАК Сайт, ЕСТЬNULL(Инт.Комментарий, """") КАК Комментарий
	|ИЗ	РегистрСведений.ЗадачиИнтернетЗаявки КАК Здч ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИнтернетЗаявки КАК Инт ПО (Инт.Сигнатура = Здч.Сигнатура)
	|ГДЕ Здч.Телефон = &Телефон И Здч.ДатаЗакрытия МЕЖДУ &Начало И &Окончание";
	
	query = СтрШаблон(" {""text"":%1} ", ЗаписатьЗначениеJson(sql)); 	                                                    	
	
	Если Не ЗначениеЗаполнено(Окончание) Тогда
		Окончание = ЗначенияСервера.ТекущаяДатаСервер();
		Начало	  = Окончание - 300;     	
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(Начало) Тогда
		Начало	  = Окончание - 300;   
	КонецЕсли; 
	
	params	= СтрШаблон(" { ""text"" : %1, ""params"" :	{""Телефон"": %2, ""Начало"":""%3"", ""Окончание"":""%4""}}", ЗаписатьЗначениеJson(sql), ЗаписатьЗначениеJson(Телефон) ,ЗаписатьДатуJSON(Начало, ФорматДатыJson.ISO), ЗаписатьДатуJSON(Окончание, ФорматДатыJson.ISO));    

	кмд 	= СтрШаблон(" curl --request POST ""http://mainappl.main.luidorauto.ru/sys_agr/hs/webhooks/jsonrpc/v1"" -H ""Accept"":""application/json"" --data '{""jsonrpc"": ""2.0"", ""method"":""%1"", ""params"":[%2], ""id"":1} ' ", "sql_2_json", params);

    Попытка
		Ответ 	= Авито.CURL_Str(кмд); 
	Исключение
		ЗаписьЖурналаРегистрации("ИнтернетЗаявки.Получи", УровеньЖурналаРегистрации.Ошибка,, СтрШаблон("кмд = %1", кмд), ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ""; 
	КонецПопытки;  
	
	Попытка
		z = ПрочитатьЗначениеJson(Ответ);
	Исключение
		Возврат "";
	КонецПопытки; 
	
	Доступно = z.Свойство("result") И ЗначениеЗаполнено(z.result);
	Если Не Доступно Тогда
		Возврат "";
	КонецЕсли;
	
	Рез = z.result[0];
	Доступно = Рез.Свойство("Сайт") И ЗначениеЗаполнено(Рез.Сайт);
	Если Не Доступно Тогда
		Возврат "";
	КонецЕсли; 
	
	Возврат z.result[0]["Сайт"]; 
	
КонецФункции  

