			ЗаписьXML.ЗаписатьТекст(Строка(Формат(СуммаНДСизСуммы,"ЧДЦ=2; ЧГ=0; ЧРД=.")));
		ИначеЕсли СуммаНДСизСуммы = 0 Тогда		
			ЗаписьXML.ЗаписатьНачалоЭлемента("БезНДС");
