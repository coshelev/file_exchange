		ВыводитьПрочерк = Истина;
	Иначе
		ВыводитьПрочерк = Ложь;	
	КонецЕсли;
	
	
	
	
	Если (ДокВыгрузки.Контрагент.ТипКонтрагента=Перечисления.ТипКонтрагента.Ип) ИЛИ (ДокВыгрузки.Контрагент.ТипКонтрагента=Перечисления.ТипКонтрагента.Фл ) Тогда
		КонтрИП = Истина;
	КонецЕсли;
	
	Если ТипЗнч(ДокВыгрузки) = Тип("ДокументСсылка.ЗаказНаряд") Тогда 
		ДатаУПД = ДокВыгрузки.ДатаЗакрытия;
	Иначе
		ДатаУПД = ДокВыгрузки.Дата;
	КонецЕсли;
	
	НомУПД = ?(ЗначениеЗаполнено(ДокВыгрузки.НомерСчф), ДокВыгрузки.НомерСчф, ДокВыгрузки.Номер);
	
	
	ОргИП = Ложь;
	БанковскийСчетКонтрагента = ДокВыгрузки.Контрагент.РасчСчет;
	БанковскийСчетФирмы = ДокВыгрузки.Организация.РасчСчет;
