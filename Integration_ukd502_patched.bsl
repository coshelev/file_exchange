			КодТов = ?(ЗначениеЗаполнено(СокрЛП(ТекСтрока.Номенклатура.КодКаталога)), СокрЛП(ТекСтрока.Номенклатура.КодКаталога), ТекСтрока.Номенклатура.ЧертежныйНомер);
		ИначеЕсли ДокВыгрузки.Контрагент.ЗаполнениеКодаТовара = "Артикул" тогда
			КодТов = ?(ЗначениеЗаполнено(СокрЛП(ТекСтрока.Номенклатура.Артикул)), СокрЛП(ТекСтрока.Номенклатура.Артикул), ТекСтрока.Номенклатура.КодКаталога);	
		ИначеЕсли ДокВыгрузки.Контрагент.ЗаполнениеКодаТовара = "ЧертежныйНомер" тогда
			КодТов = ?(ЗначениеЗаполнено(СокрЛП(ТекСтрока.Номенклатура.Артикул)), СокрЛП(ТекСтрока.Номенклатура.Артикул), СокрЛП(ТекСтрока.Номенклатура.КодКаталога));
			КодТов = ?(ЗначениеЗаполнено(СокрЛП(ТекСтрока.Номенклатура.ЧертежныйНомер)),СокрЛП(ТекСтрока.Номенклатура.ЧертежныйНомер), КодТов);	
		Иначе
			КодТов = ?(ЗначениеЗаполнено(СокрЛП(ТекСтрока.Номенклатура.Артикул)), СокрЛП(ТекСтрока.Номенклатура.Артикул), СокрЛП(ТекСтрока.Номенклатура.КодКаталога));
			КодТов = ?(ЗначениеЗаполнено(СокрЛП(ТекСтрока.Номенклатура.ЧертежныйНомер)),СокрЛП(ТекСтрока.Номенклатура.ЧертежныйНомер), КодТов);
