&НаСервере
Функция ПолучитьКИЗ(ДокВыгрузки,Номенклатура) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЧЗВыбытиеТовары.КИЗ КАК КИЗ
	               |ИЗ
	               |	Документ.ЧЗВыбытие.Товары КАК ЧЗВыбытиеТовары
	               |ГДЕ
	               |	ЧЗВыбытиеТовары.Ссылка.Основание = &Ссылка
	               |	И ЧЗВыбытиеТовары.Номенклатура = &Номенклатура
				   |    И ЧЗВыбытиеТовары.Ссылка.ПометкаУдаления = ЛОЖЬ";	               	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Ссылка", ДокВыгрузки);	
			
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции  

&НаСервере
Функция ПолучитьВыбытие(ДокВыгрузки) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЧЗВыбытиеТовары.КИЗ КАК КИЗ,
	               |	ВЫБОР
	               |		КОГДА ЧЗВыбытиеТовары.ВыведенИзОборота = Истина
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК Выводить,
	               |	ВЫБОР
	               |		КОГДА ЧЗВыбытиеТовары.ВыведенИзОборота = Ложь
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК НеВыводить
	               |ИЗ
	               |	Документ.ЧЗВыбытие.Товары КАК ЧЗВыбытиеТовары
	               |ГДЕ
	               |	ЧЗВыбытиеТовары.Ссылка.Основание = &Ссылка
	               |	И ЧЗВыбытиеТовары.Ссылка.ПометкаУдаления = ЛОЖЬ";	               	
	
	Запрос.УстановитьПараметр("Ссылка", ДокВыгрузки);	
		тз = 	Запрос.Выполнить().Выгрузить();
	Если тз.Количество() = 0 тогда
		Возврат 0;
	ИначеЕсли тз.Итог("НеВыводить")> 0 и тз.Итог("Выводить")>0 тогда
		Возврат 1;
	ИначеЕсли тз.Итог("НеВыводить")> 0  тогда
		Возврат 2;	
		
	Иначе
		Возврат 3;
	КонецЕсли;		
	
КонецФункции

&НаСервере
Функция ПолучитьКИЗ_УКД(Реализация,Номенклатура,ДатаВозврата,Стало) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЧЗВыбытиеТовары.КИЗ КАК КИЗ,
	               |	1 КАК КолРеал
	               |ПОМЕСТИТЬ ТЗ_Отгрузки
	               |ИЗ
	               |	Документ.ЧЗВыбытие.Товары КАК ЧЗВыбытиеТовары
	               |ГДЕ
	               |	ЧЗВыбытиеТовары.Ссылка.Основание = &Реализация
	               |	И ЧЗВыбытиеТовары.Номенклатура = &Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЧЗПоступлениеТовары.КИЗ КАК КИЗ,
	               |	-1 КАК КолВозвр
	               |ПОМЕСТИТЬ ТЗ_Возврата
	               |ИЗ
	               |	Документ.ЧЗПоступление.Товары КАК ЧЗПоступлениеТовары
	               |ГДЕ
	               |	ЧЗПоступлениеТовары.Ссылка.Основание.ДокументОснование = &Реализация
	               |	И ЧЗПоступлениеТовары.Ссылка.Основание.Дата < &ДатаВозврата
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТЗ_Отгрузки.КИЗ КАК КИЗ,
	               |	ТЗ_Отгрузки.КолРеал КАК КолРеал,
	               |	ЕСТЬNULL(ТЗ_Возврата.КолВозвр, 0) КАК КолВозвр,
	               |	СУММА(ТЗ_Отгрузки.КолРеал + ЕСТЬNULL(ТЗ_Возврата.КолВозвр, 0)) КАК Остаток
	               |ИЗ
	               |	ТЗ_Отгрузки КАК ТЗ_Отгрузки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ТЗ_Возврата КАК ТЗ_Возврата
	               |		ПО ((ВЫРАЗИТЬ(ТЗ_Отгрузки.КИЗ КАК СТРОКА(31))) = (ВЫРАЗИТЬ(ТЗ_Возврата.КИЗ КАК СТРОКА(31))))
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТЗ_Отгрузки.КИЗ,
	               |	ТЗ_Отгрузки.КолРеал,
	               |	ТЗ_Возврата.КолВозвр
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(ТЗ_Отгрузки.КолРеал + ЕСТЬNULL(ТЗ_Возврата.КолВозвр, 0)) > 0";
	Если Стало Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"Дата < &ДатаВозврата","Дата <= &ДатаВозврата");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Реализация", Реализация);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ДатаВозврата", ДатаВозврата);
		
	Возврат Запрос.Выполнить().Выгрузить();	
КонецФункции

&НаСервере
Функция ПолучитьIDЗаказа(ЗаказПокупателя, Номенклатура) Экспорт
	текIDЗаказа = "";
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказПокупателяТовары.IDЗаказа КАК IDЗаказа
	               |ИЗ
	               |	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	               |ГДЕ
	               |	ЗаказПокупателяТовары.Ссылка = &Заказ
	               |	И ЗаказПокупателяТовары.Номенклатура = &Номенклатура";	
	Запрос.УстановитьПараметр("Заказ", ЗаказПокупателя);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);		
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(текIDЗаказа) Тогда
			текIDЗаказа = текIDЗаказа+","+Выборка.IDЗаказа;
		Иначе
			текIDЗаказа = Выборка.IDЗаказа;
		КонецЕсли;			
	КонецЦикла;
		
	Возврат текIDЗаказа;
КонецФункции

&НаСервере
Функция Реализация_СформироватьXML_УПДкамаз503(ДокВыгрузки) Экспорт
	ИдОтпр = "2BK-0000000000-0000000";
	ИдПол = "2BK-0000000000-0000000000000";  
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПрослеживаемыеТовары.Номенклатура КАК Номенклатура,
	|	ПрослеживаемыеТовары.РНПТ КАК РНПТ,
	|	ПрослеживаемыеТовары.Количество КАК Количество,
	|	ПрослеживаемыеТовары.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ПрослеживаемыеТовары.СтранаПроисхождения КАК СтранаПроисхождения
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеТовары КАК ПрослеживаемыеТовары
	|ГДЕ
	|	ПрослеживаемыеТовары.Регистратор = &Регистратор";
	
	Запрос.УстановитьПараметр("Регистратор", ДокВыгрузки);
	СведенияОПрослеживаемости = Запрос.Выполнить().Выгрузить();
	
	Если СведенияОПрослеживаемости.Количество() > 0 тогда 
		ВыводитьРНПТ = Истина;
	Иначе
		ВыводитьРНПТ = Ложь;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗначенияСвойствКонтрагентов.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствКонтрагентов КАК ЗначенияСвойствКонтрагентов
	|ГДЕ
	|	ЗначенияСвойствКонтрагентов.Контрагент = &Контрагент
	|	И ЗначенияСвойствКонтрагентов.Свойство = &Свойство";
	
	Запрос.УстановитьПараметр("Контрагент", ДокВыгрузки.Контрагент); 
	Запрос.УстановитьПараметр("Свойство", Справочники.ЗначенияСвойствОбъектов.ГрузотправительПрочерк); 
	СвойствоПрочерк = Запрос.Выполнить().Выгрузить();
	
