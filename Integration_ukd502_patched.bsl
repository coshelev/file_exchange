	ЗаписьXML.ЗаписатьАтрибут("Имя", ?(ЗначениеЗаполнено(РукИ),РукИ,"И"));	
	ЗаписьXML.ЗаписатьАтрибут("Отчество", ?(ЗначениеЗаполнено(РукО),РукО,"О"));
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента(); 
	
	Возврат ЗаписьXML.Закрыть();
