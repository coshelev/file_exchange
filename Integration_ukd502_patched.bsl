//======================================================================================================================
// ИнфПолФХЖ1 — дополнительные информационные поля факта хозяйственной жизни
//======================================================================================================================

Функция ДопПоляИнфПолФХЖ1Получить(Контрагент) Экспорт
	// Возвращает дополнительные поля ИнфПолФХЖ1, заданные в карточке контрагента (ТЧ "Данные")
	// строками с ИД = "Файл-Документ---ИнфПолФХЖ1" и Значением вида "<Идентиф>=<Значен>",  
	// Возврат: Массив структур с полями "Идентиф" и "Значен". При некорректном аргументе — пустой Массив.

	
	Результат = Новый Массив;

	Доступно = ТипЗнч(Контрагент) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(Контрагент);
	Если Не Доступно Тогда
		Возврат Доступно;
	КонецЕсли;

	Якорь = "Файл-Документ---ИнфПолФХЖ1";
	Для Каждого i Из Контрагент.Данные Цикл
		Если СокрЛП(i.ИД) <> Якорь Тогда
			Продолжить;
		КонецЕсли;

		СтрокаЗначения = СокрЛП(Строка(i.Значение));
		ПозицияРавно = СтрНайти(СтрокаЗначения, "=");
		Если ПозицияРавно = 0 Тогда
			Продолжить;
		КонецЕсли;

		Идентиф = СокрЛП(Лев(СтрокаЗначения, ПозицияРавно - 1));
		Значен  = СокрЛП(Сред(СтрокаЗначения, ПозицияРавно + 1));
		Если Не (ЗначениеЗаполнено(Идентиф) И ЗначениеЗаполнено(Значен)) Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Новый Структура("Идентиф, Значен", Идентиф, Значен));
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция ЗаписатьТекстИнфМассив(ЗаписьXML, МассивПарИдентифЗначен)
	// Пишет элементы <ТекстИнф> по переданному массиву пар {Идентиф, Значен}.
	// Например возвращает <ТекстИнф Идентиф="ПризнакОЗ" Значен="ОЗ"/>
	// Возврат "" при успехе / "ошибка: ..." при некорректных аргументах.

	Доступно = ТипЗнч(ЗаписьXML) = Тип("ЗаписьXML") И ТипЗнч(МассивПарИдентифЗначен) = Тип("Массив");
	Если Не Доступно Тогда
		Возврат "ошибка: неверные параметры";
	КонецЕсли;

	Для Каждого i Из МассивПарИдентифЗначен Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("ТекстИнф");
		ЗаписьXML.ЗаписатьАтрибут("Идентиф", i.Идентиф);
		ЗаписьXML.ЗаписатьАтрибут("Значен",  i.Значен);
		ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЦикла;

	Возврат "";
КонецФункции


Функция ЗаписатьИнфПолФХЖ1(ЗаписьXML, Контрагент)
	// Пишет блок <ИнфПолФХЖ1> целиком (открытие/закрытие) с доп.полями контрагента,
	// но только если такие поля заданы. Для генераторов без собственного ИнфПолФХЖ1.
	// Например для Контрагента у которого в табл.части Данные есть строка с Ид: "Файл-Документ---ИнфПолФХЖ1"
	// и Значение: "ПризнакОЗ=ОЗ" получим <ИнфПолФХЖ1><ТекстИнф Идентиф="ПризнакОЗ" Значен="ОЗ"/></ИнфПолФХЖ1>
	// Возврат "" при успехе / "ошибка: ..." при некорректных аргументах.

	Доступно = ТипЗнч(ЗаписьXML) = Тип("ЗаписьXML");
	Если Не Доступно Тогда
		Возврат "ошибка: неверные параметры";
	КонецЕсли;

	МассивДопПолей = ДопПоляИнфПолФХЖ1Получить(Контрагент);
	Если МассивДопПолей.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	ЗаписьXML.ЗаписатьНачалоЭлемента("ИнфПолФХЖ1");
	ЗаписатьТекстИнфМассив(ЗаписьXML, МассивДопПолей);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	Возврат "";
КонецФункции

