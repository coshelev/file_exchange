Функция БПК3_ПолучитьАктуальнуюПолнуюСтавкуНДС(ИБ, Знач ДатаАктуальности)
	СтруктураНДС = ИБ.NewObject("Структура");
	
	Если ТипЗнч(ДатаАктуальности)<>Тип("Дата") ИЛИ НачалоДня(ДатаАктуальности)=Дата(1,1,1) Тогда
		ДатаАктуальности = ТекущаяДата();		
	КонецЕсли; 
	
	Если ДатаАктуальности>Дата(2026,1,1) Тогда
		СтруктураНДС.Вставить("Ставка", ИБ.Перечисления.СтавкиНДС.НДС22); 
		СтруктураНДС.Вставить("Процент", 22); 
	ИначеЕсли ДатаАктуальности<Дата(2019,1,1) Тогда
		СтруктураНДС.Вставить("Ставка", ИБ.Перечисления.СтавкиНДС.НДС18); 
		СтруктураНДС.Вставить("Процент", 18); 
	Иначе
		СтруктураНДС.Вставить("Ставка", ИБ.Перечисления.СтавкиНДС.НДС20); 
		СтруктураНДС.Вставить("Процент", 20); 
	КонецЕсли; 
	
	Возврат СтруктураНДС;
КонецФункции

Функция БПК3_ПолучитьФизЛицо(ИБ,СНИЛС,ИНН,КонтрСсылка) Экспорт
	
	// Функция выполняет поиск физического лица по переданному СНИЛС в справочнике "ФизическиеЛица".
	// В случае успеха возвращает ссылку на найденный элемент справочника. Если элемент с переданным
	// СНИЛС не найден, то функция пытается создать новый элемент в справочнике "ФизическиеЛица" с
	// переданным СНИЛС. В случае успеха возвращает Истину. В остальных случаях - Неопределено
	//-------------------------------------------------------------------------------------------------
	Доступно = (ТипЗнч(СНИЛС) = Тип("Строка"));
	Доступно = Доступно И (ТипЗнч(КонтрСсылка) = Тип("СправочникСсылка.Контрагенты"));
	Доступно = Доступно И ЗначениеЗаполнено(КонтрСсылка);
	Доступно = Доступно И ЗначениеЗаполнено(СНИЛС);
	
	Если (Доступно = Ложь) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Если мы оказались здесь, значит СНИЛС передан. Выполним поиск физического лица
	//-------------------------------------------------------------------------------------------------
	ТекстЗапроса = "
	|SELECT	TOP 1 Ссылка
	|FROM	Справочник.ФизическиеЛица
	|WHERE	(ПометкаУдаления = Ложь) И (СтраховойНомерПФР = &СНИЛС)
	|ORDER	BY Код DESC";
	
	Запрос = ИБ.NewObject("Запрос");
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("СНИЛС",ВРег(СокрЛП(СНИЛС)));
	Результат = Запрос.Выполнить().Выбрать();
	
	Если (Результат.Следующий() = Истина) Тогда
		Возврат (Результат.Ссылка);
	КонецЕсли;
	
	// Если мы оказались здесь, значит физлицо с переданным СНИЛС не найдено в базе и его нужно создать
	//-------------------------------------------------------------------------------------------------
	СпрОбъект = ИБ.Справочники.ФизическиеЛица.СоздатьЭлемент();
	СпрОбъект.ОбменДанными.Загрузка = Истина;
	СпрОбъект.Заполнить(Неопределено);
	СпрОбъект.УстановитьНовыйКод();
	
	// Попытаемся из полного ФИО выделить фамилию, имя, отчество и инициалы физического лица
	//-------------------------------------------------------------------------------------------------
	СтруктураФИО = ИБ.ФизическиеЛицаКлиентСервер.ЧастиИмени(КонтрСсылка.Наименование);
	СпрОбъект.Инициалы = ИБ.ФизическиеЛицаЗарплатаКадрыКлиентСервер.ИнициалыПоИмениОтчеству(СтруктураФИО.Имя,СтруктураФИО.Отчество);
	СпрОбъект.Отчество = СтруктураФИО.Отчество;
	СпрОбъект.Фамилия = СтруктураФИО.Фамилия;
	СпрОбъект.Имя = СтруктураФИО.Имя;
	
	// Если отчество определено, то попытаемся определить пол физического лица
	//-------------------------------------------------------------------------------------------------
	Если (ЗначениеЗаполнено(СпрОбъект.Отчество)) Тогда
		СпрОбъект.Пол = ИБ.СотрудникиКлиентСервер.ОпределитьПолПоОтчеству(СпрОбъект.Отчество);
	Иначе
		СпрОбъект.Пол = ИБ.Перечисления.ПолФизическогоЛица.Мужской;
	КонецЕсли;
	
	// Заполним остальные реквизиты
	//-------------------------------------------------------------------------------------------------
	СпрОбъект.ФИО = СокрЛП(КонтрСсылка.Наименование);
	СпрОбъект.СтраховойНомерПФР = ВРег(СокрЛП(СНИЛС));
	СпрОбъект.ДатаРождения = КонтрСсылка.ДатаОснования;
	СпрОбъект.ИНН = ВРег(Конвертация.СтрокаПолучить(ИНН));
	СпрОбъект.Наименование = СокрЛП(КонтрСсылка.Наименование);
	СпрОбъект.Записать();
	
	// Добавим сведения о паспорте физического лица (при наличии)
	//-------------------------------------------------------------------------------------------------
	Доступно = ЗначениеЗаполнено(КонтрСсылка.СерияДокумента);
	Доступно = Доступно И ЗначениеЗаполнено(КонтрСсылка.НомерДокумента);
	
	Если (Доступно = Истина) Тогда
		РегОбъект = ИБ.РегистрыСведений.ДокументыФизическихЛиц.СоздатьМенеджерЗаписи();
		РегОбъект.ВидДокумента = ИБ.Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ;
		РегОбъект.Период = НачалоДня(ЗначенияСервера.ТекущаяДатаСервер());
		РегОбъект.ЯвляетсяДокументомУдостоверяющимЛичность = Истина;
		РегОбъект.Физлицо = СпрОбъект.Ссылка;
		
		РегОбъект.ДатаВыдачи = КонтрСсылка.ДатаДокумента;
		РегОбъект.КемВыдан = СокрЛП(КонтрСсылка.ЭмитентДокумента);
		РегОбъект.Серия = ВРег(СокрЛП(КонтрСсылка.СерияДокумента));
		РегОбъект.Номер = ВРег(СокрЛП(КонтрСсылка.НомерДокумента));
		РегОбъект.Записать(Истина);
	КонецЕсли;
	
	Возврат (СпрОбъект.Ссылка);
КонецФункции

Функция БПК3_ПолучитьКонтрагента(ИБ,Контрагент,ПерсонализироватьФЛ = Ложь) Экспорт
	
	//=================================================================================================
	// Поиск переданного контрагента в справочнике "Контрагенты" переданной базы
	// Если искомый контрагент - юридическое лицо, то поиск выполняется по ИНН и КПП
	//=================================================================================================
	Если (Контрагент.ТипКонтрагента = Перечисления.ТипКонтрагента.Юл) Тогда
		ТекстЗапроса = "
		|SELECT	TOP 1 Ссылка
		|FROM	Справочник.Контрагенты
		|WHERE	(ПометкаУдаления = Ложь) И (ИНН <> """" И ИНН = &ИНН И КПП = &КПП)
		|ORDER	BY Код DESC";
		
		Запрос = ИБ.NewObject("Запрос");
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ИНН",СокрЛП(Контрагент.ИНН));
		Запрос.УстановитьПараметр("КПП",СокрЛП(Контрагент.КПП));
		Результат = Запрос.Выполнить().Выбрать();
		
		Если (Результат.Следующий() = Истина) Тогда
			Возврат (Результат.Ссылка);
		КонецЕсли;
		
		// Если искомый контрагент - индивидуальный предприниматель, то поиск выполняется только по ИНН
		//-------------------------------------------------------------------------------------------------
	ИначеЕсли (Контрагент.ТипКонтрагента = Перечисления.ТипКонтрагента.Ип) Тогда
		ТекстЗапроса = "
		|SELECT	TOP 1 Ссылка
		|FROM	Справочник.Контрагенты
		|WHERE	(ПометкаУдаления = Ложь) И (ИНН <> """" И ИНН = &ИНН)
		|ORDER	BY Код DESC";
		
		Запрос = ИБ.NewObject("Запрос");
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ИНН",СокрЛП(Контрагент.ИНН));
		Результат = Запрос.Выполнить().Выбрать();
		
		Если (Результат.Следующий() = Истина) Тогда
			Возврат (Результат.Ссылка);
		КонецЕсли;
		
		// Если мы оказались здесь, значит искомый контрагент - физическое лицо
		// Если параметр "ПерсонализироватьФЛ" равен Истине, значит требуется учет контрагентов-физических
		// лиц по наименованию (персонализированный учет). Попытаемся получить контрагента по его UID
		//-------------------------------------------------------------------------------------------------
	ИначеЕсли (ПерсонализироватьФЛ = Истина) Тогда
		ВнешИД = ИБ.NewObject("УникальныйИдентификатор",СокрЛП(Контрагент.УникальныйИдентификатор()));
		КонтрСсылка = ИБ.Справочники.Контрагенты.ПолучитьСсылку(ВнешИД);
		КонтрОбъект = КонтрСсылка.ПолучитьОбъект();
		
		Если (КонтрОбъект <> Неопределено) Тогда
			Возврат (КонтрСсылка);
		КонецЕсли;
		
		// Если мы оказались здесь, значит персонализированный учет по контрагентам не требуется. Выполним
		// поиск контрагента "Частное лицо" (делаем это запросом, т.к. нужно исключить удаленные записи)
		//-------------------------------------------------------------------------------------------------
	Иначе
		ТекстЗапроса = "
		|SELECT	TOP 1 Ссылка
		|FROM	Справочник.Контрагенты
		|WHERE	(ПометкаУдаления = Ложь) И (Наименование = ""Частное лицо"")
		|ORDER	BY Код DESC";
		
		Запрос = ИБ.NewObject("Запрос");
		Запрос.Текст = ТекстЗапроса;
		Результат = Запрос.Выполнить().Выбрать();
		
		Если (Результат.Следующий() = Истина) Тогда
			Возврат (Результат.Ссылка);
		КонецЕсли;
	КонецЕсли;
	
	//=================================================================================================
	// Если мы оказались здесь, значит переданный контрагент не найден в базе и его нужно создать
	// Внимание: новый контрагент сразу создается с уникальным идентификатором переданного контрагента
	//=================================================================================================
	ВнешИД = ИБ.NewObject("УникальныйИдентификатор",СокрЛП(Контрагент.УникальныйИдентификатор()));
	КонтрСсылка = ИБ.Справочники.Контрагенты.ПолучитьСсылку(ВнешИД);
	СпрОбъект = ИБ.Справочники.Контрагенты.СоздатьЭлемент();
	СпрОбъект.УстановитьСсылкуНового(КонтрСсылка);
	СпрОбъект.ОбменДанными.Загрузка = Истина;
	СпрОбъект.УстановитьНовыйКод();
	
	// Заполнение юридического лица
	//-------------------------------------------------------------------------------------------------
	Если (Контрагент.ТипКонтрагента = Перечисления.ТипКонтрагента.Юл) Тогда
		СпрОбъект.ЮридическоеФизическоеЛицо = ИБ.Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
		СпрОбъект.НаименованиеПолное = СокрЛП(Контрагент.НаименованиеПолное);
		СпрОбъект.Наименование = СокрЛП(Контрагент.Наименование);
		СпрОбъект.ИНН = ВРег(СокрЛП(Контрагент.ИНН));
		СпрОбъект.КПП = ВРег(СокрЛП(Контрагент.КПП));
		
		// Создание индивидуального предпринимателя
		//-------------------------------------------------------------------------------------------------
	ИначеЕсли (Контрагент.ТипКонтрагента = Перечисления.ТипКонтрагента.Ип) Тогда
		СпрОбъект.ЮридическоеФизическоеЛицо = ИБ.Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
		СпрОбъект.НаименованиеПолное = СокрЛП(Контрагент.НаименованиеПолное);
		СпрОбъект.Наименование = СокрЛП(Контрагент.Наименование);
		СпрОбъект.ИНН = ВРег(СокрЛП(Контрагент.ИНН));
		
		// Создание персонализированного физического лица
		//-------------------------------------------------------------------------------------------------
	ИначеЕсли (ПерсонализироватьФЛ = Истина) Тогда
		СпрОбъект.ЮридическоеФизическоеЛицо = ИБ.Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
		СпрОбъект.НаименованиеПолное = СокрЛП(Контрагент.Наименование);
		СпрОбъект.Наименование = СокрЛП(Контрагент.Наименование);
		
		Если (ЗначениеЗаполнено(Контрагент.НомерДокумента)) Тогда
			СтрДок = Конвертация.ПараметрДобавить("","",СокрЛП(Контрагент.ТипДокумента));
			СтрДок = Конвертация.ПараметрДобавить(СтрДок,"Серия:",СокрЛП(Контрагент.СерияДокумента));
			СтрДок = Конвертация.ПараметрДобавить(СтрДок,"Номер:",СокрЛП(Контрагент.НомерДокумента));
			СтрДок = Конвертация.ПараметрДобавить(СтрДок,"Выдан:",СокрЛП(Контрагент.ЭмитентДокумента));
			СпрОбъект.ДокументУдостоверяющийЛичность = СокрЛП(СтрДок);
		КонецЕсли;
		
		// Если мы оказались здесь, значит создается неперсонализированное физическое лицо
		//-------------------------------------------------------------------------------------------------
	Иначе
		СпрОбъект.ЮридическоеФизическоеЛицо = ИБ.Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
		СпрОбъект.НаименованиеПолное = "Частное лицо";
		СпрОбъект.Наименование = "Частное лицо";
	КонецЕсли;
	
	// Запишем контрагента и вернем ссылку на него
	//-------------------------------------------------------------------------------------------------
	СпрОбъект.Записать();
	Возврат (СпрОбъект.Ссылка);
КонецФункции

Функция БПК3_ПолучитьДоговорКонтрагента(ИБ,СтруктураЭлемента,ОбособленноеПодразделение,ДогНомерДоступно = Ложь) Экспорт  
	
	// Функция выполняет поиск и создание (при необходимости) договора. Если параметр ДогНомерДоступно
	// равен Истине, то поиск и создание договора будет выполняться с учетом переданного номера,
	// независимо от того является контрагент физическим лицом или нет
	//------------------------------------------------------------------------------------------------- 
	
	НайденныйЭлемент = Неопределено; 
	
	Доступно = (СтруктураЭлемента.Свойство("УИДДоговора")=Истина);
	Доступно = Доступно И (ЗначениеЗаполнено(СтруктураЭлемента.УИДДоговора)=Истина); 
	Доступно = Доступно И (Конвертация.ЭтоУникальныйИдентификатор(СтруктураЭлемента.УИДДоговора)=Истина);
	
	Если Доступно=Истина Тогда
		УИДДоговора = ИБ.NewObject("УникальныйИдентификатор", СтруктураЭлемента.УИДДоговора);
		СпрСсылка = ИБ.Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(УИДДоговора);
		СпрОбъект = СпрСсылка.ПолучитьОбъект();
		Если СпрОбъект<>Неопределено Тогда
			НайденныйЭлемент = СпрСсылка;			
		КонецЕсли;
	Иначе
		УИДДоговора = Неопределено;
	КонецЕсли;
	
	Если НайденныйЭлемент=Неопределено Тогда
		НаименованиеДоговора = СокрЛП(ИБ.String(СтруктураЭлемента.ВидДоговора));
		НаименованиеДоговора = НаименованиеДоговора + " " + СокрЛП(ИБ.String(СтруктураЭлемента.Организация));
		
		Запрос = ИБ.NewObject("Запрос");
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка
		|ПОМЕСТИТЬ Договоры
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ                                                                                                                            
		|	ДоговорыКонтрагентов.Владелец = &Владелец
		|	И ДоговорыКонтрагентов.Организация = &Организация
		|	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора
		|	И ДоговорыКонтрагентов.ПометкаУдаления = ЛОЖЬ";
		
		Запрос.УстановитьПараметр("Владелец", СтруктураЭлемента.Контрагент);
		Запрос.УстановитьПараметр("Организация", СтруктураЭлемента.Организация);
		Запрос.УстановитьПараметр("ВидДоговора", СтруктураЭлемента.ВидДоговора);
		
		// Выясним нужно ли искать договор с учетом его номера. Поиск договора с учетом номера выполняется
		// если у контрагента заполнен ИНН или параметр "ДогНомерДоступно" равен Истине
		//-------------------------------------------------------------------------------------------------
		УчетПоНомеруДоговора = (ДогНомерДоступно = Истина);
		УчетПоНомеруДоговора = УчетПоНомеруДоговора ИЛИ ЗначениеЗаполнено(СтруктураЭлемента.Контрагент.ИНН);
		УчетПоНомеруДоговора = УчетПоНомеруДоговора И ЗначениеЗаполнено(СтруктураЭлемента.НомерДоговора);
		
		Если (УчетПоНомеруДоговора = Истина) Тогда
			Запрос.Текст = Запрос.Текст + "
			|	И ДоговорыКонтрагентов.Номер = &Номер";
			
			Запрос.УстановитьПараметр("Номер", СтруктураЭлемента.НомерДоговора);
		Иначе
			Запрос.Текст = Запрос.Текст + "
			|	И ДоговорыКонтрагентов.Наименование ПОДОБНО &Наименование";
			
			Запрос.УстановитьПараметр("Наименование", НаименованиеДоговора+"%");
		КонецЕсли; 
		
		// Продолжим формирование текста запроса
		//-------------------------------------------------------------------------------------------------
		Запрос.Текст = Запрос.Текст+"
		|;
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|		ДополнительныеРеквизитыИСведения.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ Свойство
		|ИЗ
		|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
		|ГДЕ
		|	ДополнительныеРеквизитыИСведения.НаборСвойств = ЗНАЧЕНИЕ(Справочник.НаборыДополнительныхРеквизитовИСведений.Справочник_ДоговорыКонтрагентов)
		|	И ДополнительныеРеквизитыИСведения.Заголовок = ""Подразделение""
		|	И ЭтоДополнительноеСведение=ЛОЖЬ
		|;
		|ВЫБРАТЬ
		|	Ссылка,
		|	Значение
		|ПОМЕСТИТЬ ДоговорыСвойства
		|ИЗ Справочник.ДоговорыКонтрагентов.ДополнительныеРеквизиты
		|ГДЕ Ссылка В (ВЫБРАТЬ Ссылка ИЗ Договоры) И Свойство В (ВЫБРАТЬ Ссылка ИЗ Свойство)
		|;
		|ВЫБРАТЬ
		|	Ссылка, Значение 
		|ПОМЕСТИТЬ ВсеДоговоры 
		|ИЗ ДоговорыСвойства
		|ОБЪЕДИНИТЬ ВСЕ
		|ВЫБРАТЬ 
		|	Ссылка, ЗНАЧЕНИЕ(Справочник.ПодразделенияОрганизаций.ПустаяСсылка)
		|ИЗ Справочник.ДоговорыКонтрагентов 
		|ГДЕ Ссылка В (ВЫБРАТЬ Ссылка ИЗ Договоры) И НЕ Ссылка В (ВЫБРАТЬ Ссылка ИЗ ДоговорыСвойства)
		|;
		|ВЫБРАТЬ ПЕРВЫЕ 1 ВсеДоговоры.Ссылка 
		|ИЗ ВсеДоговоры КАК ВсеДоговоры
		|ЛЕВОЕ СОЕДИНЕНИЕ Свойство КАК Свойство ПО ИСТИНА=ИСТИНА 
		|ГДЕ (Значение=&Значение ИЛИ Свойство.Ссылка IS NULL)
		|УПОРЯДОЧИТЬ ПО
		|	ВсеДоговоры.Ссылка.Код УБЫВ	
		|";
		
		Запрос.УстановитьПараметр("Значение", ОбособленноеПодразделение);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			НайденныйЭлемент = Выборка.Ссылка;
		КонецЦикла; 
		
		Если НайденныйЭлемент=Неопределено Тогда
			ЭлементОбъект = ИБ.Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
			
			Если УИДДоговора<>Неопределено Тогда
				СпрСсылка = ИБ.Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(УИДДоговора);
				ЭлементОбъект.УстановитьСсылкуНового(СпрСсылка);	
			КонецЕсли;
			
			ЭлементОбъект.Наименование = НаименованиеДоговора;
			
			ЭлементОбъект.Владелец = СтруктураЭлемента.Контрагент;
			ЭлементОбъект.Организация = СтруктураЭлемента.Организация;
			ЭлементОбъект.ВидДоговора = СтруктураЭлемента.ВидДоговора;
			ЭлементОбъект.ВалютаВзаиморасчетов = ИБ.Константы.ВалютаРегламентированногоУчета.Получить();
			
			// Lemmy
			// Если переменная "УчетПоНомеруДоговора" равна Истине, значит поиск выполнялся по номеру договора,
			// поэтому и создание договора также должно учитывать его номер. Заполним номер договора, а также
			// сформируем наименование элемента с учетом номера
			//-------------------------------------------------------------------------------------------------
			Если (УчетПоНомеруДоговора = Истина) Тогда
				ЭлементОбъект.Номер = ВРег(СокрЛП(СтруктураЭлемента.НомерДоговора));
				
				// Если дата договора передана, то заполним реквизит с датой и учтем ее в наименовании договора
				//-------------------------------------------------------------------------------------------------
				Доступно = (СтруктураЭлемента.Свойство("ДатаДоговора") = Истина);
				Доступно = Доступно И ЗначениеЗаполнено(СтруктураЭлемента.ДатаДоговора);
				
				Если (Доступно = Истина) Тогда
					ЭлементОбъект.Дата = НачалоДня(СтруктураЭлемента.ДатаДоговора);
					
					СтрТемп = СокрЛП(ЭлементОбъект.Номер) + " от ";
					СтрТемп = СтрТемп + СокрЛП(Формат(ЭлементОбъект.Дата,"ДЛФ=DD"));
					СтрТемп = СтрТемп + ", " + СокрЛП(ИБ.String(СтруктураЭлемента.Организация));
					ЭлементОбъект.Наименование = СокрЛП(СтрТемп);
				КонецЕсли;
			КонецЕсли; 
			
			ЭлементОбъект.СпособВыставленияДокументов = ИБ.Перечисления.СпособыВыставленияДокументов.Автоматически;
			
			ЭлементОбъект.СрокОплаты = 0;
			ЭлементОбъект.УстановленСрокОплаты = Ложь;
			
			// Дополнительные реквизиты
			//====================================================================================================================== 
			Если ИБ.ЗначениеЗаполнено(ОбособленноеПодразделение)=Истина Тогда
				РеквизитПодразделение = ИБ.ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Заголовок", "Подразделение");
				Если РеквизитПодразделение.Пустая()=Ложь Тогда
					СтрокаДополнительныеРеквизиты = ЭлементОбъект.ДополнительныеРеквизиты.Найти(РеквизитПодразделение, "Свойство");
					Если СтрокаДополнительныеРеквизиты = Неопределено Тогда
						СтрокаДополнительныеРеквизиты = ЭлементОбъект.ДополнительныеРеквизиты.Добавить();
					КонецЕсли;
					СтрокаДополнительныеРеквизиты.Свойство = РеквизитПодразделение;
					СтрокаДополнительныеРеквизиты.Значение = ОбособленноеПодразделение;
				КонецЕсли;			
			КонецЕсли; 
			
			ЭлементОбъект.УстановитьНовыйКод();
			ЭлементОбъект.ОбменДанными.Загрузка = Истина;
			ЭлементОбъект.Записать();
			
			НайденныйЭлемент = ЭлементОбъект.Ссылка;
		КонецЕсли; 
	КонецЕсли;
	
	Возврат НайденныйЭлемент;
КонецФункции

Функция БПК3_ПолучитьПользователя(ИБ, Наименование) Экспорт
	ЭлементСсылка = Неопределено;
	
	Запрос = ИБ.NewObject("Запрос");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Пользователи.Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.Наименование ПОДОБНО &Наименование
	|	И Пользователи.ПометкаУдаления = ЛОЖЬ
	|УПОРЯДОЧИТЬ ПО Недействителен
	|";
	
	Запрос.УстановитьПараметр("Наименование", СокрЛП(Наименование));
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭлементСсылка = Выборка.Ссылка;
	КонецЦикла;  
	
	Если ЭлементСсылка=Неопределено Тогда
		ЭлементОбъект = ИБ.Справочники.Пользователи.СоздатьЭлемент();
		
		ЭлементОбъект.Наименование = СокрЛП(Наименование);
		ЭлементОбъект.УстановитьНовыйКод();
		
		ЭлементОбъект.ОбменДанными.Загрузка = Истина;
		ЭлементОбъект.Записать();
		
		ЭлементСсылка = ЭлементОбъект.Ссылка;
	КонецЕсли;  
	
	Возврат ЭлементСсылка;
КонецФункции

Функция БПК3_ПолучитьВидОплаты(ИБ, ИННОрганизации, ОбособленноеПодразделение) Экспорт
	// получаем последний вид оплаты по организации
	
	ЭлементСсылка = Неопределено;
	
	Если ЗначениеЗаполнено(ИННОрганизации)=Ложь Тогда
		Возврат ЭлементСсылка;		
	КонецЕсли; 
	
	Запрос = ИБ.NewObject("Запрос");
	Запрос.Текст = "
	|	ВЫБРАТЬ ПЕРВЫЕ 1
	|		ДополнительныеРеквизитыИСведения.Ссылка КАК Ссылка
	|	ПОМЕСТИТЬ Свойство
	|	ИЗ
	|		ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
	|	ГДЕ
	|		ДополнительныеРеквизитыИСведения.НаборСвойств = ЗНАЧЕНИЕ(Справочник.НаборыДополнительныхРеквизитовИСведений.Справочник_ДоговорыКонтрагентов)
	|		И ДополнительныеРеквизитыИСведения.Заголовок = ""Подразделение""
	|		И ЭтоДополнительноеСведение=ЛОЖЬ
	|	;
	|	ВЫБРАТЬ
	|		Ссылка
	|	ПОМЕСТИТЬ Договоры
	|	ИЗ Справочник.ДоговорыКонтрагентов.ДополнительныеРеквизиты
	|	ГДЕ Свойство В (ВЫБРАТЬ Ссылка ИЗ Свойство)
	|		И Значение=&Значение
	|		И Ссылка.Организация.ИНН=&ИНН
	|	;
	|	ВЫБРАТЬ
	|		Ссылка
	|	ПОМЕСТИТЬ ДоговорыБезПодразделения
	|	ИЗ Справочник.ДоговорыКонтрагентов
	|	ГДЕ НЕ Ссылка В (ВЫБРАТЬ Ссылка ИЗ Договоры)
	|		И Ссылка.Организация.ИНН=&ИНН
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Ссылка
	|	ИЗ Справочник.ДоговорыКонтрагентов.ДополнительныеРеквизиты
	|	ГДЕ Свойство В (ВЫБРАТЬ Ссылка ИЗ Свойство)
	|		И Значение=ЗНАЧЕНИЕ(Справочник.ПодразделенияОрганизаций.ПустаяСсылка)
	|		И Ссылка.Организация.ИНН=&ИНН
	|	;
	|	ВЫБРАТЬ ПЕРВЫЕ 1
	|		Ссылка
	|	ИЗ Справочник.ВидыОплатОрганизаций
	|	ГДЕ Организация.ИНН=&ИНН
	|		И ТипОплаты=ЗНАЧЕНИЕ(Перечисление.ТипыОплат.ПлатежнаяКарта)
	|		И 
	|		((ДоговорКонтрагента В (ВЫБРАТЬ Ссылка ИЗ Договоры) И &ПустойДоговор=ЛОЖЬ)
	|		ИЛИ
	|		(ДоговорКОнтрагента В (ВЫБРАТЬ Ссылка ИЗ ДоговорыБезПодразделения) И &ПустойДоговор=ИСТИНА))
	|	УПОРЯДОЧИТЬ ПО Код УБЫВ";
	
	Запрос.УстановитьПараметр("ИНН", СокрЛП(ИННОрганизации));
	
	Если ОбособленноеПодразделение=Неопределено Тогда
		Запрос.УстановитьПараметр("ПустойДоговор", Истина);
		Запрос.УстановитьПараметр("Значение", ИБ.Справочники.ПодразделенияОрганизаций.ПустаяСсылка());
	Иначе
		Запрос.УстановитьПараметр("ПустойДоговор", Ложь);
		Запрос.УстановитьПараметр("Значение", ОбособленноеПодразделение);
	КонецЕсли; 
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭлементСсылка = Выборка.Ссылка;			
	КонецЦикла; 
	
	Если (ЭлементСсылка = Неопределено) И (ОбособленноеПодразделение<>Неопределено) Тогда
		ЭлементСсылка = БПК3_ПолучитьВидОплаты(ИБ, ИННОрганизации, Неопределено);		
	КонецЕсли; 
	
	Возврат ЭлементСсылка;
КонецФункции

Функция БПК3_ПолучитьОбособленноеПодразделение(ИБ, Организация, ТочкаОформления) Экспорт
	ЭлементСсылка = Неопределено;
	
	Если ЗначениеЗаполнено(Организация)=Ложь ИЛИ ЗначениеЗаполнено(ТочкаОформления)=Ложь Тогда
		Возврат ЭлементСсылка;		
	КонецЕсли;  
	
	Если ИБ.Метаданные.Справочники.Найти("АВ_НастройкиОбмена")<>Неопределено 
		И ИБ.Метаданные.Справочники.АВ_НастройкиОбмена.ТабличныеЧасти.Найти("СоответствияОрганизаций")<>Неопределено Тогда 
		// Получаем обособленное подразделение из табличной части СоответствияОрганизаций справочника АВ_НастройкиОбмена
		//======================================================================================================================
		Запрос = ИБ.NewObject("Запрос");
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ПодразделениеОрганизации КАК ПодразделениеОрганизации
		|ИЗ
		|	Справочник.АВ_НастройкиОбмена.СоответствияОрганизаций
		|ГДЕ
		|	Организация.ИНН = &ОрганизацияИНН
		|	И (ТочкаОформления.Наименование ПОДОБНО &ТочкаОформленияНаименование
		|			ИЛИ ТочкаОформления = ЗНАЧЕНИЕ(Справочник.ЗначенияСвойствОбъектов.ПустаяСсылка))
		|УПОРЯДОЧИТЬ ПО
		|	ВЫБОР
		|		КОГДА ТочкаОформления.Наименование = &ТочкаОформленияНаименование
		|			ТОГДА 0
		|		КОГДА ТочкаОформления.Наименование ПОДОБНО &ТочкаОформленияНаименование
		|			ТОГДА 1
		|		ИНАЧЕ 99
		|	КОНЕЦ,
		|	НомерСтроки
		|";
		
		Запрос.УстановитьПараметр("ОрганизацияИНН", СокрЛП(Организация.ИНН));
		Запрос.УстановитьПараметр("ТочкаОформленияНаименование", СокрЛП(ТочкаОформления.Наименование));  
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ЭлементСсылка = Выборка.ПодразделениеОрганизации;			
		КонецЦикла; 
	Иначе  
		// Получаем обособленное подразделение по дополнительному свойству "УИД_ОП", куда помещаем УИД Точки _ УИД Организации 
		//-------------------------------------------------------------------------------------------------	 
		СтруктураХолдераНаТочке = ОбщНазн.ХолдерНаТочкеПолучитьСтруктуру(Организация, ТочкаОформления); 
		
		Запрос = ИБ.NewObject("Запрос");
		Запрос.Текст = 
		"	ВЫБРАТЬ ПЕРВЫЕ 1
		|		ДополнительныеРеквизитыИСведения.Ссылка КАК Ссылка
		|	ПОМЕСТИТЬ Свойство
		|	ИЗ
		|		ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
		|	ГДЕ
		|		ДополнительныеРеквизитыИСведения.НаборСвойств = ЗНАЧЕНИЕ(Справочник.НаборыДополнительныхРеквизитовИСведений.Справочник_ПодразделенияОрганизаций)
		|		И ДополнительныеРеквизитыИСведения.Заголовок = ""УИД_ОП""
		|		И ЭтоДополнительноеСведение=ИСТИНА
		|	;
		|	ВЫБРАТЬ
		|		Объект КАК Ссылка
		|	ИЗ РегистрСведений.ДополнительныеСведения
		|	ГДЕ Свойство В (ВЫБРАТЬ Ссылка ИЗ Свойство)
		|		И Значение=&Значение
		|";
		
		Запрос.УстановитьПараметр("Значение", СтруктураХолдераНаТочке.КлючОбменаБП);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ЭлементСсылка = Выборка.Ссылка;			
		КонецЦикла; 
	КонецЕсли;
	
	Возврат ЭлементСсылка;
КонецФункции

Функция БПК3_СоздатьПриходныйКассовыйОрдер(Организация,СтруктураДокумента) Экспорт
	Ответ = Новый Структура("НомерДокумента, ИдентификаторДокумента, Результат");
	Ответ.НомерДокумента = Неопределено;
	Ответ.ИдентификаторДокумента = Неопределено;
	Ответ.Результат = Неопределено;
	
	Если Организация.ВыгружатьКассовыеДокументы=Ложь Тогда
		Возврат Ответ;		
	КонецЕсли; 
	
	ИБ = ПодключитьИнформационнуюБазу(Организация.ИнформационнаяБазаБухгалтерии);
	Если ИБ=Неопределено Тогда
		Ответ.Результат = "Ошибка подключения к бухгалтерской ИБ!";
		Возврат Ответ;
	КонецЕсли;
	
	ДокументОбъект = ИБ.Документы.ПриходныйКассовыйОрдер.CreateDocument();
	
	ДокументОбъект.Дата = СтруктураДокумента.Дата;
	
	ДокументОбъект.Организация = ИБ.Справочники.Организации.НайтиПоРеквизиту("ИНН", Организация.ИНН);
	Если ИБ.ЗначениеЗаполнено(ДокументОбъект.Организация)=Ложь Тогда
		Ответ.Результат = "Не найдена организация "+СокрЛП(Организация)+" в бухгалтерской ИБ!";
		Возврат Ответ;
	КонецЕсли;
	
	ОбособленноеПодразделение = БПК3_ПолучитьОбособленноеПодразделение(ИБ, Организация, СтруктураДокумента.ТочкаОформления);
	Если ОбособленноеПодразделение<>Неопределено Тогда
		ДокументОбъект.ПодразделениеОрганизации = ОбособленноеПодразделение;
	КонецЕсли; 
	
	Если ИБ.УчетнаяПолитика.ПлательщикЕНВД(ДокументОбъект.Организация, ДокументОбъект.Дата) ИЛИ ИБ.УчетнаяПолитика.ПрименяетсяУСН(ДокументОбъект.Организация, ДокументОбъект.Дата) ИЛИ ИБ.УчетнаяПолитика.ПрименяетсяУСНПатент(ДокументОбъект.Организация, ДокументОбъект.Дата) Тогда
		СтавкаНДС = ИБ.Перечисления.СтавкиНДС.БезНДС;
		СуммаНДС = 0;
	Иначе
		СтруктураНДС = БПК3_ПолучитьАктуальнуюПолнуюСтавкуНДС(ИБ, ДокументОбъект.Дата);
		СтавкаНДС = СтруктураНДС.Ставка;
		СуммаНДС = Окр((СтруктураДокумента.СуммаДокумента*СтруктураНДС.Процент)/(100+СтруктураНДС.Процент),2,РежимОкругления.Окр15как10);
	КонецЕсли;	
	
	ДокументОбъект.ВидОперации = ИБ.Перечисления.ВидыОперацийПКО.ОплатаПокупателя;
	ДокументОбъект.ВалютаДокумента = ИБ.Константы.ВалютаРегламентированногоУчета.Получить();
	
	ИБ.ЗаполнениеДокументов.Заполнить(ДокументОбъект, Неопределено, Истина);
	ДокументОбъект.СчетКасса = ИБ.ПланыСчетов.Хозрасчетный.КассаОрганизации;
	ДокументОбъект.СуммаДокумента = СтруктураДокумента.СуммаДокумента;
	
	// Хахалин
	// Если в параметре "СтруктураДокумента" есть реквизит "ПерсонализироватьФЛ", то передадим его
	// в функцию поиска/создания контрагента. Если реквизит отсутствует, то передадим Ложь. Этот
	// реквизит влияет на персонализацию контрагентов - физических лиц (Истина - поиск/создание
	// выполняется по наименованию контрагента, Ложь - контрагент всегда "Частное лицо")
	//-------------------------------------------------------------------------------------------------
	ПерсДоступно = ?(СтруктураДокумента.Свойство("ПерсонализироватьФЛ") = Истина,СтруктураДокумента.ПерсонализироватьФЛ,Ложь);
	ДокументОбъект.Контрагент = БПК3_ПолучитьКонтрагента(ИБ,СтруктураДокумента.Контрагент,ПерсДоступно);
	
	Если ИБ.ЗначениеЗаполнено(ДокументОбъект.Контрагент)=Ложь Тогда
		Ответ.Результат = "Не найден контрагент "+СокрЛП(СтруктураДокумента.Контрагент)+" в бухгалтерской ИБ!";
		Возврат Ответ;
	КонецЕсли; 
	
	ДокументОбъект.РасшифровкаПлатежа.Очистить();
	нСтрока = ДокументОбъект.РасшифровкаПлатежа.Добавить();
	
	// Хахалин
	// Если в параметре "СтруктураДокумента" есть реквизит "УчетПоНомеруДоговора", то передадим его
	// в функцию поиска/создания договора. Если реквизит отсутствует, то передадим Ложь. Этот реквизит
	// говорит о том, что поиск договора контрагента должен выполняться по номеру договора, независимо
	// от того является контрагент физическим лицом или нет
	//-------------------------------------------------------------------------------------------------
	ДогНомерДоступно = ?(СтруктураДокумента.Свойство("УчетПоНомеруДоговора") = Истина,СтруктураДокумента.УчетПоНомеруДоговора,Ложь);
	
	СтруктураЭлемента = Новый Структура("Контрагент, Организация, ВидДоговора, НомерДоговора, ДатаДоговора, УИДДоговора");
	СтруктураЭлемента.Контрагент = ДокументОбъект.Контрагент;
	СтруктураЭлемента.Организация = ДокументОбъект.Организация;
	СтруктураЭлемента.ВидДоговора = ИБ.Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
	СтруктураЭлемента.НомерДоговора = СтруктураДокумента.НомерДоговора;
	СтруктураЭлемента.ДатаДоговора = СтруктураДокумента.ДатаДоговора;
	СтруктураДокумента.Свойство("УИДДоговора", СтруктураЭлемента.УИДДоговора);
	
	нСтрока.ДоговорКонтрагента = БПК3_ПолучитьДоговорКонтрагента(ИБ,СтруктураЭлемента,ДокументОбъект.ПодразделениеОрганизации,ДогНомерДоступно);
	
	нСТрока.СпособПогашенияЗадолженности  = ИБ.Перечисления.СпособыПогашенияЗадолженности.Автоматически;
	нСтрока.СуммаПлатежа = СтруктураДокумента.СуммаДокумента;
	нСтрока.КурсВзаиморасчетов = 1;
	нСтрока.СуммаВзаиморасчетов = СтруктураДокумента.СуммаДокумента;                                                    
	нСТрока.СуммаНДС = СуммаНДС;
	нСтрока.СтавкаНДС = СтавкаНДС;
	
	нСтрока.СтатьяДвиженияДенежныхСредств = ИБ.Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Поступление от покупателей", Истина);
	
	// Отражение аванса в зависимости от вида деятельности	
	//======================================================================================================================
	СистемаНалогообложения = ЗначенияСервера.ПолучитьСистемуНалогообложения(Организация, СтруктураДокумента.ТочкаОформления, СтруктураДокумента.Дата);
	Если СистемаНалогообложения=Перечисления.СистемыНалогообложения.Патент Тогда
		ПараметрыДеятельности = ИБ.УчетПСН.ДеятельностьНаПатентеПоУмолчанию(ДокументОбъект.Организация, ДокументОбъект.Дата);
		ИБ.ЗаполнитьЗначенияСвойств(ДокументОбъект, ПараметрыДеятельности);
		
		нСтрока.ПорядокОтраженияАванса = ПараметрыДеятельности.Патент;
	ИначеЕсли СистемаНалогообложения=Перечисления.СистемыНалогообложения.УСН ИЛИ СистемаНалогообложения=Перечисления.СистемыНалогообложения.УСНДоходРасход Тогда
		нСтрока.ПорядокОтраженияАванса = ИБ.Перечисления.ПорядокОтраженияАвансов.ДоходУСН;		
	КонецЕсли;
	
	//======================================================================================================================
	// счета учета
	нСтрока.СчетУчетаРасчетовСКонтрагентом = ИБ.ПланыСчетов.Хозрасчетный.РасчетыСПокупателями;
	нСтрока.СчетУчетаРасчетовПоАвансам = ИБ.ПланыСчетов.Хозрасчетный.РасчетыПоАвансамПолученным;
	
	ДокументОбъект.Ответственный = БПК3_ПолучитьПользователя(ИБ, СтруктураДокумента.Автор);
	
	ДокументОбъект.ПринятоОт = СокрЛп(СтруктураДокумента.ПринятоОт);
	ДокументОбъект.Основание = СокрЛп(СтруктураДокумента.Основание);
	ДокументОбъект.Приложение = СокрЛп(СтруктураДокумента.Приложение);
	
	ДокументОбъект.Комментарий = СтруктураДокумента.Комментарий;
	
	ДокументОбъект.УстановитьНовыйНомер();
	Попытка
		ДокументОбъект.Записать(ИБ.РежимЗаписиДокумента.Проведение);
		
		Ответ.НомерДокумента = СокрЛП(ДокументОбъект.Номер);
		Ответ.ИдентификаторДокумента = ИБ.XMLСтрока(ДокументОбъект.Ссылка);
		Ответ.Результат = "ОК";
	Исключение
		Попытка
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			РежимЗаписи = ИБ.РежимЗаписиДокумента.Запись;	
			ДокументОбъект.Записать(РежимЗаписи);
			
			Ответ.НомерДокумента = СокрЛП(ДокументОбъект.Номер);
			Ответ.ИдентификаторДокумента = ИБ.XMLСтрока(ДокументОбъект.Ссылка);
			Ответ.Результат = "ОК";
			
		Исключение	
			
			Ответ.НомерДокумента = Неопределено;
			Ответ.ИдентификаторДокумента = Неопределено;
			Ответ.Результат = "Ошибка проведения документа: "+ОписаниеОшибки();
		КонецПопытки;
	КонецПопытки;
	
	ИБ = Неопределено;
	
	Возврат Ответ;	
КонецФункции

Функция БПК3_СоздатьРасходныйКассовыйОрдер(Организация,СтруктураДокумента) Экспорт
	
	Ответ = Новый Структура("НомерДокумента, ИдентификаторДокумента, Результат");
	Ответ.НомерДокумента = Неопределено;
	Ответ.ИдентификаторДокумента = Неопределено;
	Ответ.Результат = Неопределено;
	
	Если Организация.ВыгружатьКассовыеДокументы=Ложь Тогда
		Возврат Ответ;		
	КонецЕсли; 
	
	ИБ = ПодключитьИнформационнуюБазу(Организация.ИнформационнаяБазаБухгалтерии);
	Если ИБ=Неопределено Тогда
		Ответ.Результат = "Ошибка подключения к бухгалтерской ИБ!";
		Возврат Ответ;
	КонецЕсли;
	
	ДокументОбъект = ИБ.Документы.РасходныйКассовыйОрдер.CreateDocument();
	
	ДокументОбъект.Дата = СтруктураДокумента.Дата;
	
	ДокументОбъект.Организация = ИБ.Справочники.Организации.НайтиПоРеквизиту("ИНН", Организация.ИНН);
	Если ИБ.ЗначениеЗаполнено(ДокументОбъект.Организация)=Ложь Тогда
		Ответ.Результат = "Не найдена организация "+СокрЛП(Организация)+" в бухгалтерской ИБ!";
		Возврат Ответ;
	КонецЕсли; 
	
	ОбособленноеПодразделение = БПК3_ПолучитьОбособленноеПодразделение(ИБ, Организация, СтруктураДокумента.ТочкаОформления);
	Если ОбособленноеПодразделение<>Неопределено Тогда
		ДокументОбъект.ПодразделениеОрганизации = ОбособленноеПодразделение;
	КонецЕсли; 
	
	Если ИБ.УчетнаяПолитика.ПлательщикЕНВД(ДокументОбъект.Организация, ДокументОбъект.Дата) ИЛИ ИБ.УчетнаяПолитика.ПрименяетсяУСН(ДокументОбъект.Организация, ДокументОбъект.Дата) Тогда
		СтавкаНДС = ИБ.Перечисления.СтавкиНДС.БезНДС;
		СуммаНДС = 0;
	Иначе
		СтруктураНДС = БПК3_ПолучитьАктуальнуюПолнуюСтавкуНДС(ИБ, ДокументОбъект.Дата);
		СтавкаНДС = СтруктураНДС.Ставка;
		СуммаНДС = Окр((СтруктураДокумента.СуммаДокумента*СтруктураНДС.Процент)/(100+СтруктураНДС.Процент),2,РежимОкругления.Окр15как10);
	КонецЕсли;	
	
	// Хахалин
	// В параметре "СтруктураДокумента" (тип - Структура) можно передавать дополнительный реквизит
	// "ЭтоОплатаПоставщику" (булево). Если реквизит присутствует и он равен Истине, то вид операции
	// и статья движения ДС в создаваемом РКО примут значения связанные с оплатой поставщикам. Во всех
	// остальных случаях документ настраивается как "ВозвратПокупателю"
	//-------------------------------------------------------------------------------------------------
	ЭтоОплатаПоставщику = (СтруктураДокумента.Свойство("ЭтоОплатаПоставщику") = Истина) И (СтруктураДокумента.ЭтоОплатаПоставщику = Истина);   
	ЭтоОплатаКомитенту = СтруктураДокумента.Свойство("ЭтоОплатаКомитенту") И (СтруктураДокумента.ЭтоОплатаКомитенту = Истина);
	ЭтоОплатаПоДВОУ = СтруктураДокумента.Свойство("ЭтоОплатаПоДВОУ") И (СтруктураДокумента.ЭтоОплатаПоДВОУ = Истина);
	
	Если (ЭтоОплатаПоДВОУ = Истина) Тогда
		ДокументОбъект.ВидОперации = ИБ.Перечисления.ВидыОперацийРКО.ВыплатаСотрудникуПоДоговоруПодряда;
		ТекСтатьяДДС = ИБ.Справочники.СтатьиДвиженияДенежныхСредств.ОплатаПоставщику;
		ТекВидДоговора = ИБ.Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
		
		ТекСчетРасчетовПоКонтрагентам = ИБ.ПланыСчетов.Хозрасчетный.ПрочиеРасчетыСФизическимиЛицами;
		ТекСчетРасчетовПоАвансам = ИБ.ПланыСчетов.Хозрасчетный.ПрочиеРасчетыСФизическимиЛицами;
		
	ИначеЕсли (ЭтоОплатаПоставщику = Истина) Тогда
		ДокументОбъект.ВидОперации = ИБ.Перечисления.ВидыОперацийРКО.ОплатаПоставщику;
		
		ТекСтатьяДДС = ИБ.Справочники.СтатьиДвиженияДенежныхСредств.ОплатаПоставщику;
		ТекВидДоговора = ИБ.Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
		ТекСчетРасчетовПоКонтрагентам = ИБ.ПланыСчетов.Хозрасчетный.РасчетыСПоставщиками;
		ТекСчетРасчетовПоАвансам = ИБ.ПланыСчетов.Хозрасчетный.РасчетыПоАвансамВыданным;
		
	ИначеЕсли ЭтоОплатаКомитенту Тогда
		ДокументОбъект.ВидОперации 		= ИБ.Перечисления.ВидыОперацийРКО.ОплатаПоставщику;
		
		ТекСтатьяДДС 					= ИБ.Справочники.СтатьиДвиженияДенежныхСредств.ОплатаПоставщику;
		ТекВидДоговора 					= ИБ.Перечисления.ВидыДоговоровКонтрагентов.СКомитентом;
		ТекСчетРасчетовПоКонтрагентам 	= ИБ.ПланыСчетов.Хозрасчетный.ПрочиеРасчетыСРазнымиДебиторамиИКредиторами;
		ТекСчетРасчетовПоАвансам 		= ИБ.ПланыСчетов.Хозрасчетный.ПрочиеРасчетыСРазнымиДебиторамиИКредиторами;
		
	Иначе
		ДокументОбъект.ВидОперации = ИБ.Перечисления.ВидыОперацийРКО.ВозвратПокупателю;
		
		ТекВидДоговора = ИБ.Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
		ТекСчетРасчетовПоКонтрагентам = ИБ.ПланыСчетов.Хозрасчетный.РасчетыСПокупателями;
		ТекСчетРасчетовПоАвансам = ИБ.ПланыСчетов.Хозрасчетный.РасчетыПоАвансамПолученным;
		ТекСтатьяДДС = ИБ.Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Возврат покупателю",Истина);
	КонецЕсли;
	
	
	ИБ.ЗаполнениеДокументов.Заполнить(ДокументОбъект, Неопределено, Истина);
	ДокументОбъект.СчетКасса = ИБ.ПланыСчетов.Хозрасчетный.КассаОрганизации;
	ДокументОбъект.СуммаДокумента = СтруктураДокумента.СуммаДокумента;
	
	ДокументОбъект.ВалютаДокумента = ИБ.Константы.ВалютаРегламентированногоУчета.Получить(); 
	
	
	// Хахалин
	// Если в параметре "СтруктураДокумента" есть реквизит "ПерсонализироватьФЛ", то передадим его
	// в функцию поиска/создания контрагента. Если реквизит отсутствует, то передадим Ложь. Этот
	// реквизит влияет на персонализацию контрагентов - физических лиц (Истина - поиск/создание
	// выполняется по наименованию контрагента, Ложь - контрагент всегда "Частное лицо")
	//-------------------------------------------------------------------------------------------------
	Если (ЭтоОплатаПоДВОУ = Истина) Тогда
		Водитель = СтруктураДокумента.Основание.Водитель;
		ВодительИНН = ВРег(СокрЛП(СтруктураДокумента.Основание.ВодительИНН));
		ВодительСНИЛС = ВРег(СокрЛП(СтруктураДокумента.Основание.ВодительСНИЛС));
		ДокументОбъект.Контрагент = БПК3_ПолучитьФизЛицо(ИБ,ВодительСНИЛС,ВодительИНН,Водитель);
		
	Иначе
		ПерсДоступно = ?(СтруктураДокумента.Свойство("ПерсонализироватьФЛ") = Истина,СтруктураДокумента.ПерсонализироватьФЛ,Ложь);
		ДокументОбъект.Контрагент = БПК3_ПолучитьКонтрагента(ИБ,СтруктураДокумента.Контрагент,ПерсДоступно);
	КонецЕсли;
	
	Если ИБ.ЗначениеЗаполнено(ДокументОбъект.Контрагент)=Ложь Тогда
		Ответ.Результат = "Не найден контрагент "+СокрЛП(СтруктураДокумента.Контрагент)+" в бухгалтерской ИБ!";
		Возврат Ответ;
	КонецЕсли; 
	
	ДокументОбъект.РасшифровкаПлатежа.Очистить();
	нСтрока = ДокументОбъект.РасшифровкаПлатежа.Добавить();
	
	// Хахалин
	// Если в параметре "СтруктураДокумента" есть реквизит "УчетПоНомеруДоговора", то передадим его
	// в функцию поиска/создания договора. Если реквизит отсутствует, то передадим Ложь. Этот реквизит
	// говорит о том, что поиск договора контрагента должен выполняться по номеру договора, независимо
	// от того является контрагент физическим лицом или нет
	//-------------------------------------------------------------------------------------------------
	ДогНомерДоступно = ?(СтруктураДокумента.Свойство("УчетПоНомеруДоговора") = Истина,СтруктураДокумента.УчетПоНомеруДоговора,Ложь);
	
	СтруктураЭлемента = Новый Структура("Контрагент, Организация, ВидДоговора, НомерДоговора, ДатаДоговора, УИДДоговора");
	СтруктураЭлемента.Контрагент = ДокументОбъект.Контрагент;
	СтруктураЭлемента.Организация = ДокументОбъект.Организация;
	СтруктураЭлемента.ВидДоговора = ТекВидДоговора;
	СтруктураЭлемента.НомерДоговора = СтруктураДокумента.НомерДоговора;
	СтруктураЭлемента.ДатаДоговора = СтруктураДокумента.ДатаДоговора;
	СтруктураДокумента.Свойство("УИДДоговора", СтруктураЭлемента.УИДДоговора);
	
	нСтрока.ДоговорКонтрагента = БПК3_ПолучитьДоговорКонтрагента(ИБ,СтруктураЭлемента,ДокументОбъект.ПодразделениеОрганизации,ДогНомерДоступно);
	
	нСТрока.СпособПогашенияЗадолженности = ИБ.Перечисления.СпособыПогашенияЗадолженности.Автоматически;
	нСтрока.СуммаПлатежа = СтруктураДокумента.СуммаДокумента;
	нСтрока.КурсВзаиморасчетов = 1;
	нСтрока.СуммаВзаиморасчетов = СтруктураДокумента.СуммаДокумента;
	нСТрока.СуммаНДС = СуммаНДС;
	нСтрока.СтавкаНДС = СтавкаНДС;
	
	нСтрока.СтатьяДвиженияДенежныхСредств = ТекСтатьяДДС;
	
	// счета учета
	нСтрока.СчетУчетаРасчетовПоАвансам = ТекСчетРасчетовПоАвансам;
	нСтрока.СчетУчетаРасчетовСКонтрагентом = ТекСчетРасчетовПоКонтрагентам;
	
	ДокументОбъект.Ответственный = БПК3_ПолучитьПользователя(ИБ, СтруктураДокумента.Автор);
	
	ДокументОбъект.Выдать = СокрЛп(СтруктураДокумента.Выдать);
	ДокументОбъект.Основание = СокрЛп(СтруктураДокумента.Основание);
	ДокументОбъект.Приложение = СокрЛп(СтруктураДокумента.Приложение);
	ДокументОбъект.ПоДокументу = СокрЛп(СтруктураДокумента.ПоДокументу);
	
	ДокументОбъект.Комментарий = СтруктураДокумента.Комментарий;
	
	ДокументОбъект.УстановитьНовыйНомер();
	Попытка
		ДокументОбъект.Записать(ИБ.РежимЗаписиДокумента.Проведение);
		
		Ответ.НомерДокумента = СокрЛП(ДокументОбъект.Номер);
		Ответ.ИдентификаторДокумента = ИБ.XMLСтрока(ДокументОбъект.Ссылка);
		Ответ.Результат = "ОК";
	Исключение
		Попытка
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			РежимЗаписи = ИБ.РежимЗаписиДокумента.Запись;	
			ДокументОбъект.Записать(РежимЗаписи);
			
			Ответ.НомерДокумента = СокрЛП(ДокументОбъект.Номер);
			Ответ.ИдентификаторДокумента = ИБ.XMLСтрока(ДокументОбъект.Ссылка);
			Ответ.Результат = "ОК";
			
		Исключение	
			
			Ответ.НомерДокумента = Неопределено;
			Ответ.ИдентификаторДокумента = Неопределено;
			Ответ.Результат = "Ошибка проведения документа: "+ОписаниеОшибки();
		КонецПопытки;
	КонецПопытки;
	
	ИБ = Неопределено;
	
	Возврат Ответ;	
КонецФункции

Функция БПК3_СоздатьОплатуПлатежнойКартой(Организация,СтруктураДокумента,ЭтоВозврат=Ложь) Экспорт
	
	Ответ = Новый Структура("НомерДокумента, ИдентификаторДокумента, Результат");
	Ответ.НомерДокумента = Неопределено;
	Ответ.ИдентификаторДокумента = Неопределено;
	Ответ.Результат = Неопределено;
	
	Если Организация.ВыгружатьКассовыеДокументы=Ложь Тогда
		Возврат Ответ;		
	КонецЕсли; 
	
	ИБ = ПодключитьИнформационнуюБазу(Организация.ИнформационнаяБазаБухгалтерии);
	Если ИБ=Неопределено Тогда
		Ответ.Результат = "Ошибка подключения к бухгалтерской ИБ!";
		Возврат Ответ;
	КонецЕсли;
	
	ДокументОбъект = ИБ.Документы.ОплатаПлатежнойКартой.CreateDocument();
	
	ДокументОбъект.Дата = СтруктураДокумента.Дата;
	
	ДокументОбъект.Организация = ИБ.Справочники.Организации.НайтиПоРеквизиту("ИНН", Организация.ИНН);
	Если ИБ.ЗначениеЗаполнено(ДокументОбъект.Организация)=Ложь Тогда
		Ответ.Результат = "Не найдена организация "+СокрЛП(Организация)+" в бухгалтерской ИБ!";
		Возврат Ответ;
	КонецЕсли; 
	
	// Патент	
	//======================================================================================================================
	ПараметрыДеятельности = ИБ.УчетПСН.ДеятельностьНаПатентеПоУмолчанию(ДокументОбъект.Организация, ДокументОбъект.Дата);
	ИБ.ЗаполнитьЗначенияСвойств(ДокументОбъект, ПараметрыДеятельности);
	//======================================================================================================================
	
	ОбособленноеПодразделение = БПК3_ПолучитьОбособленноеПодразделение(ИБ, Организация, СтруктураДокумента.ТочкаОформления);
	Если ОбособленноеПодразделение<>Неопределено Тогда
		ДокументОбъект.ПодразделениеОрганизации = ОбособленноеПодразделение;
	КонецЕсли; 
	
	Если ИБ.УчетнаяПолитика.ПлательщикЕНВД(ДокументОбъект.Организация, ДокументОбъект.Дата) ИЛИ ИБ.УчетнаяПолитика.ПрименяетсяУСН(ДокументОбъект.Организация, ДокументОбъект.Дата) ИЛИ ИБ.УчетнаяПолитика.ПрименяетсяУСНПатент(ДокументОбъект.Организация, ДокументОбъект.Дата) Тогда
		СтавкаНДС = ИБ.Перечисления.СтавкиНДС.БезНДС;
		СуммаНДС = 0;
	Иначе
		СтруктураНДС = БПК3_ПолучитьАктуальнуюПолнуюСтавкуНДС(ИБ, ДокументОбъект.Дата);
		СтавкаНДС = СтруктураНДС.Ставка;
		СуммаНДС = Окр((СтруктураДокумента.СуммаДокумента*СтруктураНДС.Процент)/(100+СтруктураНДС.Процент),2,РежимОкругления.Окр15как10);
	КонецЕсли;	
	
	ДокументОбъект.ВалютаДокумента = ИБ.Константы.ВалютаРегламентированногоУчета.Получить();
	
	Если ЭтоВозврат Тогда
		ДокументОбъект.ВидОперации = ИБ.Перечисления.ВидыОперацийОплатаПлатежнойКартой.ВозвратПокупателю;
	Иначе
		ДокументОбъект.ВидОперации = ИБ.Перечисления.ВидыОперацийОплатаПлатежнойКартой.ОплатаПокупателя;
	КонецЕсли; 
	
	ДокументОбъект.СчетКасса = ИБ.ПланыСчетов.Хозрасчетный.ПродажиПоПлатежнымКартам;
	ДокументОбъект.СуммаДокумента = СтруктураДокумента.СуммаДокумента;
	
	// контрагент
	// Если в параметре "СтруктураДокумента" есть реквизит "ПерсонализироватьФЛ", то передадим его
	// в функцию поиска/создания контрагента. Если реквизит отсутствует, то передадим Ложь. Этот
	// реквизит влияет на персонализацию контрагентов - физических лиц (Истина - поиск/создание
	// выполняется по наименованию контрагента, Ложь - контрагент всегда "Частное лицо")
	
	ПерсДоступно = ?(СтруктураДокумента.Свойство("ПерсонализироватьФЛ") = Истина,СтруктураДокумента.ПерсонализироватьФЛ,Ложь);
	ДокументОбъект.Контрагент = БПК3_ПолучитьКонтрагента(ИБ,СтруктураДокумента.Контрагент,ПерсДоступно);
	
	Если ИБ.ЗначениеЗаполнено(ДокументОбъект.Контрагент)=Ложь Тогда
		Ответ.Результат = "Не найден контрагент "+СокрЛП(СтруктураДокумента.Контрагент)+" в бухгалтерской ИБ!";
		Возврат Ответ;
	КонецЕсли; 
	
	ИБ.ЗаполнениеДокументов.Заполнить(ДокументОбъект, Неопределено);
	
	ПараметрыУСН = ИБ.УчетУСН.СтруктураПараметровОбъектаДляУСН(ДокументОбъект);
	ИБ.НалоговыйУчетУСН.ЗаполнитьОтражениеДокументаВУСН(ДокументОбъект, ПараметрыУСН);
	
	ДокументОбъект.РасшифровкаПлатежа.Очистить();
	нСтрока = ДокументОбъект.РасшифровкаПлатежа.Добавить();
	
	СтруктураЭлемента = Новый Структура("Контрагент, Организация, ВидДоговора, НомерДоговора, ДатаДоговора, УИДДоговора");
	СтруктураЭлемента.Контрагент = ДокументОбъект.Контрагент;
	СтруктураЭлемента.Организация = ДокументОбъект.Организация;
	СтруктураЭлемента.ВидДоговора = ИБ.Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
	СтруктураЭлемента.НомерДоговора = СтруктураДокумента.НомерДоговора;
	СтруктураЭлемента.ДатаДоговора = СтруктураДокумента.ДатаДоговора;
	СтруктураДокумента.Свойство("УИДДоговора", СтруктураЭлемента.УИДДоговора);
	
	нСтрока.ДоговорКонтрагента = БПК3_ПолучитьДоговорКонтрагента(ИБ, СтруктураЭлемента, ДокументОбъект.ПодразделениеОрганизации);
	
	нСТрока.СпособПогашенияЗадолженности  = ИБ.Перечисления.СпособыПогашенияЗадолженности.Автоматически;
	нСтрока.СуммаПлатежа = СтруктураДокумента.СуммаДокумента;
	нСтрока.КурсВзаиморасчетов = 1;
	нСтрока.КратностьВзаиморасчетов = 1;
	нСтрока.СуммаПлатежа = СтруктураДокумента.СуммаДокумента;
	нСтрока.СуммаВзаиморасчетов = СтруктураДокумента.СуммаДокумента;
	нСТрока.СуммаНДС = СуммаНДС;
	нСтрока.СтавкаНДС = СтавкаНДС;
	
	// счета учета
	нСтрока.СчетУчетаРасчетовСКонтрагентом = ИБ.ПланыСчетов.Хозрасчетный.РасчетыСПокупателями;
	нСтрока.СчетУчетаРасчетовПоАвансам = ИБ.ПланыСчетов.Хозрасчетный.РасчетыПоАвансамПолученным;
	
	ДокументОбъект.Ответственный = БПК3_ПолучитьПользователя(ИБ, СтруктураДокумента.Автор);
	
	ДокументОбъект.Комментарий = СтруктураДокумента.Комментарий;
	
	// вид оплаты
	ВидОплаты = БПК3_ПолучитьВидОплаты(ИБ, Организация.ИНН, ОбособленноеПодразделение);
	Если ВидОплаты=Неопределено Тогда
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		РежимЗаписи = ИБ.РежимЗаписиДокумента.Запись;
	Иначе
		ДокументОбъект.ВидОплаты = ВидОплаты;
		ДокументОбъект.СчетКасса = ВидОплаты.СчетУчетаРасчетов;
		ДокументОбъект.Эквайер = ВидОплаты.Контрагент;
		ДокументОбъект.ДоговорЭквайринга = ВидОплаты.ДоговорКонтрагента;
		
		РежимЗаписи = ИБ.РежимЗаписиДокумента.Проведение;
	КонецЕсли; 
	
	ДокументОбъект.УстановитьНовыйНомер();
	Попытка
		ДокументОбъект.Записать(РежимЗаписи);
		
		Ответ.НомерДокумента = СокрЛП(ДокументОбъект.Номер);
		Ответ.ИдентификаторДокумента = ИБ.XMLСтрока(ДокументОбъект.Ссылка);
		Ответ.Результат = "ОК";
	Исключение
		Попытка
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			РежимЗаписи = ИБ.РежимЗаписиДокумента.Запись;	
			ДокументОбъект.Записать(РежимЗаписи);
			
			Ответ.НомерДокумента = СокрЛП(ДокументОбъект.Номер);
			Ответ.ИдентификаторДокумента = ИБ.XMLСтрока(ДокументОбъект.Ссылка);
			Ответ.Результат = "ОК";
			
		Исключение	
			Ответ.НомерДокумента = Неопределено;
			Ответ.ИдентификаторДокумента = Неопределено;
			Ответ.Результат = "Ошибка проведения документа: "+ОписаниеОшибки();
		КонецПопытки;
	КонецПопытки;
	
	ИБ = Неопределено;
	
	Возврат Ответ;	
КонецФункции

Функция БПК3_ПолучитьМассивБанковскихВыписок(Организация, ПараметрыОтбора, ПолучатьВсеВыписки=Истина) Экспорт 
	МассивБанковскихВыписок = Новый Массив;
	
	Если Организация.ЗагружатьБанковскиеВыписки=Ложь Тогда
		Возврат МассивБанковскихВыписок;		
	КонецЕсли; 
	
	ИБ = ПодключитьИнформационнуюБазу(Организация.ИнформационнаяБазаБухгалтерии);
	Если ИБ=Неопределено Тогда
		Сообщить("Ошибка подключения к бухгалтерской ИБ!");
		Возврат МассивБанковскихВыписок;
	КонецЕсли;
	
	// СписаниеСРасчетногоСчета - вид операции "Оплата поставщику"
	// ПоступлениеНаРасчетныйСчет - вид операции "Оплата от покупателя"
	Запрос = ИБ.NewObject("Запрос");
	Если ПараметрыОтбора.ЗагружатьСписания Тогда
		Запрос.Текст = Запрос.Текст+?(ПустаяСтрока(Запрос.Текст), "", " ОБЪЕДИНИТЬ ВСЕ ")+"
		|ВЫБРАТЬ 
		|	СчетОрганизации.НомерСчета КАК НомерСчета,
		|	ПРЕДСТАВЛЕНИЕ(СчетОрганизации.Банк) КАК Банк,
		|	НомерВходящегоДокумента,
		|	ДатаВходящегоДокумента,
		|	Контрагент.Наименование КАК КонтрагентНаименование,
		|	Контрагент.ИНН КАК КонтрагентИНН,
		|	Контрагент.КПП КАК КонтрагентКПП,
		|	СуммаДокумента,
		|	НазначениеПлатежа,
		|	ПРЕДСТАВЛЕНИЕ(Ссылка) КАК Документ,
		|	Ссылка,
		|	Дата КАК Дата,
		|	ПРЕДСТАВЛЕНИЕ(СтатьяДвиженияДенежныхСредств) КАК СтатьяДвиженияДенежныхСредств,
		|	ПРЕДСТАВЛЕНИЕ(ВидОперации) КАК ВидОперации,
		|	""Списание"" КАК ВидДвиженияДС,
		|	ПодразделениеОрганизации КАК ПодразделениеОрганизации,
		|	ДоговорКонтрагента.Номер КАК ДоговорНомер,
		|	ДоговорКонтрагента.Дата КАК ДоговорДата
		|ИЗ Документ.СписаниеСРасчетногоСчета
		|ГДЕ Дата МЕЖДУ НАЧАЛОПЕРИОДА(&начДата, ДЕНЬ) И КОНЕЦПЕРИОДА(&конДата, ДЕНЬ)
		|	И (ВидОперации=ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСписаниеДенежныхСредств.ОплатаПоставщику) ИЛИ ВидОперации=ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСписаниеДенежныхСредств.ВозвратПокупателю))
		|	И Организация.ИНН=&ИНН
		|";
	КонецЕсли;
	Если ПараметрыОтбора.ЗагружатьПоступления Тогда
		Запрос.Текст = Запрос.Текст+?(ПустаяСтрока(Запрос.Текст), "", " ОБЪЕДИНИТЬ ВСЕ ")+"
		|ВЫБРАТЬ 
		|	СчетОрганизации.НомерСчета КАК НомерСчета,
		|	ПРЕДСТАВЛЕНИЕ(СчетОрганизации.Банк) КАК Банк,
		|	НомерВходящегоДокумента,
		|	ДатаВходящегоДокумента,
		|	Контрагент.Наименование КАК КонтрагентНаименование,
		|	Контрагент.ИНН,
		|	Контрагент.КПП,
		|	СуммаДокумента,
		|	НазначениеПлатежа,
		|	ПРЕДСТАВЛЕНИЕ(Ссылка) КАК Документ,
		|	Ссылка,
		|	Дата КАК Дата,
		|	ПРЕДСТАВЛЕНИЕ(СтатьяДвиженияДенежныхСредств) КАК СтатьяДвиженияДенежныхСредств,
		|	ПРЕДСТАВЛЕНИЕ(Ссылка.ВидОперации) КАК ВидОперации,
		|	""Поступление"" КАК ВидДвиженияДС,
		|	ПодразделениеОрганизации КАК ПодразделениеОрганизации,
		|	ДоговорКонтрагента.Номер КАК ДоговорНомер,
		|	ДоговорКонтрагента.Дата КАК ДоговорДата
		|ИЗ Документ.ПоступлениеНаРасчетныйСчет
		|ГДЕ Дата МЕЖДУ НАЧАЛОПЕРИОДА(&начДата, ДЕНЬ) И КОНЕЦПЕРИОДА(&конДата, ДЕНЬ)
		|	И (ВидОперации=ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоступлениеДенежныхСредств.ОплатаПокупателя) ИЛИ ВидОперации=ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоступлениеДенежныхСредств.ВозвратОтПоставщика))	
		|	И Организация.ИНН=&ИНН
		|";
	КонецЕсли;
	
	Если ПустаяСтрока(Запрос.Текст) Тогда
		Возврат МассивБанковскихВыписок;		
	КонецЕсли; 
	
	Запрос.УстановитьПараметр("начДата", ПараметрыОтбора.начДата);		
	Запрос.УстановитьПараметр("конДата", ПараметрыОтбора.конДата);		
	Запрос.УстановитьПараметр("ИНН", СокрЛП(Организация.ИНН));		
	
	Если ЗначениеЗаполнено(ПараметрыОтбора.БанковскийСчет) Тогда
		Запрос.Текст = Запрос.Текст+"
		|	И СчетОрганизации.НомерСчета=&НомерСчета";
		Запрос.УстановитьПараметр("НомерСчета", ПараметрыОтбора.БанковскийСчет.РасчСчет);		
	КонецЕсли;
	Если ПараметрыОтбора.МассивКонтрагентов.Количество()>0 Тогда
		Запрос.Текст = Запрос.Текст+"
		|	И Контрагент.ИНН В (&МассивИНН)
		|	И НЕ Контрагент.ИНН=""""";
		
		МассивИНН = ИБ.NewObject("Массив");
		Для каждого текЭлемент Из ПараметрыОтбора.МассивКонтрагентов Цикл
			Если ЗначениеЗаполнено(текЭлемент.ИНН) Тогда
				МассивИНН.Добавить(СокрЛП(текЭлемент.ИНН));
			КонецЕсли; 
		КонецЦикла; 
		Запрос.УстановитьПараметр("МассивИНН", МассивИНН);		
	КонецЕсли; 
	
	МассивИдентификаторов = Новый Массив;
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		нСтрока = Новый Структура("Дата, Банк, НомерСчета, ВидДвиженияДС, ИдентификаторДокумента, НомерВходящегоДокумента, ДатаВходящегоДокумента, НазначениеПлатежа, СуммаДокумента, КонтрагентКПП, КонтрагентНаименование, КонтрагентИНН, Документ, СтатьяДвиженияДенежныхСредств, ВидОперации, ДоговорНомер, ДоговорДата");	
		
		ЗаполнитьЗначенияСвойств(нСтрока, Выборка);
		нСтрока.ИдентификаторДокумента = ИБ.XMLСтрока(Выборка.Ссылка);
		
		МассивИдентификаторов.Добавить(нСтрока.ИдентификаторДокумента);
		МассивБанковскихВыписок.Добавить(нСтрока);
	КонецЦикла;
	
	Если ПолучатьВсеВыписки=Ложь И МассивИдентификаторов.Количество()>0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Выписка.ВнешнийИдентификатор
		|ИЗ
		|	Документ.ДвижениеПоРасчетномуСчету КАК Выписка
		|ГДЕ
		|	Выписка.ВнешнийИдентификатор В(&МассивИдентификаторов)";
		Запрос.УстановитьПараметр("МассивИдентификаторов", МассивИдентификаторов);
		РезультатЗапроса = Запрос.Выполнить();
		
		НайденныеИдентификаторы = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ВнешнийИдентификатор");
		
		РезультирующийМассив = Новый Массив;
		Для каждого текСтрока Из МассивБанковскихВыписок Цикл
			Если НайденныеИдентификаторы.Найти(текСтрока.ИдентификаторДокумента)=Неопределено Тогда
				РезультирующийМассив.Добавить(текСтрока);
			КонецЕсли; 
		КонецЦикла; 
	Иначе
		РезультирующийМассив = МассивБанковскихВыписок;		
	КонецЕсли; 
	
	Возврат РезультирующийМассив;
КонецФункции

Функция БПК3_ОтменитьДокумент(Организация, Идентификатор, ТипДокумента) Экспорт
	Результат = "ОК";
	
	Если (ЗначениеЗаполнено(Идентификатор)=Ложь) 
		ИЛИ (ЗначениеЗаполнено(Организация.ИнформационнаяБазаБухгалтерии)=Ложь) 
		ИЛИ (Организация.ВыгружатьКассовыеДокументы=Ложь) Тогда
		
		Возврат Результат;
	КонецЕсли; 
	
	ИБ = ПодключитьИнформационнуюБазу(Организация.ИнформационнаяБазаБухгалтерии);
	Если ИБ=Неопределено Тогда
		Результат = "Ошибка подключения к бухгалтерской ИБ!";
		Возврат Результат;
	КонецЕсли;
	
	Если ИБ.Метаданные.Документы.Найти(СокрЛП(ТипДокумента))=Неопределено Тогда
		Результат = "Ошибочный тип документа "+СокрЛП(ТипДокумента);
		Возврат Результат;
	КонецЕсли; 
	
	ид = ИБ.NewObject("УникальныйИдентификатор", СокрЛП(Идентификатор));
	ДокументСсылка = ИБ.Документы[СокрЛП(ТипДокумента)].ПолучитьСсылку(ид);
	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	Если ДокументОбъект=Неопределено Тогда
		Результат = "Не найден документ "+СокрЛП(ТипДокумента)+" по ид "+СокрЛП(Идентификатор);
		Возврат Результат;
	КонецЕсли; 
	
	// добавим букву У к префиксу
	СтрокаЧисел = "0123456789";
	Префикс = "";
	ЧисловаяЧасть = "";
	ЭтоПрефикс = Ложь;
	
	сч = СтрДлина(ДокументОбъект.Номер);
	Пока сч>0 Цикл
		Символ = Сред(ДокументОбъект.Номер, сч, 1);
		Если ЭтоПрефикс=Ложь И СтрНайти(СтрокаЧисел, Символ)=0 Тогда
			ЭтоПрефикс=Истина;
		КонецЕсли; 
		
		Если ЭтоПрефикс Тогда
			Префикс = Символ+Префикс;
		Иначе
			ЧисловаяЧасть = Символ+ЧисловаяЧасть;			
		КонецЕсли;
		
		сч = сч-1;
	КонецЦикла; 
	
	Префикс = "У"+Префикс;
	
	ДокументОбъект.Номер = Префикс+Сред(ЧисловаяЧасть, 2);
	Попытка
		ДокументОбъект.Записать(ИБ.РежимЗаписиДокумента.ОтменаПроведения);
		ДокументОбъект.УстановитьПометкуУдаления(Истина);
	Исключение
		Результат = "Ошибка записи документа: "+ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;	
КонецФункции

Функция БПК3_ЗагрузитьДанныеФинансовыйРезультат(Организация, Знач НачалоПериода, Знач ОкончаниеПериода) Экспорт
	Результат = "";
	
	Доступно = (ТипЗнч(Организация)=Тип("СправочникСсылка.Контрагенты"));
	Доступно = Доступно И (ЗначениеЗаполнено(Организация.ИнформационнаяБазаБухгалтерии)=Истина);
	Доступно = Доступно И (ЗначениеЗаполнено(НачалоПериода)=Истина);
	Доступно = Доступно И (ЗначениеЗаполнено(ОкончаниеПериода)=Истина);
	Доступно = Доступно И (НачалоПериода<=ОкончаниеПериода);
	
	Если Доступно=Ложь Тогда
		Возврат Результат;		
	КонецЕсли; 
	
	НачалоПериода = НачалоМесяца(НачалоПериода);
	ОкончаниеПериода = КонецМесяца(ОкончаниеПериода);
	
	ИБ = ПодключитьИнформационнуюБазу(Организация.ИнформационнаяБазаБухгалтерии);
	Если ИБ=Неопределено Тогда
		Результат = "Ошибка подключения к бухгалтерской ИБ!";
		Возврат Результат;
	КонецЕсли;
	
	ОтборПодразделений = ИБ.NewObject("Массив");
	ОтборСтатейДДС = ИБ.NewObject("Массив");
	
	СоответствиеПодразделений = Новый Соответствие;
	СоответствиеСтатейБюджета = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СоответствиеПодразделений.ПодразделениеИдентификатор КАК ПодразделениеИдентификатор,
	|	СоответствиеПодразделений.ТочкаОформления КАК ТочкаОформления
	|ИЗ
	|	РегистрСведений.СоответствиеПодразделений КАК СоответствиеПодразделений
	|ГДЕ
	|	СоответствиеПодразделений.Организация = &Организация";
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СоответствиеПодразделений.Вставить(Выборка.ПодразделениеИдентификатор, Выборка.ТочкаОформления);
		
		ид = ИБ.NewObject("УникальныйИдентификатор", СокрЛП(Выборка.ПодразделениеИдентификатор));
		Спр = ИБ.Справочники.ПодразделенияОрганизаций.ПолучитьСсылку(ид);
		СпрОбъект = Спр.ПолучитьОбъект();
		Если СпрОбъект<>Неопределено Тогда
			ОтборПодразделений.Добавить(Спр);
		КонецЕсли;
	КонецЦикла;  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
