	|			ИЛИ &ОрганизацияПолучатель = НЕОПРЕДЕЛЕНО)
	|	И ВЫБОР
	|			КОГДА НЕ Продажи.Партия.Комментарий ПОДОБНО &Производство
	|				ТОГДА Продажи.Партия.Организация <> Продажи.Поставщик
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ТИПЗНАЧЕНИЯ(Продажи.Регистратор) <> ТИП(Документ.ОтчетКомиссионера)
	|	И НЕ Продажи.Регистратор ССЫЛКА Документ.ОтчетКомиссионера
	|
	|СГРУППИРОВАТЬ ПО
	|	Продажи.ТочкаОформления,
	|	Продажи.Товар,
	|	Продажи.Партия.Организация,
	|	Продажи.Поставщик,
	|	НАЧАЛОПЕРИОДА(Продажи.Период, ДЕНЬ),
	|	Продажи.Регистратор,
	|	Продажи.Партия,
	|	ВЫБОР
	|		КОГДА Продажи.Партия.Комментарий ПОДОБНО &Производство
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	Продажи.СтавкаНДС,
	|	ВЫБОР
	|		КОГДА НЕ Продажи.ДоговорВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ДоговорыВзаиморасчетов.ПустаяСсылка)
	|			ТОГДА Продажи.ДоговорВзаиморасчетов.ИдентификаторГосударственногоКонтракта
	|		ИНАЧЕ """"
	|	КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТоварыПроизводство.Основание.ТочкаОформления,
	|	ТоварыПроизводство.Номенклатура,
	|	ТоварыПроизводство.Партия.Организация,
	|	ТоварыПроизводство.Основание.Организация,
	|	НАЧАЛОПЕРИОДА(ТоварыПроизводство.Период, ДЕНЬ),
	|	ТоварыПроизводство.Регистратор,
	|	ТоварыПроизводство.Партия,
	|	ВЫБОР
	|		КОГДА ТоварыПроизводство.Партия.Комментарий ПОДОБНО &Производство
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	ТоварыПроизводство.Основание.СтавкаНДС,
	|	СУММА(ТоварыПроизводство.Количество),
	|	СУММА(ТоварыПроизводство.СуммаСебестоимость),
	|	ВЫБОР
	|		КОГДА НЕ ТоварыПроизводство.Основание.ДоговорВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ДоговорыВзаиморасчетов.ПустаяСсылка)
	|			ТОГДА ТоварыПроизводство.Основание.ДоговорВзаиморасчетов.ИдентификаторГосударственногоКонтракта
	|		ИНАЧЕ """"
	|	КОНЕЦ
	|ИЗ
	|	РегистрНакопления.ТоварыПроизводство КАК ТоварыПроизводство
	|ГДЕ
	|	ТоварыПроизводство.Период МЕЖДУ НАЧАЛОПЕРИОДА(&НачалоПериода, ДЕНЬ) И КОНЕЦПЕРИОДА(&ОкончаниеПериода, ДЕНЬ)
	|	И ТоварыПроизводство.Номенклатура ССЫЛКА Справочник.Номенклатура
	|	И (ТоварыПроизводство.Основание.Организация.ИНН = &ОрганизацияПолучатель
	|			ИЛИ &ОрганизацияПолучатель = НЕОПРЕДЕЛЕНО)
	|	И ВЫБОР
	|			КОГДА НЕ ТоварыПроизводство.Партия.Комментарий ПОДОБНО &Производство
	|				ТОГДА ТоварыПроизводство.Партия.Организация <> ТоварыПроизводство.Основание.Организация
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ТоварыПроизводство.Регистратор ССЫЛКА Документ.ЗаказНаряд
	|	И ТоварыПроизводство.Основание.Организация = ТоварыПроизводство.Основание.Контрагент
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыПроизводство.Основание.ТочкаОформления,
	|	ТоварыПроизводство.Номенклатура,
	|	ТоварыПроизводство.Партия.Организация,
	|	ТоварыПроизводство.Основание.Организация,
	|	НАЧАЛОПЕРИОДА(ТоварыПроизводство.Период, ДЕНЬ),
	|	ТоварыПроизводство.Регистратор,
	|	ТоварыПроизводство.Партия,
	|	ВЫБОР
	|		КОГДА ТоварыПроизводство.Партия.Комментарий ПОДОБНО &Производство
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	ТоварыПроизводство.Основание.СтавкаНДС,
	|	ВЫБОР
	|		КОГДА НЕ ТоварыПроизводство.Основание.ДоговорВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ДоговорыВзаиморасчетов.ПустаяСсылка)
	|			ТОГДА ТоварыПроизводство.Основание.ДоговорВзаиморасчетов.ИдентификаторГосударственногоКонтракта
	|		ИНАЧЕ """"
	|	КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОстаткиТоваровКомпании.СкладКомпании.ТочкаОформления,
	|	ОстаткиТоваровКомпании.Номенклатура,
	|	ОстаткиТоваровКомпании.Партия.Организация,
	|	ОстаткиТоваровКомпании.Регистратор.Организация,
	|	НАЧАЛОПЕРИОДА(ОстаткиТоваровКомпании.Период, ДЕНЬ),
	|	ОстаткиТоваровКомпании.Регистратор,
	|	ОстаткиТоваровКомпании.Партия,
	|	ЛОЖЬ,
	|	НЕОПРЕДЕЛЕНО,
	|	ОстаткиТоваровКомпании.Количество,
	|	ОстаткиТоваровКомпании.СуммаСебестоимость,
	|	""""
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваровКомпании КАК ОстаткиТоваровКомпании
	|ГДЕ
	|	ОстаткиТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И ОстаткиТоваровКомпании.Регистратор В(&МассивДокументовСписанияТоваров)
	|	И ОстаткиТоваровКомпании.Партия.Организация <> ОстаткиТоваровКомпании.Регистратор.Организация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТоварыПереданныеНаКомиссию.ТочкаОформления,
	|	ТоварыПереданныеНаКомиссию.Номенклатура,
	|	ТоварыПереданныеНаКомиссию.Партия.Организация,
	|	ТоварыПереданныеНаКомиссию.Регистратор.Организация,
	|	НАЧАЛОПЕРИОДА(ТоварыПереданныеНаКомиссию.Период, ДЕНЬ),
	|	ТоварыПереданныеНаКомиссию.Регистратор,
	|	ТоварыПереданныеНаКомиссию.Партия,
	|	ЛОЖЬ,
	|	НЕОПРЕДЕЛЕНО,
	|	ТоварыПереданныеНаКомиссию.Количество,
	|	ТоварыПереданныеНаКомиссию.СуммаСебестоимости,
	|	""""
	|ИЗ
	|	РегистрНакопления.ТоварыПереданныеНаКомиссию КАК ТоварыПереданныеНаКомиссию
	|ГДЕ
	|	ТоварыПереданныеНаКомиссию.Период МЕЖДУ НАЧАЛОПЕРИОДА(&НачалоПериода, ДЕНЬ) И КОНЕЦПЕРИОДА(&ОкончаниеПериода, ДЕНЬ)
	|	И ТоварыПереданныеНаКомиссию.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И ТоварыПереданныеНаКомиссию.Партия.Организация <> ТоварыПереданныеНаКомиссию.Регистратор.Организация
	|	И ТоварыПереданныеНаКомиссию.Организация.ИНН = &ОрганизацияПолучатель";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ОкончаниеПериода);
	Запрос.УстановитьПараметр("Производство", "##ПРОИЗВОДСТВО%");
	Запрос.УстановитьПараметр("ОрганизацияПолучатель", ?(ЗначениеЗаполнено(ОрганизацияИНН)=Истина, ОрганизацияИНН, Неопределено)); 
	
	Запрос.УстановитьПараметр("МассивДокументовСписанияТоваров", МассивДокументовСписанияТоваров);
	//	Запрос.УстановитьПараметр("МассивДокументовПередачиНаКомиссию", МассивДокументовПередачиНаКомиссию);
	
	ТаблицаДвижений = Запрос.Выполнить().Выгрузить();
	
	ТаблицаДвижений.Свернуть("ТочкаОформления, Номенклатура, ОрганизацияОтправитель, ОрганизацияПолучатель, ДатаДокумента, Регистратор, СтавкаНДС, ИГК,Производство", "КоличествоРасход, СебестоимостьРасход");  
	
	Для каждого текСтрока Из ТаблицаДвижений Цикл
		СтрокаДвижения = Новый Структура;
		
		СтрокаДвижения.Вставить("ТочкаОформления", СокрЛП(текСтрока.ТочкаОформления));
		СтрокаДвижения.Вставить("ТочкаОформленияУИД", СокрЛП(текСтрока.ТочкаОформления.УникальныйИдентификатор()));
		СтрокаДвижения.Вставить("ИГК", СокрЛП(текСтрока.ИГК));
		СтрокаДвижения.Вставить("Производство", текСтрока.Производство);
		Если текСтрока.ОрганизацияОтправитель = null тогда 
			продолжить
		Иначе	
			СтрокаДвижения.Вставить("ОрганизацияОтправитель", СокрЛП(текСтрока.ОрганизацияОтправитель));
			СтрокаДвижения.Вставить("ОрганизацияОтправительИНН", текСтрока.ОрганизацияОтправитель.ИНН);
			СтрокаДвижения.Вставить("ОрганизацияОтправительКПП", текСтрока.ОрганизацияОтправитель.КПП);
		КонецЕсли;
		
		СтрокаДвижения.Вставить("ОрганизацияПолучатель", СокрЛП(текСтрока.ОрганизацияПолучатель));
		СтрокаДвижения.Вставить("ОрганизацияПолучательИНН", текСтрока.ОрганизацияПолучатель.ИНН);
		СтрокаДвижения.Вставить("ОрганизацияПолучательКПП", текСтрока.ОрганизацияПолучатель.КПП);
		
		СтрокаДвижения.Вставить("Номенклатура", СокрЛП(текСтрока.Номенклатура));
		СтрокаДвижения.Вставить("НоменклатураУИД", СокрЛП(текСтрока.Номенклатура.УникальныйИдентификатор()));	
		
		СтрокаДвижения.Вставить("ДатаДокумента", текСтрока.ДатаДокумента);
		
		СтрокаДвижения.Вставить("КоличествоРасход", текСтрока.КоличествоРасход);
		СтрокаДвижения.Вставить("СебестоимостьРасход", текСтрока.СебестоимостьРасход);
		
		СтрокаДвижения.Вставить("Регистратор", СокрЛП(текСтрока.Регистратор));
		СтрокаДвижения.Вставить("РегистраторУИД", СокрЛП(текСтрока.Регистратор.УникальныйИдентификатор()));	
		
		Если ЗначениеЗаполнено(текСтрока.СтавкаНДС)=Истина Тогда
			СтавкаНДС = текСтрока.СтавкаНДС;	
		Иначе
			Если ЗначенияСервера.БезНДС(текСтрока.ОрганизацияПолучатель,,текСтрока.ДатаДокумента,текСтрока.ТочкаОформления)=Истина Тогда
				СтавкаНДС =Справочники.СтавкиНДС.БезНДС;
			Иначе
				СтавкаНДС = ЗначенияСервера.НоменклатураПолучитьСтавкуНДС(текСтрока.Номенклатура, текСтрока.ДатаДокумента);
			КонецЕсли; 
		КонецЕсли; 
		
		СтрокаДвижения.Вставить("СтавкаНДС", СтавкаНДС.Ставка);
		СтрокаДвижения.Вставить("ПредставлениеНДС", ?(СтавкаНДС.Предопределенный=Истина, Справочники.СтавкиНДС.ПолучитьИмяПредопределенного(СтавкаНДС), СокрЛП(СтавкаНДС)));
		СтрокаДвижения.Вставить("БезНДС", (СтавкаНДС=Справочники.СтавкиНДС.БезНДС));
		
		МассивМежхолдерныхДвижений.Добавить(СтрокаДвижения);
		
		Если НоменклатураДляВыгрузки.НайтиПоЗначению(текСтрока.Номенклатура)=Неопределено Тогда
			НоменклатураДляВыгрузки.Добавить(текСтрока.Номенклатура);						
		КонецЕсли; 
	КонецЦикла; 
	
	Если МассивМежхолдерныхДвижений.Количество()>0 Тогда
		ДеревоДокументов.Вставить("МежхолдерныеДвижения", МассивМежхолдерныхДвижений);
	КонецЕсли;
	
	// Номенклатура
	//-------------------------------------------------------------------------------------------------
	МассивНоменклатуры = Новый Массив;
	
	НоменклатураДляВыгрузки.СортироватьПоЗначению();
	Для каждого текЭлемент Из НоменклатураДляВыгрузки Цикл
		СтрокаНоменклатуры = Новый Структура("ИД, КодОбмена, КодОбменаУИД, Наименование, КодЕдиницыИзмерения, НаименованиеПолное, Артикул, Штрихкод, НоменклатурнаяГруппа,Прослеживаемость,ТНВЭД");
		
		Если типЗнч(текЭлемент.Значение)=Тип("СправочникСсылка.Материалы") Тогда
			СтрокаНоменклатуры.ИД = СокрЛП(текЭлемент.Значение.УникальныйИдентификатор());
			СтрокаНоменклатуры.КодОбменаУИД = Ложь;
			СтрокаНоменклатуры.КодОбмена = "";
			СтрокаНоменклатуры.Наименование = СокрЛП(текЭлемент.Значение.Наименование);
			СтрокаНоменклатуры.КодЕдиницыИзмерения = текЭлемент.Значение.ЕдиницаИзмерения.Код;
			СтрокаНоменклатуры.НаименованиеПолное = СокрЛП(текЭлемент.Значение.Наименование);
			СтрокаНоменклатуры.Артикул = "";
			СтрокаНоменклатуры.Штрихкод = ""; 
			СтрокаНоменклатуры.НоменклатурнаяГруппа = "";	
			СтрокаНоменклатуры.Прослеживаемость = "";	
			СтрокаНоменклатуры.ТНВЭД = "";	
		Иначе
			СтрокаНоменклатуры.ИД = СокрЛП(текЭлемент.Значение.УникальныйИдентификатор());
			СтрокаНоменклатуры.КодОбменаУИД = Ложь;
			СтрокаНоменклатуры.КодОбмена = ПолучитьКодОбмена(текЭлемент.Значение, КлючКодаОбмена, СтрокаНоменклатуры.КодОбменаУИД);
			СтрокаНоменклатуры.Наименование = СокрЛП(текЭлемент.Значение.Наименование);
			СтрокаНоменклатуры.КодЕдиницыИзмерения = текЭлемент.Значение.ЕдиницаИзмерения.Код;
			СтрокаНоменклатуры.НаименованиеПолное = СокрЛП(текЭлемент.Значение.НаименованиеПолное);
			СтрокаНоменклатуры.Артикул = СокрЛП(текЭлемент.Значение.Артикул);
			СтрокаНоменклатуры.Штрихкод = СокрЛП(текЭлемент.Значение.ШтрихКод);          
			СтрокаНоменклатуры.Прослеживаемость = ТекЭлемент.Значение.РНПТ;	   
			Если ЗначениеЗаполнено(ТекЭлемент.Значение.ТНВЭД) Тогда
				СтрокаНоменклатуры.ТНВЭД = ТекЭлемент.Значение.ТНВЭД.КодТНВЭД;	
			Иначе	
				СтрокаНоменклатуры.ТНВЭД = "";	
			КонецЕсли;	
			
			Если ЗначениеЗаполнено(текЭлемент.Значение.НоменклатурнаяГруппа)=Истина Тогда 
				СтрокаНоменклатуры.НоменклатурнаяГруппа = ?(ЗначениеЗаполнено(текЭлемент.Значение.НоменклатурнаяГруппа.ИмяПредопределенныхДанных)=Истина, СокрЛП(текЭлемент.Значение.НоменклатурнаяГруппа.ИмяПредопределенныхДанных), СокрЛП(текЭлемент.Значение.НоменклатурнаяГруппа));	
			Иначе
				СтрокаНоменклатуры.НоменклатурнаяГруппа = "";	
			КонецЕсли;
		КонецЕсли; 
		
		МассивНоменклатуры.Добавить(СтрокаНоменклатуры);
	КонецЦикла; 
	
	Если МассивНоменклатуры.Количество()>0 Тогда
		ДеревоДокументов.Вставить("Номенклатура", МассивНоменклатуры);
	КонецЕсли; 
	
	// Контрагенты  (для Гаранта)
	//-------------------------------------------------------------------------------------------------
	
	МассивКонтрагентов = Новый Массив;
	КонтрагентыДляВыгрузки.СортироватьПоЗначению(); 
	
	Если КлючКодаОбмена = "GARANT_T" Тогда
		КлючКодаОбмена = "GARANT_K"
	КонецЕсли;
	
	Для каждого текЭлемент Из КонтрагентыДляВыгрузки Цикл
		СтрокаКонтрагент = Новый Структура("ИД, КодОбмена, КодОбменаУИД, Наименование,ИНН,КПП");  
		
		СтрокаКонтрагент.ИД = СокрЛП(текЭлемент.Значение.УникальныйИдентификатор());
		СтрокаКонтрагент.КодОбменаУИД = Ложь;
		СтрокаКонтрагент.КодОбмена = ПолучитьКодОбмена(текЭлемент.Значение, КлючКодаОбмена, СтрокаКонтрагент.КодОбменаУИД);
		СтрокаКонтрагент.Наименование = СокрЛП(текЭлемент.Значение.Наименование);
		СтрокаКонтрагент.ИНН = СокрЛП(текЭлемент.Значение.ИНН);
		СтрокаКонтрагент.КПП = СокрЛП(текЭлемент.Значение.КПП);
		
		МассивКонтрагентов.Добавить(СтрокаКонтрагент);
	КонецЦикла; 
	
	Если МассивКонтрагентов.Количество()>0 Тогда
		ДеревоДокументов.Вставить("Контрагенты", МассивКонтрагентов);
	КонецЕсли; 
	
	Возврат ДеревоДокументов;	
КонецФункции


