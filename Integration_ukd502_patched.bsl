//=================================================================================================

Процедура ШинаДанныхОбработкаСообщений() Экспорт





КонецПроцедуры 

Процедура АгрегаторОбработкаСообщений() Экспорт
	
	// Процедура опрашивает очередь сообщений, которая отвечает за документооборот с Агрегатором ОИТ
	// В зависимости от полученного сообщения вызывает связанную процедуру обработки этого сообщения
	//-------------------------------------------------------------------------------------------------
	СтрОчередь = "MatrixAgregator";
	СтрМетка = "Регистрация пропущенный звонок";
	МассивСообщений = Взаимодействие.ОчередьСообщенияПолучить(СтрОчередь,СтрМетка);
	
	Для Каждого ТекСтрока Из МассивСообщений Цикл
		Справочники.Звонки.ЗаявкаНоваяСоздать(ТекСтрока.Сообщение);
	КонецЦикла;
КонецПроцедуры

Процедура JivositeОбработкаСообщений() Экспорт	
	//Процедура получает сообщения из очереди "MatrixJivosite" и меткой "Регистрация чата"
	// и записывает их в справочник JivositeОбсуждения     
	
	МассивСообщений = Взаимодействие.ОчередьСообщенияПолучить("MatrixJivosite", "Регистрация чата");
	Для Каждого i Из МассивСообщений Цикл
		JivositeОбработкаСообщения(i.Сообщение);		
	КонецЦикла;
КонецПроцедуры  

Процедура JivositeОбработкаСообщения(Сообщение) Экспорт
	
		//Найди сотрудника по email
		Чт = Новый ЧтениеXML();
		Чт.УстановитьСтроку(Сообщение);
		ТекСтрока = ФабрикаXDTO.ПрочитатьXML(Чт);
		Если Не ЗначениеЗаполнено(ТекСтрока.ЭлПочтаОператора) Тогда
			ЗаписьЖурналаРегистрации("JivositeОбработкаСообщения", УровеньЖурналаРегистрации.Ошибка,, Сообщение, "Не указан email сотрудника");
			Возврат;
		КонецЕсли;  
		
		sql = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Сотрудники ГДЕ ЭлектроннаяПочта ПОДОБНО &ЭлектроннаяПочта";
		Сотр = ОбщНазн.ЗапросВыполнитьНаЗначение(sql, Новый Структура("ЭлектроннаяПочта", "%"+ТекСтрока.ЭлПочтаОператора+"%"));
		
		Если Сотр = Неопределено Тогда
			sql 	= "ВЫБРАТЬ ПЕРВЫЕ 1 Сотрудник ИЗ РегистрСведений.ЗначенияСвойствСотрудников.СрезПоследних ГДЕ Свойство = &Свойство И Значение = &Значение "; 
			Парам 	= Новый Структура("Свойство, Значение", Справочники.ЗначенияСвойствОбъектов.Сотрудники_ДопАдресЭлПочтыДляJivosite1, ТекСтрока.ЭлПочтаОператора);
			Сотр 	= ОбщНазн.ЗапросВыполнитьНаЗначение(sql, Парам);
		КонецЕсли;
		
		Если Сотр = Неопределено Тогда
			sql		= "ВЫБРАТЬ ПЕРВЫЕ 1 Сотрудник ИЗ РегистрСведений.ЗначенияСвойствСотрудников.СрезПоследних ГДЕ Свойство = &Свойство И Значение = &Значение "; 
			Парам 	= Новый Структура("Свойство, Значение", Справочники.ЗначенияСвойствОбъектов.Сотрудники_ДопАдресЭлПочтыДляJivosite2, ТекСтрока.ЭлПочтаОператора);
			Сотр 	= ОбщНазн.ЗапросВыполнитьНаЗначение(sql, Парам); 
		КонецЕсли;  
		
		Если Сотр = Неопределено Тогда
			ЗаписьЖурналаРегистрации("JivositeОбработкаСообщения", УровеньЖурналаРегистрации.Предупреждение,, Сообщение, "Не найден сотрудник по email "+ТекСтрока.ЭлПочтаОператора);
		КонецЕсли;  

		Сотр = ?(Сотр = Неопределено, Справочники.Сотрудники.ПустаяСсылка(), Сотр);
			
		//Запиши обсуждение
		Зап = Справочники.JivositeОбсуждения.НайтиПоКоду(ТекСтрока.ЧатИд);
		Если Зап <> Справочники.JivositeОбсуждения.ПустаяСсылка() Тогда
			Возврат;
		КонецЕсли;
		
		Зап = Справочники.JivositeОбсуждения.СоздатьЭлемент();		
		Зап.Код				= ТекСтрока.ЧатИд;
		Зап.Наименование	= "Чат  от "+Формат(Дата(ТекСтрока.Дата), "ДФ='dd.MM.yyyy HH:mm'")+" ("+ТекСтрока.ЧатИд+")"; 
		Зап.Дата		 	= ТекСтрока.Дата;
		Зап.Содержание		= ТекСтрока.Сообщения;
		Зап.Сотрудник		= Сотр;
		Зап.ОбработкаПлан	= ТекСтрока.Дата + 3600;
		Зап.Состояние 		= Справочники.СтатусыОбъектов.ОбщийНовый;
		Попытка
			Зап.Записать();
		Исключение
			ЗаписьЖурналаРегистрации("JivositeОбработкаСообщения", УровеньЖурналаРегистрации.Ошибка,, ТекСтрока, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	
		КонецПопытки	

КонецПроцедуры 


