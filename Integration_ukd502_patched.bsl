			КонецЕсли;
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Товар
	КонецЦикла;
	
    ЗаписьXML.ЗаписатьКонецЭлемента(); // Запасы
    ЗаписьXML.Закрыть();

	Сообщить("Время выгрузки в секундах : "+строка(ТекущаяДата()-ВремНач));
	
	бинарникФайла = Новый ДвоичныеДанные(ТемпФайл);
	Контейнер = ?(Контейнер = Истина,"",Контейнер);

	Возврат ПоместитьВоВременноеХранилище(бинарникФайла,Контейнер);  
	
КонецФункции


