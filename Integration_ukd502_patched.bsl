//=================================================================================================

&НаСервере
Функция ОтправитьЗапросНаСервер(ТекстЗапроса, ВыводитьСообщенияВЖурнал=Истина) Экспорт
	Сайт = "gaz-ecm3.slms.ru";
	
	РезультатЗапроса = Неопределено;                                           
	
	// Создание файла с текстом отправляемого запроса
	//-------------------------------------------------------------------------------------------------
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.ДобавитьСтроку("--JUSTSOMESCRAPSTRING");
	ТекстовыйДокумент.ДобавитьСтроку("Content-Disposition: form-data; name=""xml""");
	ТекстовыйДокумент.ДобавитьСтроку("Content-Type: text/plain" + Символы.ВК + Символы.ПС);
	ТекстовыйДокумент.ДобавитьСтроку(ТекстЗапроса);
	ТекстовыйДокумент.ДобавитьСтроку("--JUSTSOMESCRAPSTRING");
	
	// Создание пакета HTTPЗапрос
	//-------------------------------------------------------------------------------------------------
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type","multipart/form-data;boundary=JUSTSOMESCRAPSTRING");
	
	Запрос = Новый HTTPЗапрос("/api/gateway/",Заголовки);
	Запрос.УстановитьТелоИзСтроки(ТекстовыйДокумент.ПолучитьТекст(), КодировкаТекста.UTF8);
	
	ИмяФайлаОтвета = ПолучитьИмяВременногоФайла("XML");
	
	Соединение = Новый HTTPСоединение(Сайт);
	РезультатЗапроса = Соединение.ОтправитьДляОбработки(Запрос, ИмяФайлаОтвета);
	
	Если РезультатЗапроса.КодСостояния=200 ИЛИ РезультатЗапроса.КодСостояния=201 ИЛИ РезультатЗапроса.КодСостояния=202 Тогда
		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьФайл(ИмяФайлаОтвета);
		
		ПостроительDOM        = Новый ПостроительDOM;
		ДокументDOM            = ПостроительDOM.Прочитать(Чтение);
		Чтение.Закрыть();
		РазыменовательПИ    = Новый РазыменовательПространствИменDOM(ДокументDOM);
		
		Ошибка = Ложь;    
		
		СписокОшибок        = ДокументDOM.ВычислитьВыражениеXPath("//*[contains(name(),'error')]", ДокументDOM, РазыменовательПИ);
		текСтрока = СписокОшибок.ПолучитьСледующий();
		Пока текСтрока<>Неопределено Цикл
			Ошибка = Истина;
			
			номерОшибки = текСтрока.Атрибуты.ПолучитьИменованныйЭлемент("num").Значение;
			описаниеОшибки = текСтрока.ТекстовоеСодержимое;
			
			Если ВыводитьСообщенияВЖурнал=Истина Тогда
				ЗаписьЖурналаРегистрации("Выгрузка_ГАЗ", УровеньЖурналаРегистрации.Ошибка, , , "При выполнении запроса возникла ошибка: "+описаниеОшибки+"("+номерОшибки+") "+ТекстЗапроса);		
			КонецЕсли; 
			
			текСтрока = СписокОшибок.ПолучитьСледующий();
		КонецЦикла; 
		
		Если Ошибка Тогда
			РезультатЗапроса = Неопределено;
		Иначе
			РезультатЗапроса = ДокументDOM;
		КонецЕсли; 
		
		ДокументDOM = Неопределено;
	Иначе
		Если ВыводитьСообщенияВЖурнал=Истина Тогда
			ЗаписьЖурналаРегистрации("Выгрузка_ГАЗ", УровеньЖурналаРегистрации.Ошибка, , , "При выполнении запроса возникла ошибка: "+СокрЛП(РезультатЗапроса.КодСостояния));
		КонецЕсли;
	КонецЕсли; 
	
	Возврат РезультатЗапроса;	
КонецФункции

&НаСервере
Функция УстановитьПодключение(Логин, Пароль) Экспорт
	Если ЗначениеЗаполнено(Логин)=Ложь Тогда
		Возврат Неопределено;		
	КонецЕсли; 
	
	идСессии = Неопределено;
	
	Запрос = СформироватьНачалоЗапроса("Authorize");
	
	Запрос.ЗаписатьНачалоЭлемента("login");
	Запрос.ЗаписатьТекст(Логин);
	Запрос.ЗаписатьКонецЭлемента();
	
	Запрос.ЗаписатьНачалоЭлемента("password");
	Запрос.ЗаписатьТекст(Пароль);
	Запрос.ЗаписатьКонецЭлемента();
	
	РезультатЗапроса = ВыполнитьЗапрос(Запрос);
	
	идСессии = ПолучитьЗначениеПараметра(РезультатЗапроса, "session_id");
	
	Возврат идСессии;
КонецФункции

&НаСервере
Функция ПолучитьЗначениеПараметра(Результат, выбПараметр) Экспорт
	нЗначение = Неопределено;
	
	Если ТипЗнч(Результат)=Тип("ДокументDOM") Тогда
		РазыменовательПИ    = Новый РазыменовательПространствИменDOM(Результат);
		
		текСтрока = Результат.ВычислитьВыражениеXPath("//*[name()='"+СокрЛП(выбПараметр)+"']", Результат, РазыменовательПИ).ПолучитьСледующий();
		Если текСтрока<>Неопределено Тогда
			нЗначение = текСтрока.ТекстовоеСодержимое;
		КонецЕсли; 
	КонецЕсли;
	
	Возврат нЗначение;
КонецФункции

&НаСервере
Функция СформироватьНачалоЗапроса(имяМетода, идСессии=Неопределено) Экспорт 
	Запрос = Новый ЗаписьXML;
	Запрос.УстановитьСтроку("UTF-8");
	Запрос.ЗаписатьОбъявлениеXML();
	
	Запрос.ЗаписатьНачалоЭлемента("request");
	Запрос.ЗаписатьАтрибут("method",имяМетода);
	
	Если ЗначениеЗаполнено(идСессии)=Истина Тогда
		Запрос.ЗаписатьНачалоЭлемента("session_id");
		Запрос.ЗаписатьТекст(идСессии);
		Запрос.ЗаписатьКонецЭлемента();		
	КонецЕсли; 
	
	Возврат Запрос;		
КонецФункции

&НаСервере
Функция ВыполнитьЗапрос(Запрос, ВыводитьСообщенияВЖурнал=Истина) Экспорт 
	Запрос.ЗаписатьКонецЭлемента();
	ТекстЗапроса = Запрос.Закрыть();
	
	РезультатЗапроса = ОтправитьЗапросНаСервер(ТекстЗапроса, ВыводитьСообщенияВЖурнал);
	
	Возврат РезультатЗапроса;
КонецФункции

