Процедура Пауза(КолСекунд) Экспорт
	
	// Процедура программно имитирует задержку (паузу) без загрузки процессора
	//-------------------------------------------------------------------------------------------------
	Доступно = (ТипЗнч(КолСекунд) = Тип("Число"));
	Доступно = Доступно И (Цел(КолСекунд) > 0);
	
	Если (Доступно = Истина) Тогда
		СтрКоманда = "Timeout /T " + СокрЛП(Формат(КолСекунд,"ЧГ=0")) + " /NoBreak";
		Клиент = Новый COMОбъект("WScript.Shell"); 
		Клиент.Run(СтрКоманда,0,-1);
	КонецЕсли;
КонецПроцедуры


//=================================================================================================
// Рассылка оповещений по запланированным на завтра машинозаездам
//=================================================================================================

Процедура СМСРассылкаЗавтраРемонт(Машинозаезд = Неопределено) Экспорт
	Запрос = Новый Запрос();
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Машинозаезд.ТочкаОформления КАК ТочкаОформления,
	|	Машинозаезд.Автомобиль КАК Автомобиль,
	|	Машинозаезд.СотрудникЗаявки КАК СотрудникЗаявки,
	|	Машинозаезд.КонтактныйТелефон КАК КонтактныйТелефон,
	|	МИНИМУМ(ЕСТЬNULL(Запись.ДатаНачала, ДАТАВРЕМЯ(1, 1, 1))) КАК ДатаЗаписи
	|ИЗ
	|	Документ.Машинозаезд КАК Машинозаезд
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ПланированиеРаботыПостов.ДокументПланирования КАК ДокументПланирования,
	|			МИНИМУМ(ПланированиеРаботыПостов.ДатаНачала) КАК ДатаНачала
	|		ИЗ
	|			РегистрСведений.ПланированиеРаботыПостов КАК ПланированиеРаботыПостов
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ПланированиеРаботыПостов.ДокументПланирования) КАК Запись
	|		ПО (Запись.ДокументПланирования = Машинозаезд.Ссылка)
	|ГДЕ
	|	ЕСТЬNULL(Запись.ДатаНачала, ДАТАВРЕМЯ(1, 1, 1)) МЕЖДУ НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ТекущаяДата, ДЕНЬ, 1), ДЕНЬ) И КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ТекущаяДата, ДЕНЬ, 1), ДЕНЬ)
	|	И Машинозаезд.Состояние = ЗНАЧЕНИЕ(Справочник.СтатусыДокументов.Заявка)
	|	И ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	Машинозаезд.ТочкаОформления,
	|	Машинозаезд.Автомобиль,
	|	Машинозаезд.СотрудникЗаявки,
	|	Машинозаезд.КонтактныйТелефон";
	Запрос.УстановитьПараметр("ТекущаяДата", ЗначенияСервера.ТекущаяДатаСервер());
	
	Если Машинозаезд <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИСТИНА", "Док.Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", Машинозаезд);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		КонтактныйТелефон = ВРег(СокрЛП(Выборка.КонтактныйТелефон));
		Доступно = Конвертация.ТелефонЭтоМобильный(КонтактныйТелефон);
		Доступно = Доступно И ЗначениеЗаполнено(Выборка.СотрудникЗаявки);
		
		Если (Доступно = Ложь) Тогда
			Продолжить;
		КонецЕсли;
		
		ДатаЗаписи 	= Формат(Выборка.ДатаЗаписи, "ДФ=dd.MM.yyyy");
		ВремяЗаписи = Формат(Выборка.ДатаЗаписи, "ДФ=HH:mm");
		Адрес 		= СокрЛП(Выборка.ТочкаОформления.Адрес);
		Адрес 		= Прав(Адрес, СтрДлина(Адрес)-7);
		Текст 		= СтрШаблон("Добрый день, благодарим Вас за обращение в ГК Луидор! Мы ждем Вас %1 в %2 по адресу %3. Не забывайте с собой документы на автомобиль, доверенность, копию ПТС с отметкой о регистрации автомобиля, сервисную книжку. Тел. 8-800-200-24-02", ДатаЗаписи, ВремяЗаписи, Адрес);
		
		Стр = Новый Структура();		
		Стр.Вставить("Текст",Текст);
		Стр.Вставить("Подпись","Luidor");
		Стр.Вставить("Телефон",КонтактныйТелефон);
		Стр.Вставить("Оператор","РегламентТехцентрЛуидор");
		Стр.Вставить("Холдер",Выборка.СотрудникЗаявки.Холдер);
		Стр.Вставить("ТочкаОформления",Выборка.СотрудникЗаявки.ТочкаОформления);
		Стр.Вставить("ВидДеятельности",Выборка.СотрудникЗаявки.ВидДеятельности);
		Рез = ТелефонияСервер.СообщениеОтправить(Стр);
	КонецЦикла;
КонецПроцедуры

//=================================================================================================
// Функции для выгрузки данных на сайт
//=================================================================================================

Функция ВыгрузитьНоменклатуру(ВыгружатьКартинки,ГруппыНоменклатуры,ТочкаОформления,Контейнер = Неопределено) Экспорт
	//Формирует и возвращает xml с остатками картинкой и т.д. по определенной точке оформления и списку
//номенклатуры за исключением группы с названием "00 Импорт", картинки выгружаются при проставленной 
//галке в поле ВыгружатьКартинки


	ВремНач = ТекущаяДата();
	БазовыйКаталогКартинок = Константы.СТО_БиблиотекаФайловПуть.Получить();
	
	ТемпФайл = ПолучитьИмяВременногоФайла();
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ТемпФайл);
	ЗаписьXML.ЗаписатьОбъявлениеXML();    
  	ЗаписьXML.ЗаписатьНачалоЭлемента("Запасы");
	ЗаписьXML.ЗаписатьАтрибут("ТочкаОформления", ТочкаОформления.Наименование);
	
//Получаем остатки и цены все остальные поля из реквизитов справочника номенклатуры, 
//путь к картинке из регистра СТО_БиблиотекаФайлов

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура КАК Номенклатура,
		|	СУММА(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток) КАК Количество,
		|	МАКСИМУМ(ЕСТЬNULL(Цены.Цена, 0)) КАК ЦенаРозничная
		|ПОМЕСТИТЬ ОстаткиЗапасов
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваровКомпании.Остатки(
		|			,
		|			СкладКомпании.ТочкаОформления = &ТочкаОформления
		|				И &Условие1) КАК ОстаткиТоваровКомпанииОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныТоваровКомпании.СрезПоследних(, ТипЦены = ЗНАЧЕНИЕ(Справочник.типыЦен.ОсновнойТипЦенПродажи)) КАК Цены
		|		ПО ОстаткиТоваровКомпанииОстатки.Номенклатура = Цены.Номенклатура
		|			И ОстаткиТоваровКомпанииОстатки.СкладКомпании.ТочкаОформления = Цены.ТочкаОформления
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СТО_БиблиотекаФайлов.Объект КАК Объект,
		|	СТО_БиблиотекаФайлов.Путь КАК Путь
		|ПОМЕСТИТЬ КартинкиВНоменклатуре
		|ИЗ
		|	РегистрСведений.СТО_БиблиотекаФайлов КАК СТО_БиблиотекаФайлов
		|ГДЕ
		|	СТО_БиблиотекаФайлов.Описание = ""Изображение""
		|	И СТО_БиблиотекаФайлов.ВидФайла = ЗНАЧЕНИЕ(Справочник.ВидыПрикрепляемыхФайлов.Номенклатура_Изображение)
		|	И СТО_БиблиотекаФайлов.Путь <> """"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СпрНоменклатура.КорневаяГруппа.Наименование КАК КорневаяГруппаНаименование,
		|	СпрНоменклатура.НаименованиеПолное КАК НаименованиеПолное,
		|	СпрНоменклатура.КодКаталога КАК КодКаталога,
		|	СпрНоменклатура.Ссылка КАК СсылкаНоменклатуры,
		|	ОстаткиЗапасов.Количество КАК ОстатокКоличество,
		|	ОстаткиЗапасов.ЦенаРозничная КАК ЦенаРозничная,
		|	СпрНоменклатура.Применяемость.(
		|		МодельАвтомобиля КАК МодельАвтомобиля
		|	) КАК Применяемость,
		|	ЕСТЬNULL(КартинкиВНоменклатуре.Путь, """") КАК КраткийПутьККартинке,
		|	СпрНоменклатура.ТНВЭД.КодТНВЭД КАК КодТНВЭД
		|ИЗ
		|	Справочник.Номенклатура КАК СпрНоменклатура
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиЗапасов КАК ОстаткиЗапасов
		|		ПО СпрНоменклатура.Ссылка = ОстаткиЗапасов.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ КартинкиВНоменклатуре КАК КартинкиВНоменклатуре
		|		ПО СпрНоменклатура.Ссылка = КартинкиВНоменклатуре.Объект
		|ГДЕ
		|	СпрНоменклатура.КорневаяГруппа <> ЗНАЧЕНИЕ(справочник.номенклатура.импорт)
		|	И &Условие2
		|
		|УПОРЯДОЧИТЬ ПО
		|	КорневаяГруппаНаименование";
	
	
	Если ГруппыНоменклатуры.Количество() > 0 тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Условие1", "Номенклатура В ИЕРАРХИИ(&ГруппыНоменклатуры)");	
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Условие2", "СпрНоменклатура.Ссылка В ИЕРАРХИИ(&ГруппыНоменклатуры)");	
		Запрос.УстановитьПараметр("ГруппыНоменклатуры", ГруппыНоменклатуры);
	иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Условие1", "ИСТИНА");	
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Условие2", "ИСТИНА");	
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ТочкаОформления", ТочкаОформления);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("Товар");
		ЗаписьXML.ЗаписатьАтрибут("КорневаяГруппа", ВыборкаДетальныеЗаписи.КорневаяГруппаНаименование);
		ЗаписьXML.ЗаписатьАтрибут("Наименование", ВыборкаДетальныеЗаписи.НаименованиеПолное);
		ЗаписьXML.ЗаписатьАтрибут("КодКаталога", ВыборкаДетальныеЗаписи.КодКаталога);
		ЗаписьXML.ЗаписатьАтрибут("Идентификатор", строка(ВыборкаДетальныеЗаписи.СсылкаНоменклатуры.УникальныйИдентификатор()));
		ЗаписьXML.ЗаписатьАтрибут("Остаток", Формат(ВыборкаДетальныеЗаписи.ОстатокКоличество,"ЧГ=0"));
		ЗаписьXML.ЗаписатьАтрибут("ЦенаРозничная", Формат(ВыборкаДетальныеЗаписи.ЦенаРозничная,"ЧГ=0"));  
		ЗаписьXML.ЗаписатьАтрибут("КодТНВЭД", ВыборкаДетальныеЗаписи.КодТНВЭД);  
			
		Если ВыгружатьКартинки и ВыборкаДетальныеЗаписи.КраткийПутьККартинке <> ""  тогда
			ПолныйПутьККартинке = СокрЛП(БазовыйКаталогКартинок) + СокрЛП(ВыборкаДетальныеЗаписи.КраткийПутьККартинке);
			ФайлОбъект = Новый Файл(ПолныйПутьККартинке);
			Если (ФайлОбъект.Существует() = Истина) тогда
				Попытка
					ЗаписьXML.ЗаписатьАтрибут("Картинка",  Base64Строка(Новый ДвоичныеДанные(ПолныйПутьККартинке)));
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;                                                                                                        
		
		ВыборкаПрименяемость = ВыборкаДетальныеЗаписи.Применяемость.Выбрать();
		Пока ВыборкаПрименяемость.Следующий() цикл
			Если ВыборкаПрименяемость.СемействоАвтомобилей <> Справочники.СемействаАвтомобилей.ПустаяСсылка() тогда 
				ЗаписьXML.ЗаписатьНачалоЭлемента("Применяемость");
