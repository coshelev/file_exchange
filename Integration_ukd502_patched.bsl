	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвПродПер");
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвПер");
	ЗаписьXML.ЗаписатьАтрибут("СодОпер", "Товары переданы");
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ОснПер");
	Если Найти(ДокВыгрузки.ДоговорВзаиморасчетов.Номер,"Оферта")>0 тогда      
		ЗаписьXML.ЗаписатьАтрибут("НаимОсн", "Оферта");
		ЗаписьXML.ЗаписатьАтрибут("НомОсн", Строка(Сред(ДокВыгрузки.ДоговорВзаиморасчетов.Номер,8)));
	Иначе
		ЗаписьXML.ЗаписатьАтрибут("НаимОсн", "Договор");                                     
		ЗаписьXML.ЗаписатьАтрибут("НомОсн", Строка(ДокВыгрузки.ДоговорВзаиморасчетов.Номер));
	КонецЕсли;
	ЗаписьXML.ЗаписатьАтрибут("ДатаОсн", Строка(Формат(ДокВыгрузки.ДоговорВзаиморасчетов.НачПериода, "ДЛФ=Д")));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	Если ТипЗнч(ДокВыгрузки) = Тип("ДокументСсылка.ЗаказНаряд")
		И ДокВыгрузки.Контрагент.ШаблонСтрокиДанныеТранспортировки = 1 Тогда 
