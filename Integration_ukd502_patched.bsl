КонецФункции	


Функция ПолучитьРНПТ(док)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПрослеживаемыеТовары.Партия КАК Партия,
	|	ПрослеживаемыеТовары.Номенклатура КАК Номенклатура,
	|	ПрослеживаемыеТовары.РНПТ КАК РНПТ,
	|	ПрослеживаемыеТовары.Количество КАК Количество,
	|	ПрослеживаемыеТовары.Сумма КАК Сумма,
	|	ПрослеживаемыеТовары.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ПрослеживаемыеТовары.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ПрослеживаемыеТовары.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеТовары КАК ПрослеживаемыеТовары
	|ГДЕ
	|	ПрослеживаемыеТовары.Регистратор = &Регистратор";
	
	Запрос.УстановитьПараметр("Регистратор", док);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультатЗапроса;
	
КонецФункции	

Функция ВыгрузитьДокументы_Партии(НачалоПериода, ОкончаниеПериода, ОрганизацияИНН="", МассивВидовДокументов=Неопределено, КлючКодаОбмена=Неопределено, ПокупательИНН="") Экспорт
	// Выгрузка документов за период
	// Дерево в разрезе видов документов
	// МассивВидовДокументов - массив имен метаданных выгружаемых документов
	// КлючКодаОбмена - разделитель для получения кода обмена, доступны "БУХ_КЗН" и "БУХ_УФА"
	//
	// ПокупательИНН - отбор по покупателю
	//
	// В свойстве "Номенклатура" находятся сведения обо всех выгруженных товарах
	// В свойстве "МежхолдерныеДвижения" находятся сведения обо всех межхолдерных движениях
	//-------------------------------------------------------------------------------------------------
	ДеревоДокументов = Новый Соответствие;
	ДокументыРНПТ = Новый Массив;
	ЕстьДокументыРНПТ = ПолучитьДокументыРНПТ(НачалоПериода, ОкончаниеПериода);
	Если ЗначениеЗаполнено(ЕстьДокументыРНПТ) тогда 
		ДокументыРНПТ = ЕстьДокументыРНПТ;       
	КонецЕсли;
	ДоступныеДокументы = Новый Массив;
	Массив = ДоступныеДляВыгрузкиДокументы();
	Для каждого текЭлемент Из Массив Цикл
		ДоступныеДокументы.Добавить(текЭлемент.Имя);		
	КонецЦикла; 
	
	ДокументыДляВыгрузки = Новый Массив;
	Если МассивВидовДокументов=Неопределено Тогда
		ДокументыДляВыгрузки = ДоступныеДокументы;
	Иначе
		Для каждого текЭлемент Из МассивВидовДокументов Цикл
			Если ДоступныеДокументы.Найти(текЭлемент)<>Неопределено Тогда
				ДокументыДляВыгрузки.Добавить(текЭлемент);
			КонецЕсли; 			
		КонецЦикла; 		
	КонецЕсли;
	
	ТЗСводныеАкты =  ПолучитьСводныеАкты(НачалоПериода, ОкончаниеПериода);

	
	
	
	
	НоменклатураДляВыгрузки=Новый СписокЗначений;
	КонтрагентыДляВыгрузки = Новый СписокЗначений;
	
	МассивДокументовСписанияТоваров = Новый Массив;
	МассивДокументовПередачиНаКомиссию = Новый Массив;
	ДокументыКонтурПродажиАвтомобилей = Новый Массив;
	ДокументыКонтурПродажиАвтомобилей.Добавить("ГАЗНЭЗакупка");
	ДокументыКонтурПродажиАвтомобилей.Добавить("НЭЗакупка");
	ДокументыКонтурПродажиАвтомобилей.Добавить("НЭРеализация");
	ДокументыКонтурПродажиАвтомобилей.Добавить("НЭПеремещение");
	ДокументыКонтурПродажиАвтомобилей.Добавить("НЭДоработка");
	ДокументыКонтурПродажиАвтомобилей.Добавить("НЭДоукомплектация");
	ДокументыКонтурПродажиАвтомобилей.Добавить("КСОСделкаСтрахование");
	ДокументыКонтурПродажиАвтомобилей.Добавить("НЭПередачаНаПереработку");
	ДокументыКонтурПродажиАвтомобилей.Добавить("НЭПриемИзПереработки");
	ДокументыКонтурПродажиАвтомобилей.Добавить("ДоговорТЭФЛ");
	ДокументыКонтурПродажиАвтомобилей.Добавить("НЭВодителиНаряды"); 
	ДокументыКонтурПродажиАвтомобилей.Добавить("НЭВодителиДоговоры"); 
	
	ДокументыКонтурПродажиАвтомобилей.Добавить("МТЗакупка");
	ДокументыКонтурПродажиАвтомобилей.Добавить("МТРеализация");
	
	ДокументыКонтурПродажиАвтомобилей.Добавить("НЭПередачаНаХранение");
	ДокументыКонтурПродажиАвтомобилей.Добавить("НЭПриемНаХранение");  
	ДокументыКонтурПродажиАвтомобилей.Добавить("НЭСнятиеИзХранения");
	ДокументыКонтурПродажиАвтомобилей.Добавить("НЭОтчетАгента"); 
	ДокументыКонтурПродажиАвтомобилей.Добавить("НЭПереоценкаВтор"); 
	
	// Документы
	//-------------------------------------------------------------------------------------------------
	Для каждого текЭлемент Из ДокументыДляВыгрузки Цикл
		МассивДокументов = Новый Массив;
		
		Если текЭлемент="НЭРеализация" Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Док.Ссылка КАК Ссылка,
			|	ЕСТЬNULL(НЭОтчетАгента.Ссылка, """") КАК ОтчетАгента
			|ИЗ
