&НаСервере
Функция ЗН_СформироватьXML_УПД503(ДокВыгрузки) Экспорт
	ИдОтпр = "2BK-0000000000-0000000";
	ИдПол = "2BK-0000000000-0000000000000";  
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПрослеживаемыеТовары.Номенклатура КАК Номенклатура,
	|	ПрослеживаемыеТовары.РНПТ КАК РНПТ,
	|	ПрослеживаемыеТовары.Количество КАК Количество,
	|	ПрослеживаемыеТовары.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ПрослеживаемыеТовары.СтранаПроисхождения КАК СтранаПроисхождения
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеТовары КАК ПрослеживаемыеТовары
	|ГДЕ
	|	ПрослеживаемыеТовары.Регистратор = &Регистратор";	
	Запрос.УстановитьПараметр("Регистратор", ДокВыгрузки);
	СведенияОПрослеживаемости = Запрос.Выполнить().Выгрузить();
	Если СведенияОПрослеживаемости.Количество() > 0 тогда 
		ВыводитьРНПТ = Истина;
	Иначе
		ВыводитьРНПТ = Ложь;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗначенияСвойствКонтрагентов.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствКонтрагентов КАК ЗначенияСвойствКонтрагентов
	|ГДЕ
	|	ЗначенияСвойствКонтрагентов.Контрагент = &Контрагент
	|	И ЗначенияСвойствКонтрагентов.Свойство = &Свойство";	
	Запрос.УстановитьПараметр("Контрагент", ДокВыгрузки.Контрагент); 
	Запрос.УстановитьПараметр("Свойство", Справочники.ЗначенияСвойствОбъектов.ГрузотправительПрочерк); 
	СвойствоПрочерк = Запрос.Выполнить().Выгрузить();
	Если СвойствоПрочерк.Количество() > 0 тогда 
		ВыводитьПрочерк = Истина;
	Иначе
		ВыводитьПрочерк = Ложь;	
	КонецЕсли;
	
	Если (ДокВыгрузки.Контрагент.ТипКонтрагента=Перечисления.ТипКонтрагента.Ип) ИЛИ (ДокВыгрузки.Контрагент.ТипКонтрагента=Перечисления.ТипКонтрагента.Фл ) Тогда
		КонтрИП = Истина;
	КонецЕсли;
	
	ДатаУПД = ДокВыгрузки.ДатаЗакрытия;
	НомУПД = ?(ЗначениеЗаполнено(ДокВыгрузки.НомерСчф), ДокВыгрузки.НомерСчф, ДокВыгрузки.Номер);	
	
	ОргИП = Ложь;
	БанковскийСчетКонтрагента = ДокВыгрузки.Контрагент.РасчСчет;
	БанковскийСчетФирмы = ДокВыгрузки.Организация.РасчСчет;
	СведенияОПоставщике = ЗначенияСервера.СведенияОЮрФизЛице(ДокВыгрузки.Организация, ДатаУПД);
	СведенияОПокупателе = ЗначенияСервера.СведенияОЮРФизЛице(ДокВыгрузки.Контрагент, ДатаУПД);
	
	Если ДокВыгрузки.Метаданные().Реквизиты.Найти("Получатель") <> Неопределено
		И ЗначениеЗаполнено(ДокВыгрузки.Получатель)
		И ТипЗнч(ДокВыгрузки.Получатель) = Тип("СправочникСсылка.Контрагенты") Тогда
		СведенияОГрузополучателе  = ЗначенияСервера.СведенияОЮрФизЛице(ДокВыгрузки.Получатель,  ДатаУПД);
		ПолучательПоДокументу = ДокВыгрузки.Получатель;
	Иначе
		СведенияОГрузополучателе  = СведенияОПокупателе;
		ПолучательПоДокументу = ДокВыгрузки.Контрагент;
	КонецЕсли;  
	
	СведенияОГрузоотправитель = СведенияОПоставщике;
	
	НовыйУникальныйИдентификатор = Новый УникальныйИдентификатор;
	ДатаДляИндифик = ТекущаяДата();
	Год   = Строка(Формат(ДатаДляИндифик, "ДФ=гггг")); // Год
	Месяц = Строка(Формат(ДатаДляИндифик, "ДФ=ММ"));   // Месяц
	День  = Строка(Формат(ДатаДляИндифик, "ДФ=дд"));   // День
	
	ДатаПреобразоваянная = Год + Месяц + День;
	
	ЗаписьXML = Новый ЗаписьXML;
	
	ЗаписьXML.УстановитьСтроку();
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Файл");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsd","http://www.w3.org/2001/XMLSchema");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi","http://www.w3.org/2001/XMLSchema-instance");
	
	ЗаписьXML.ЗаписатьАтрибут("ИдФайл", "ON_NSCHFDOPPR_" + ИдПол + "_" + ИдОтпр + "_" + ДатаПреобразоваянная + "_" + НовыйУникальныйИдентификатор);	
	ЗаписьXML.ЗаписатьАтрибут("ВерсФорм", "5.03");
	ЗаписьXML.ЗаписатьАтрибут("ВерсПрог", "Diadoc 1.0");
	ЗаписьXML.ЗаписатьНачалоЭлемента("Документ");	
	ЗаписьXML.ЗаписатьАтрибут("КНД", "1115131"); 	
	ЗаписьXML.ЗаписатьАтрибут("ПоФактХЖ", "Документ об отгрузке товаров (выполнении работ), передаче имущественных прав (документ об оказании услуг)");
	ЗаписьXML.ЗаписатьАтрибут("НаимДокОпр", "УПД");
