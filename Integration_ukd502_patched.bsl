Функция ЧЗВыбытие_СформироватьJSON_ПоТоварнойГруппе(ДокВыгрузки, ТоварнаяГруппа = "tires") Экспорт 
	//Выгружает документ "Честный знак: Расход" в json для конкретной товарной группы 	
	//см. описание https://docs.crpt.ru/gismt/True_API/#_%D0%B2%D1%8B%D0%B2%D0%BE%D0%B4_%D0%B8%D0%B7_%D0%BE%D0%B1%D0%BE%D1%80%D0%BE%D1%82%D0%B0
	
	//Возвращает json:
	//{
	//"inn": "7701234567",
	//"action": "OTHER",
	//"action_other": "использования для собственных нужд предприятия (в том числе отпуск в производство)",
	//"action_date": "2026-05-28",
	//"document_type": "OTHER",
	//"document_number": "000012345",
	//"document_date": "2026-05-28",
	//"primary_document_custom_name": "ПеремещениеТоваровВПроизводство",
	//"products": [{ "cis": "0104650117240408211dmfcZNcM" }, { "cis": "0104650117240408212dmfcZNcM"}]
	//}
	
	//см.описание товарных групп:	https://docs.crpt.ru/gismt/True_API/#_%D1%81%D0%BF%D1%80%D0%B0%D0%B2%D0%BE%D1%87%D0%BD%D0%B8%D0%BA_%D1%81%D0%BF%D0%B8%D1%81%D0%BE%D0%BA_%D0%BF%D0%BE%D0%B4%D0%B4%D0%B5%D1%80%D0%B6%D0%B8%D0%B2%D0%B0%D0%B5%D0%BC%D1%8B%D1%85_%D1%82%D0%BE%D0%B2%D0%B0%D1%80%D0%BD%D1%8B%D1%85_%D0%B3%D1%80%D1%83%D0%BF%D0%BF
	
	ПервичныйДокумент = ДокВыгрузки.Основание;
	НаименованиеДокумента = ПервичныйДокумент.Метаданные().Имя;
	
	Если НаименованиеДокумента = "РеализацияТоваров" Тогда
		ИНН = ПервичныйДокумент.Организация.ИНН;
		Причина = "реализации товаров в государства-члены ЕАЭС";
	ИначеЕсли НаименованиеДокумента = "ПеремещениеТоваровВПроизводство" Тогда
		ИНН = ПервичныйДокумент.ДокументОснование.Организация.ИНН;
		Причина = "использования для собственных нужд предприятия (в том числе отпуск в производство)";
	ИначеЕсли НаименованиеДокумента = "СписаниеТоваров" Тогда
		ИНН = ПервичныйДокумент.Организация.ИНН;
		Причина = "утрата товаров";       
	КонецЕсли;
	
	ДатаДокумента = Формат(ПервичныйДокумент.Дата, "ДФ=yyyy-MM-dd");
	
	МассивТоваров = Новый Массив;
	Для Каждого i Из ДокВыгрузки.Товары Цикл
		ЕстьСовпадение = Ложь;
		
		Если НЕ ЗначениеЗаполнено(i.КИЗ) Тогда
			Продолжить;
		КонецЕсли;
		
		Доступно = ТоварнаяГруппа = "tires" И i.Номенклатура.ВидМаркированнойПродукции = Перечисления.ВидыМаркированнойПродукции.Шины;
		Если Доступно Тогда
			ЕстьСовпадение = Истина;
		КонецЕсли;  
		
		Доступно = НЕ ЕстьСовпадение И ТоварнаяГруппа = "autofluids" И (i.Номенклатура.ВидМаркированнойПродукции = Перечисления.ВидыМаркированнойПродукции.Масла ИЛИ i.Номенклатура.ВидМаркированнойПродукции = Перечисления.ВидыМаркированнойПродукции.Антифризы);
		Если Доступно Тогда
			ЕстьСовпадение = Истина;
		КонецЕсли;  
		
		Доступно = НЕ ЕстьСовпадение И ТоварнаяГруппа = "perfumery" И i.Номенклатура.ВидМаркированнойПродукции = Перечисления.ВидыМаркированнойПродукции.ПарфюмерныеИКосметическиеСредстваИБытоваяХимия;
		Если Доступно Тогда
			ЕстьСовпадение = Истина;
		КонецЕсли;  
		
		Доступно =  НЕ ЕстьСовпадение И ТоварнаяГруппа = "carparts" И i.Номенклатура.ВидМаркированнойПродукции = Перечисления.ВидыМаркированнойПродукции.Автозапчасти;
		Если Доступно Тогда
			ЕстьСовпадение = Истина;
		КонецЕсли;    
		
		Если Не ЕстьСовпадение Тогда
			Продолжить;
		КонецЕсли;
		
		СтрКИ = Новый Структура;
		Если i.Номенклатура.ВидМаркированнойПродукции = Перечисления.ВидыМаркированнойПродукции.ПарфюмерныеИКосметическиеСредстваИБытоваяХимия Тогда
			СтрКИ.Вставить("cis", Лев(i.КИЗ, 24));
		Иначе
			СтрКИ.Вставить("cis", Лев(i.КИЗ, 31));
		КонецЕсли;
		МассивТоваров.Добавить(СтрКИ);		
	КонецЦикла;
	
	Если МассивТоваров.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	// Тело документа LK_RECEIPT (True API, формат MANUAL)
	ДокументJSON = Новый Структура;    
	//ДокументJSON.Вставить("type","LK_RECEIPT"); - ошибка
	ДокументJSON.Вставить("inn", СокрЛП(ИНН));
	ДокументJSON.Вставить("action", "OTHER");
	ДокументJSON.Вставить("action_other", Причина);
	ДокументJSON.Вставить("action_date", ДатаДокумента);
	ДокументJSON.Вставить("document_type", "OTHER");
	ДокументJSON.Вставить("document_number", СокрЛП(ПервичныйДокумент.Номер));
	ДокументJSON.Вставить("document_date", ДатаДокумента);
	ДокументJSON.Вставить("primary_document_custom_name", НаименованиеДокумента);
	ДокументJSON.Вставить("products", МассивТоваров);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(, Символы.Таб));
	ЗаписатьJSON(ЗаписьJSON, ДокументJSON);
	
	Возврат ЗаписьJSON.Закрыть();	
КонецФункции

&НаСервере
Функция ЧЗВыбытие_Выгрузка_в_ГИСМТ_ПоТоварнойГруппе(ГИСМТToken, ТоварнаяГруппа, jsonВыбытие) Экспорт 
	//HTTP - запрос в ГИСМТ (crpt.ru) на выгрузку документа выбытия товаров
	// см. https://docs.crpt.ru/gismt/True_API/#_%D0%B2%D1%8B%D0%B2%D0%BE%D0%B4_%D0%B8%D0%B7_%D0%BE%D0%B1%D0%BE%D1%80%D0%BE%D1%82%D0%B0
	
	Доступно =  ТипЗнч(ГИСМТToken) = Тип("Строка") 
		И ТипЗнч(jsonВыбытие) = Тип("Строка")
		И ЗначениеЗаполнено(ГИСМТToken)
		И ЗначениеЗаполнено(jsonВыбытие);
	Если Не Доступно Тогда
		Возврат "ошибка: неверные параметры";				
	КонецЕсли;	
		
	кмд = СтрШаблон("curl --request POST 'https://markirovka.crpt.ru/api/v3/true-api/lk/documents/create?pg=%1' -H 'Authorization: Bearer %2' -H 'Content-Type: application/json; charset=UTF-8' -H 'Accept: application/json' -d '%3'", ТоварнаяГруппа, ГИСМТToken, jsonВыбытие);
	Ответ = Авито.CURL(кмд); 
	Если ТипЗнч(Ответ)= Тип("Строка") Тогда
		Возврат Ответ;
	КонецЕсли;
	
	Возврат Ответ.КодСостояния();	
КонецФункции

&НаСервере
Функция ЧЗВыбытие_Выгрузка_в_ГИСМТ(ДокЧЗВыбытие, ГИСМТToken) Экспорт 
	
	Ответы = Новый Массив();
	
	ТоварныеГруппы = СтрРазделить("tires,autofluids,perfumery,carparts", ",");
	
	Для Каждого ТоварнаяГруппа Из ТоварныеГруппы Цикл
		
		jsonВыбытие = ЧЗВыбытие_СформироватьJSON_ПоТоварнойГруппе(ДокЧЗВыбытие,ТоварнаяГруппа);
		
		Если Не ЗначениеЗаполнено(jsonВыбытие) Тогда
			Продолжить;
		КонецЕсли;     
		
		Рез = ЧЗВыбытие_Выгрузка_в_ГИСМТ_ПоТоварнойГруппе(ГИСМТToken, ТоварнаяГруппа, jsonВыбытие);
		Если ТипЗнч(Рез) = Тип("Строка") Тогда
			Ответы.Добавить(Рез);
		КонецЕсли;
	КонецЦикла;     
	Возврат Ответы
КонецФункции
#КонецОбласти

&НаСервере
Функция Реализация_СформироватьXML_СЧФ503АктСвод(ДокВыгрузки) Экспорт
	ИдОтпр = "2BK-0000000000-0000000";
	ИдПол = "2BK-0000000000-0000000000000";  
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПрослеживаемыеТовары.Номенклатура КАК Номенклатура,
	|	ПрослеживаемыеТовары.РНПТ КАК РНПТ,
	|	ПрослеживаемыеТовары.Количество КАК Количество,
	|	ПрослеживаемыеТовары.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ПрослеживаемыеТовары.СтранаПроисхождения КАК СтранаПроисхождения
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеТовары КАК ПрослеживаемыеТовары
	|ГДЕ
	|	ПрослеживаемыеТовары.Регистратор = &Регистратор";
	
	Запрос.УстановитьПараметр("Регистратор", ДокВыгрузки);
	СведенияОПрослеживаемости = Запрос.Выполнить().Выгрузить();
	
	Если СведенияОПрослеживаемости.Количество() > 0 тогда 
		ВыводитьРНПТ = Истина;
	Иначе
		ВыводитьРНПТ = Ложь;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗначенияСвойствКонтрагентов.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствКонтрагентов КАК ЗначенияСвойствКонтрагентов
	|ГДЕ
	|	ЗначенияСвойствКонтрагентов.Контрагент = &Контрагент
	|	И ЗначенияСвойствКонтрагентов.Свойство = &Свойство";
	
	Запрос.УстановитьПараметр("Контрагент", ДокВыгрузки.Контрагент); 
	Запрос.УстановитьПараметр("Свойство", Справочники.ЗначенияСвойствОбъектов.ГрузотправительПрочерк); 
	СвойствоПрочерк = Запрос.Выполнить().Выгрузить();
	
	Если СвойствоПрочерк.Количество() > 0 тогда 
		ВыводитьПрочерк = Ложь;
	Иначе
		ВыводитьПрочерк = Ложь;	
	КонецЕсли;
	
	
	
	
	
	Если (ДокВыгрузки.Контрагент.ТипКонтрагента=Перечисления.ТипКонтрагента.Ип) ИЛИ (ДокВыгрузки.Контрагент.ТипКонтрагента=Перечисления.ТипКонтрагента.Фл ) Тогда
		КонтрИП = Истина;
	КонецЕсли;
	
	Если ТипЗнч(ДокВыгрузки) = Тип("ДокументСсылка.ЗаказНаряд") Тогда 
		ДатаУПД = ДокВыгрузки.ДатаЗакрытия;
	Иначе
		ДатаУПД = ДокВыгрузки.Дата;
	КонецЕсли;
	
	
	
	ОргИП = Ложь;
	БанковскийСчетКонтрагента = ДокВыгрузки.Контрагент.РасчСчет;
	БанковскийСчетФирмы = ДокВыгрузки.Организация.РасчСчет;
	СведенияОПоставщике = ЗначенияСервера.СведенияОЮрФизЛице(ДокВыгрузки.Организация, ДатаУПД);
	СведенияОПокупателе = ЗначенияСервера.СведенияОЮРФизЛице(ДокВыгрузки.Контрагент, ДатаУПД);
	
	Если ДокВыгрузки.Метаданные().Реквизиты.Найти("Получатель")<>Неопределено И ЗначениеЗаполнено(ДокВыгрузки.Получатель) и ТипЗнч(ДокВыгрузки.Получатель) = Тип("СправочникСсылка.Контрагенты") тогда
		СведенияОГрузополучателе  = ЗначенияСервера.СведенияОЮрФизЛице(ДокВыгрузки.Получатель,  ДатаУПД);
		ПолучательПоДокументу = ДокВыгрузки.Получатель;
	Иначе
		СведенияОГрузополучателе  = СведенияОПокупателе;
		ПолучательПоДокументу = ДокВыгрузки.Контрагент;
	КонецЕсли;  
	
	СведенияОГрузоотправитель = СведенияОПоставщике;
	
	НовыйУникальныйИдентификатор = Новый УникальныйИдентификатор;
	ДатаДляИндифик = ТекущаяДата();
	Год   = Строка(Формат(ДатаДляИндифик, "ДФ=гггг")); // Год
	Месяц = Строка(Формат(ДатаДляИндифик, "ДФ=ММ"));   // Месяц
	День  = Строка(Формат(ДатаДляИндифик, "ДФ=дд"));   // День
	
	ДатаПреобразоваянная = Год + Месяц + День;
	//НомерТелефона
	
	//-------------------------------------------------------------------------------------------------------
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	//Файл++
	ЗаписьXML.ЗаписатьНачалоЭлемента("Файл");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsd","http://www.w3.org/2001/XMLSchema");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi","http://www.w3.org/2001/XMLSchema-instance");
	ЗаписьXML.ЗаписатьАтрибут("ИдФайл", "ON_NSCHFDOPPR_" + ИдПол + "_" + ИдОтпр + "_" + ДатаПреобразоваянная + "_" + НовыйУникальныйИдентификатор);	
	ЗаписьXML.ЗаписатьАтрибут("ВерсФорм", "5.03");
	ЗаписьXML.ЗаписатьАтрибут("ВерсПрог", "Диадок 1.0");
	
	
	//Документ++
	ЗаписьXML.ЗаписатьНачалоЭлемента("Документ");	
	ЗаписьXML.ЗаписатьАтрибут("КНД", "1115131"); 
	ЗаписьXML.ЗаписатьАтрибут("Функция", "СЧФ");
	ЗаписьXML.ЗаписатьАтрибут("ДатаИнфПр", Формат(ДатаУПД, "ДЛФ=Д"));
	ЗаписьXML.ЗаписатьАтрибут("ВремИнфПр", "00.00.00");
	ЗаписьXML.ЗаписатьАтрибут("НаимЭконСубСост", ДокВыгрузки.Организация.НаименованиеПолное+", ИНН/КПП "+ДокВыгрузки.Организация.ИНН+"/"+ДокВыгрузки.Организация.КПП);
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвСчФакт"); //СвСчФакт
	ЗаписьXML.ЗаписатьАтрибут("НомерДок", ?(ЗначениеЗаполнено(ДокВыгрузки.НомерСчф),ДокВыгрузки.НомерСчф,ДокВыгрузки.Номер));
	Если ТипЗнч(ДокВыгрузки) = Тип("ДокументСсылка.ЗаказНаряд") Тогда 
		ЗаписьXML.ЗаписатьАтрибут("ДатаДок", Формат(ДатаУПД, "ДЛФ=Д"));
	Иначе
		ЗаписьXML.ЗаписатьАтрибут("ДатаДок", Формат(ДатаУПД, "ДЛФ=Д"));
	КонецЕсли;
	
	//Продавец
	
	//<СвПрод
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвПрод");
	ЗаписьXML.ЗаписатьАтрибут("ОКПО", ДокВыгрузки.Организация.ОКПО);
	//<ИдСв>
	ЗаписьXML.ЗаписатьНачалоЭлемента("ИдСв");
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвЮЛУч");  
	ЗаписьXML.ЗаписатьАтрибут("НаимОрг", ДокВыгрузки.Организация.НаименованиеПолное);
	ЗаписьXML.ЗаписатьАтрибут("ИННЮЛ", ДокВыгрузки.Организация.ИНН);
	ЗаписьXML.ЗаписатьАтрибут("КПП", ДокВыгрузки.Организация.КПП);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	//</ИдСв> 
	
	//<Адрес>	 
	ЗаписьXML.ЗаписатьНачалоЭлемента("Адрес"); 
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("АдрИнф");
	ЗаписьXML.ЗаписатьАтрибут("КодСтр","643"); 
	ЗаписьXML.ЗаписатьАтрибут("НаимСтран","Россия");
	ЗаписьXML.ЗаписатьАтрибут("АдрТекст", СокрЛП(СведенияОПоставщике.ЮридическийАдрес.ИсходныйАдрес));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	//</Адрес>
	
	Если ЗначениеЗаполнено(СведенияОПоставщике.НомерСчета) Тогда 
		//<БанкРекв
		ЗаписьXML.ЗаписатьНачалоЭлемента("БанкРекв");
		ЗаписьXML.ЗаписатьАтрибут("НомерСчета", Строка(СведенияОПоставщике.НомерСчета)); 
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("СвБанк");
		ЗаписьXML.ЗаписатьАтрибут("НаимБанк", СведенияОПоставщике.Банк.Наименование);
		ЗаписьXML.ЗаписатьАтрибут("БИК", Строка(СведенияОПоставщике.БИК));
		ЗаписьXML.ЗаписатьАтрибут("КорСчет", Строка(СведенияОПоставщике.КоррСчет));
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
		//</БанкРекв>
	КонецЕсли; 	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	//</СвПрод>
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ДокПодтвОтгрНом");
	ЗаписьXML.ЗаписатьАтрибут("РеквНаимДок", "Акт");
	ЗаписьXML.ЗаписатьАтрибут("РеквНомерДок", СокрЛП(ДокВыгрузки.Номер));
	ЗаписьXML.ЗаписатьАтрибут("РеквДатаДок", Формат(ДатаУПД, "ДЛФ=Д"));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	//<СвПокуп>
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвПокуп");
	//<ИдСв>
	ЗаписьXML.ЗаписатьНачалоЭлемента("ИдСв");
	//<СвЮЛУч 
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвЮЛУч");
	
	КПП = ДокВыгрузки.Контрагент.КПП;	//значение по умолчанию  
	ЗаписьXML.ЗаписатьАтрибут("НаимОрг", ДокВыгрузки.Контрагент.НаименованиеПолное);
	ЗаписьXML.ЗаписатьАтрибут("ИННЮЛ", ДокВыгрузки.Контрагент.ИНН); 
	ЗаписьXML.ЗаписатьАтрибут("КПП", КПП); 
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	//</ИдСв>
