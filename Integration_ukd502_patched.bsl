Функция ПодключитьИнформационнуюБазу(СтрокаПодключения,Кэшировать = Ложь) Экспорт
	ИБ = Неопределено;
	
	Если ПустаяСтрока(СтрокаПодключения)=Ложь Тогда
		// Ищем доступные соединения в кэше, вне зависимости от флага Кэшировать 
		//-------------------------------------------------------------------------------------------------
		АдресХранилищаСоединения = ПараметрыСеанса.КэшCOMСоединений.Получить(СтрокаПодключения);
		Если АдресХранилищаСоединения<>Неопределено Тогда
			СтруктураСоединения = ПолучитьИзВременногоХранилища(АдресХранилищаСоединения);
			
			Попытка
				ИБ = СтруктураСоединения.Объект;
				НомерВерсииПодключеннойБазы = СокрЛП(ИБ.Метаданные.Версия);
			Исключение
				НомерВерсииПодключеннойБазы = "";
			КонецПопытки;
			
			Если ПустаяСтрока(НомерВерсииПодключеннойБазы) Тогда
				ИБ = Неопределено;
				// Очистим временное хранилище 
				//-------------------------------------------------------------------------------------------------
				Попытка
					УдалитьИзВременногоХранилища(АдресХранилищаСоединения);
				Исключение
				КонецПопытки;
			КонецЕсли; 
		КонецЕсли; 
		
		Если ИБ=Неопределено Тогда
			// Если не нашли - создаем подключение
			//-------------------------------------------------------------------------------------------------
			V8COMConnector= Новый COMОбъект("V85.COMConnector");
			Попытка
				ИБ = V8COMConnector.Connect(СтрокаПодключения);
			Исключение
				Сообщить(ОписаниеОшибки());
				ИБ = Неопределено;
			КонецПопытки;
		КонецЕсли; 
		
		Если Кэшировать И ИБ<>Неопределено Тогда
			// Добавим соединение в кэш
			//-------------------------------------------------------------------------------------------------
			Попытка
				СтруктураСоединения = Новый Структура("Объект", ИБ);
				АдресХранилищаСоединения = ПоместитьВоВременноеХранилище(СтруктураСоединения, Новый УникальныйИдентификатор);
				
				ВременноеСоответствие = Новый Соответствие(ПараметрыСеанса.КэшCOMСоединений);
				ВременноеСоответствие.Вставить(СтрокаПодключения, АдресХранилищаСоединения);
				ПараметрыСеанса.КэшCOMСоединений = Новый ФиксированноеСоответствие(ВременноеСоответствие);
			Исключение
			КонецПопытки;
		КонецЕсли; 
	КонецЕсли; 
	
	Возврат ИБ;		
КонецФункции

Функция РегионПоНомеруТелефонаПолучить(Знач НомерТелефона) Экспорт
	
	// Функция по переданному номеру телефона пытается получить ссылку на элемент справочника "Страны"
	// Поиск элементов выполняется только в иерархии страны "Россия". Если элемент найден, то
	// возвращается ссылка на него. В противном случае возвращается Неопределено
	//-------------------------------------------------------------------------------------------------
	НомерТелефона = Конвертация.ТелефонВнешнийНормализовать(НомерТелефона);
	Доступно = Конвертация.ЭтоТолькоЦифры(НомерТелефона) И (СтрДлина(НомерТелефона) = 10);
	Ответ = Неопределено;
	
	Если (Доступно = Истина) Тогда
		ТекстЗапроса = "
		|SELECT	TOP 1 Region AS Регион
		|FROM	ВнешнийИсточникДанных.ТелСервер.Таблица.РегДиапазоны
		|WHERE	(&НомерТелефона BETWEEN From_Num AND To_Num) И (Region <> """")";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("НомерТелефона",НомерТелефона);
		Результат = Запрос.Выполнить().Выбрать();
		
		Если (Результат.Следующий()) Тогда
			СпрСсылка = Справочники.Страны.НайтиПоКоду(ВРег(СокрЛП(Результат.Регион)));
			Ответ = ?(ЗначениеЗаполнено(СпрСсылка),СпрСсылка,Ответ);
		КонецЕсли;
	КонецЕсли;
	
	Возврат (Ответ);
КонецФункции


