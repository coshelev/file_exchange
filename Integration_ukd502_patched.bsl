	// Дополнительные поля ИнфПолФХЖ1 из карточки контрагента (ТЧ "Данные"), напр. признак ОЗ
	МассивДопПолейИнфПолФХЖ1 = ДопПоляИнфПолФХЖ1Получить(ДокВыгрузки.Контрагент);
	Если МассивДопПолейИнфПолФХЖ1.Количество() > 0 Тогда
		НужноИнфПолФХЖ1 = Истина;
	КонецЕсли;
	
	//------ Пример. Первая строка - Списание в Честном знаке, вторая - просто CodeStock = 11111 
	//<ИнфПолФХЖ1>
	//	<ТекстИнф Идентиф="СвВыбытияМАРК" Значен="1"/> 
	//	<ТекстИнф Идентиф="CodeStock" Значен="11111"/>
	//  <ТекстИнф Идентиф="ПризнакОЗ" Значен="ОЗ"/>
	//</ИнфПолФХЖ1> 
	
	Если НужноИнфПолФХЖ1 Тогда
		ЗаписьXML.ЗаписатьНачалоЭлемента("ИнфПолФХЖ1"); 		
	КонецЕсли;
	
	//Вывод товара из оборота при реализации
	//<ТекстИнф Идентиф="СвВыбытияМАРК" Значен="1"/> 
	Если ЗначениеЗаполнено(СвВыбытияМАРК) Тогда 
		//Формироание элемента <ТекстИнф Идентиф="СвВыбытияМАРК" Значен="1"/>
		ЗаписьXML.ЗаписатьНачалоЭлемента("ТекстИнф"); 
		ЗаписьXML.ЗаписатьАтрибут("Идентиф", "СвВыбытияМАРК");
		ЗаписьXML.ЗаписатьАтрибут("Значен", СвВыбытияМАРК);
		ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЕсли; 
	
	// codeStock - элемент ТекстИнф с атрибутом codeStock 
	//<ТекстИнф Идентиф="CodeStock" Значен="11111"/>
	Если ЗначениеЗаполнено(CodeStockИдентиф) И ЗначениеЗаполнено(CodeStockЗначен) Тогда
		ЗаписьXML.ЗаписатьНачалоЭлемента("ТекстИнф"); 
		ЗаписьXML.ЗаписатьАтрибут("Идентиф", CodeStockИдентиф); 
		ЗаписьXML.ЗаписатьАтрибут("Значен", CodeStockЗначен);
		ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЕсли;
	
	// Доп.поля ИнфПолФХЖ1 из карточки контрагента (ТЧ "Данные"), напр. признак ОЗ
	ЗаписатьТекстИнфМассив(ЗаписьXML, МассивДопПолейИнфПолФХЖ1);
	
	Если НужноИнфПолФХЖ1 Тогда
		ЗаписьXML.ЗаписатьКонецЭлемента();  //"ИнфПолФХЖ1"
	КонецЕсли;
	//------ </ИнфПолФХЖ1> -----
		
	ЗаписьXML.ЗаписатьКонецЭлемента();//СвСчФакт
	
	//Табличная часть
	ЗаписьXML.ЗаписатьНачалоЭлемента("ТаблСчФакт");
	НомерСтроки = 0;
	ИтогКолМест = 0;
	ИтогБрутто = 0;
	ИтогНетто = 0;
	ИтогСумБезНДС = 0;
	ИтогСумНДС = 0;
	ИтогСумУчНДС = 0;  
	
	Если ТипЗнч(ДокВыгрузки)=Тип("ДокументСсылка.ЗаказНаряд") Тогда
		ДанныеТоваров = Новый Массив; 
		
		УчетнаяДата = ?(ЗначениеЗаполнено(ДокВыгрузки.ДатаЗакрытия),ДокВыгрузки.ДатаЗакрытия,ДокВыгрузки.Дата);
		ДокДата = СокрЛП(Формат(УчетнаяДата,"ДЛФ=DD"));
		
		НаименованиеУслуги = "Оказание услуг по ремонту и обслуживанию автотранспортного средства " + СокрЛП(ПечатныеФормы.СформироватьМодельАвтомобиляДляПечатнойФормы(ДокВыгрузки.ДокументОснование.Автомобиль));
		НаименованиеУслуги = НаименованиеУслуги + ", по заказ-наряду № " + ВРег(СокрЛП(ДокВыгрузки.Номер)) + " от " + ДокДата;
		
		стрТовар = Новый Структура;
		стрТовар.Вставить("Номенклатура", НаименованиеУслуги);
		стрТовар.Вставить("Количество", 1); 
		стрТовар.Вставить("Сумма", ДокВыгрузки.СуммаДокумента);
		стрТовар.Вставить("СуммаНДС", ДокВыгрузки.СуммаНДС);
		стрТовар.Вставить("СтавкаНДС", ДокВыгрузки.СтавкаНДС);
		
		ДанныеТоваров.Добавить(стрТовар);
	Иначе
		ДанныеТоваров = ДокВыгрузки.Товары.Выгрузить();
	КонецЕсли;
	
	Для Каждого стрТовар из ДанныеТоваров цикл
		ХарактеристикаДляПоиска = "";
		НомерСтроки = НомерСтроки + 1; 
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("СведТов");
		ЗаписьXML.ЗаписатьАтрибут("НомСтр", Строка(НомерСтроки));
		СтавкаКоэффициент = ЗначенияСервера.ПреобразуемСтавкиНДС(СтрТовар.СтавкаНДС);
		
		Если ЗначениеЗаполнено(СтрТовар.Сумма) И ЗначениеЗаполнено(СтрТовар.СтавкаНДС) Тогда		
			СуммаБезНДС = СтрТовар.Сумма - СтрТовар.СуммаНДС;
			СуммаНДСдоОкругления = СтрТовар.Сумма - СуммаБезНДС;
			СуммаНДСизСуммы = Окр(СуммаНДСдоОкругления, 2);
		КонецЕсли;
		Если ЗначениеЗаполнено(СуммаБезНДС) И ЗначениеЗаполнено(СтрТовар.Количество) Тогда		
			Цена = СуммаБезНДС / СтрТовар.Количество;
		КонецЕсли;
		ЗаписьXML.ЗаписатьАтрибут("НаимТов", СокрЛП(СтрТовар.Номенклатура));
		
		Если ТипЗнч(ДокВыгрузки)=Тип("ДокументСсылка.РеализацияТоваров") Тогда
			ЗаписьXML.ЗаписатьАтрибут("ОКЕИ_Тов", СокрЛП(СтрТовар.Номенклатура.ЕдиницаИзмерения.Код)); 
			ЗаписьXML.ЗаписатьАтрибут("НаимЕдИзм", СокрЛП(СтрТовар.Номенклатура.ЕдиницаИзмерения));
		КонецЕсли;
		
		ЗаписьXML.ЗаписатьАтрибут("КолТов", Строка(СтрЗаменить(СтрТовар.Количество, Символы.НПП,"")));
		ЗаписьXML.ЗаписатьАтрибут("ЦенаТов",Строка(Формат(Цена,"ЧДЦ=2; ЧГ=0; ЧРД=.")));
		ЗаписьXML.ЗаписатьАтрибут("НалСт", СтавкаКоэффициент.Ставка);  
		ЗаписьXML.ЗаписатьАтрибут("СтТовБезНДС", Строка(Формат(СуммаБезНДС,"ЧДЦ=2; ЧГ=0; ЧРД=.")));
		ЗаписьXML.ЗаписатьАтрибут("СтТовУчНал", Строка(Формат(СтрТовар.Сумма,"ЧДЦ=2; ЧГ=0; ЧРД=.")));
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ДопСведТов");
		ЗаписьXML.ЗаписатьАтрибут("ПрТовРаб", "1");
		ЗаписьXML.ЗаписатьАтрибут("КодТов", СокрЛП(?(СокрЛП(СтрТовар.Номенклатура.Артикул)="",СтрТовар.Номенклатура.КодКаталога,СтрТовар.Номенклатура.Артикул)));
		ЗаписьXML.ЗаписатьАтрибут("НадлОтп", "2"); 
		
		//Маркировка
		мКИЗ = ПолучитьКИЗ(ДокВыгрузки,СтрТовар.Номенклатура);
		Если мКИЗ.Количество() > 0 Тогда
			//Для парфюмерии до 2030 г. передаем только ГТИН и кол-во
			Если СтрТовар.Номенклатура.ВидМаркированнойПродукции = Перечисления.ВидыМаркированнойПродукции.ПарфюмерныеИКосметическиеСредстваИБытоваяХимия Тогда
				ЗаписьXML.ЗаписатьАтрибут("ГТИН", Сред(мКИЗ[0].КИЗ,3,14));
				ЗаписьXML.ЗаписатьНачалоЭлемента("НомСредИдентТов");
				ЗаписьXML.ЗаписатьАтрибут("КолВедМарк", Строка(СтрЗаменить(СтрТовар.Количество, Символы.НПП,"")));
			Иначе
				ЗаписьXML.ЗаписатьНачалоЭлемента("НомСредИдентТов");  
				Для Каждого стрКИЗ из мКИЗ Цикл
					ЗаписьXML.ЗаписатьНачалоЭлемента("КИЗ"); 
					ЗаписьXML.ЗаписатьТекст(Лев(стрКИЗ.КИЗ,31));
					ЗаписьXML.ЗаписатьКонецЭлемента();
				КонецЦикла;
			КонецЕсли;
			ЗаписьXML.ЗаписатьКонецЭлемента();//НомСредИдентТов
		КонецЕсли;
		
		ЗаписьXML.ЗаписатьКонецЭлемента();//ДопСведТов
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Акциз");
		ЗаписьXML.ЗаписатьНачалоЭлемента("БезАкциз");
		ЗаписьXML.ЗаписатьТекст("без акциза");
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("СумНал"); 
		Если СуммаНДСизСуммы > 0 Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента("СумНал");
			ЗаписьXML.ЗаписатьТекст(Строка(Формат(СуммаНДСизСуммы,"ЧДЦ=2; ЧГ=0; ЧРД=.")));
		ИначеЕсли СуммаНДСизСуммы = 0 Тогда		
			ЗаписьXML.ЗаписатьНачалоЭлемента("БезНДС");
			ЗаписьXML.ЗаписатьТекст("без НДС");
		КонецЕсли;
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		//Если заполнен ID Заказа (для АВТОПИТЕР) выводим его, иначе Штрихкод
		Если ЗначениеЗаполнено(ДокВыгрузки.ДокументОснование)
			И ТипЗнч(ДокВыгрузки.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			текIDЗаказа = ПолучитьIDЗаказа(ДокВыгрузки.ДокументОснование, СтрТовар.Номенклатура);
		КонецЕсли;
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ИнфПолФХЖ2");
		Если ЗначениеЗаполнено(текIDЗаказа) Тогда
			ЗаписьXML.ЗаписатьАтрибут( "Идентиф", "ИдентификаторЗаказаКлиента");
			ЗаписьXML.ЗаписатьАтрибут("Значен", СокрЛП(текIDЗаказа));			
		Иначе
			ЗаписьXML.ЗаписатьАтрибут( "Идентиф", "штрихкод");
			ЗаписьXML.ЗаписатьАтрибут("Значен", СокрЛП(СтрТовар.Номенклатура.ШтрихКод));
		КонецЕсли;
		ЗаписьXML.ЗаписатьКонецЭлемента();//ИнфПолФХЖ2
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ИтогКолМест = ИтогКолМест + СтрТовар.Количество; 
		ИтогНетто = ИтогНетто + СтрТовар.Количество;
		ИтогСумБезНДС = ИтогСумБезНДС + СуммаБезНДС;
		ИтогСумНДС = ИтогСумНДС + СтрТовар.СуммаНДС;	
		ИтогСумУчНДС = ИтогСумУчНДС + СтрТовар.Сумма;		
	КонецЦикла;
	// Конец табличной части
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ВсегоОпл");
	ЗаписьXML.ЗаписатьАтрибут("СтТовБезНДСВсего", Строка(Формат(ИтогСумБезНДС,"ЧДЦ=2; ЧГ=0; ЧРД=.")));
	ЗаписьXML.ЗаписатьАтрибут("СтТовУчНалВсего", Строка(Формат(ИтогСумУчНДС,"ЧДЦ=2; ЧГ=0; ЧРД=.")));
	ЗаписьXML.ЗаписатьАтрибут("КолНеттоВс","0" );	
	ЗаписьXML.ЗаписатьНачалоЭлемента("СумНалВсего");
	ЗаписьXML.ЗаписатьНачалоЭлемента("СумНал");
	ЗаписьXML.ЗаписатьТекст(Строка(Формат(ИтогСумНДС,"ЧДЦ=2; ЧГ=0; ЧРД=.")));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвПродПер");
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвПер");
	ЗаписьXML.ЗаписатьАтрибут("СодОпер", "Товары переданы"); 
	ЗаписьXML.ЗаписатьАтрибут("ДатаПер", Формат(ДатаУПД, "ДЛФ=Д"));
	ЗаписьXML.ЗаписатьНачалоЭлемента("ОснПер");
	ЗаписьXML.ЗаписатьАтрибут("РеквНаимДок", "Договор");                                     
	ЗаписьXML.ЗаписатьАтрибут("РеквНомерДок", Строка(ДокВыгрузки.ДоговорВзаиморасчетов.Номер));
	ЗаписьXML.ЗаписатьАтрибут("РеквДатаДок", Строка(Формат(ДокВыгрузки.ДоговорВзаиморасчетов.НачПериода, "ДЛФ=Д")));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	Если ТипЗнч(ДокВыгрузки) = Тип("ДокументСсылка.ЗаказНаряд")
		И ДокВыгрузки.Контрагент.ШаблонСтрокиДанныеТранспортировки = 1 Тогда 
		ЗаписьXML.ЗаписатьНачалоЭлемента("ТранГруз");
		ДатаТранГруз = ?(ЗначениеЗаполнено(ДокВыгрузки.ДатаЗакрытия),ДокВыгрузки.ДатаЗакрытия,ДокВыгрузки.Дата); 
		СтрТранГруз = "Заказ-наряд № "+СокрЛП(ДокВыгрузки.Номер)+" от "+Формат(ДатаТранГруз,"ДЛФ=Д")+" г.";
		ЗаписьXML.ЗаписатьАтрибут("СвТранГруз", СтрТранГруз);
		ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвПерВещи");
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьНачалоЭлемента("ИнфПолФХЖ3");
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	//Подписант
	ЗаписьXML.ЗаписатьНачалоЭлемента("Подписант");
	ЗаписьXML.ЗаписатьАтрибут("ОснПолн", "Должностные обязанности");
	ЗаписьXML.ЗаписатьАтрибут("ОблПолн", "1");
	ЗаписьXML.ЗаписатьАтрибут("Статус", "1");	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ЮЛ");
	
	Если ЗначениеЗаполнено(ДокВыгрузки.Организация.ИНН) Тогда
		ЗаписьXML.ЗаписатьАтрибут("ИННЮЛ", ДокВыгрузки.Организация.ИНН);		
	Иначе 		
		ЗаписьXML.ЗаписатьАтрибут("ИННЮЛ", "0101010108");
	КонецЕсли;
	
	//ПодписантОветственный = "";
	РукФ = "";
	РукИ = "";
	РукО = "";
	Если ЗначениеЗаполнено(ДокВыгрузки.Организация.Руководитель) Тогда
		РукФИО = СтрЗаменить(ДокВыгрузки.Организация.Руководитель, " ", Символы.ПС);
		Если СтрЧислоСтрок(РукФИО) = 3 Тогда
			РукФ = СокрЛП(СтрПолучитьСтроку(РукФИО, 1));
			РукИ = СокрЛП(СтрПолучитьСтроку(РукФИО, 2));
			РукО = СокрЛП(СтрПолучитьСтроку(РукФИО, 3));
		КонецЕсли;			
	КонецЕсли;
	ЗаписьXML.ЗаписатьАтрибут("Должн", "Директор");
	ЗаписьXML.ЗаписатьНачалоЭлемента("ФИО");
	ЗаписьXML.ЗаписатьАтрибут("Фамилия", ?(ЗначениеЗаполнено(РукФ),РукФ,"Ф"));
	ЗаписьXML.ЗаписатьАтрибут("Имя", ?(ЗначениеЗаполнено(РукИ),РукИ,"И"));	
	ЗаписьXML.ЗаписатьАтрибут("Отчество", ?(ЗначениеЗаполнено(РукО),РукО,"О"));
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента(); 
	
	Возврат ЗаписьXML.Закрыть();
КонецФункции 

&НаСервере
Функция МТРеализация_СформироватьXML_УПД503(ДокВыгрузки) Экспорт
	ИдОтпр = "2BK-0000000000-0000000";
	ИдПол = "2BK-0000000000-0000000000000";  
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПрослеживаемыеТовары.Номенклатура КАК Номенклатура,
	|	ПрослеживаемыеТовары.РНПТ КАК РНПТ,
	|	ПрослеживаемыеТовары.Количество КАК Количество,
	|	ПрослеживаемыеТовары.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ПрослеживаемыеТовары.СтранаПроисхождения КАК СтранаПроисхождения
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеТовары КАК ПрослеживаемыеТовары
	|ГДЕ
	|	ПрослеживаемыеТовары.Регистратор = &Регистратор";	
	Запрос.УстановитьПараметр("Регистратор", ДокВыгрузки);
	СведенияОПрослеживаемости = Запрос.Выполнить().Выгрузить();
	Если СведенияОПрослеживаемости.Количество() > 0 тогда 
		ВыводитьРНПТ = Истина;
	Иначе
		ВыводитьРНПТ = Ложь;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗначенияСвойствКонтрагентов.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствКонтрагентов КАК ЗначенияСвойствКонтрагентов
	|ГДЕ
	|	ЗначенияСвойствКонтрагентов.Контрагент = &Контрагент
	|	И ЗначенияСвойствКонтрагентов.Свойство = &Свойство";
	Запрос.УстановитьПараметр("Контрагент", ДокВыгрузки.Покупатель); 
	Запрос.УстановитьПараметр("Свойство", Справочники.ЗначенияСвойствОбъектов.ГрузотправительПрочерк); 
	СвойствоПрочерк = Запрос.Выполнить().Выгрузить();
	Если СвойствоПрочерк.Количество() > 0 тогда 
