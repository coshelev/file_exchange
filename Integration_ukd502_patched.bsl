	|		РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.Проведен = ИСТИНА
	|		И РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.Организация.ИНН = &ИНН
	|		И РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.Дата МЕЖДУ &начДата И &конДата
	|		И Ссылка.ВидОперации В (&СписаниеРасшифровкаПлатежа)
	|		
	|;
	|ВЫБРАТЬ
	|		РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка,
	|		ПРЕДСТАВЛЕНИЕ(РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка) КАК СсылкаПредставление,
	|		РасходныйКассовыйОрдерРасшифровкаПлатежа.Организация,
	|		РасходныйКассовыйОрдерРасшифровкаПлатежа.ВидОперации,
	|		РасходныйКассовыйОрдерРасшифровкаПлатежа.Контрагент,
	|		РасходныйКассовыйОрдерРасшифровкаПлатежа.Комментарий,
	|		РасходныйКассовыйОрдерРасшифровкаПлатежа.ДокументОснование,
	|		РасходныйКассовыйОрдерРасшифровкаПлатежа.СубконтоДт1,
	|		РасходныйКассовыйОрдерРасшифровкаПлатежа.СубконтоДт2,
	|		РасходныйКассовыйОрдерРасшифровкаПлатежа.СубконтоДт3,
	|		1 КАК НомерСтроки,
	|		РасходныйКассовыйОрдерРасшифровкаПлатежа.ДоговорКонтрагента,
	|		РасходныйКассовыйОрдерРасшифровкаПлатежа.СуммаДокумента,
	|		РасходныйКассовыйОрдерРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств,
	|		"""" ,
	|		ЛОЖЬ КАК Приход
	|ПОМЕСТИТЬ РКО
	|	ИЗ
	|		Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдерРасшифровкаПлатежа
	|	ГДЕ
	|		РасходныйКассовыйОрдерРасшифровкаПлатежа.Проведен = ИСТИНА
	|		И РасходныйКассовыйОрдерРасшифровкаПлатежа.Организация.ИНН = &ИНН
	|		И РасходныйКассовыйОрдерРасшифровкаПлатежа.Дата МЕЖДУ &начДата И &конДата
	|		И НЕ Ссылка В (ВЫБРАТЬ Ссылка ИЗ РКО_Строки)
	|
	|;
	|ВЫБРАТЬ
	|		ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка КАК Ссылка,
	|		ПРЕДСТАВЛЕНИЕ(ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка) КАК СсылкаПредставление,
	|		ПриходныйКассовыйОрдерРасшифровкаПлатежа.Организация КАК Организация,
	|		ПриходныйКассовыйОрдерРасшифровкаПлатежа.ВидОперации КАК ВидОперации,
	|		ПриходныйКассовыйОрдерРасшифровкаПлатежа.Контрагент КАК Контрагент,
	|		ПриходныйКассовыйОрдерРасшифровкаПлатежа.Комментарий КАК Комментарий,
	|		ПриходныйКассовыйОрдерРасшифровкаПлатежа.ДокументОснование КАК ДокументОснование,
	|		ПриходныйКассовыйОрдерРасшифровкаПлатежа.СубконтоКт1 КАК Субконто1,
	|		ПриходныйКассовыйОрдерРасшифровкаПлатежа.СубконтоКт2 КАК Субконто2,
	|		ПриходныйКассовыйОрдерРасшифровкаПлатежа.СубконтоКт3 КАК Субконто3,
	|		1 КАК НомерСтроки,
	|		ПриходныйКассовыйОрдерРасшифровкаПлатежа.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|		ПриходныйКассовыйОрдерРасшифровкаПлатежа.СуммаДокумента КАК СуммаПлатежа,
	|		ПриходныйКассовыйОрдерРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
	|		"""" КАК СчетНаОплату,
	|		ИСТИНА КАК Приход
	|ПОМЕСТИТЬ ПКО
	|	ИЗ
	|		Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдерРасшифровкаПлатежа
	|	ГДЕ
	|		ПриходныйКассовыйОрдерРасшифровкаПлатежа.Проведен = ИСТИНА
	|		И ПриходныйКассовыйОрдерРасшифровкаПлатежа.Организация.ИНН = &ИНН
	|		И ПриходныйКассовыйОрдерРасшифровкаПлатежа.Дата МЕЖДУ &начДата И &конДата
	|		И НЕ Ссылка В (ВЫБРАТЬ Ссылка ИЗ ПКО_Строки)
	|
	|;			
	|ВЫБРАТЬ
	|	Данные.Ссылка,
	|	Данные.Ссылка.Номер КАК Номер,
	|	Данные.Ссылка.Дата КАК Дата,
	|	Данные.Ссылка.ПометкаУдаления КАК ПометкаУдаления,
	|	Данные.Организация,
	|	Данные.ВидОперации,
	|	Данные.Контрагент,
	|	Данные.Комментарий,
	|	Данные.ДокументОснование,
	|	Данные.Субконто1,
	|	Данные.Субконто2,
	|	Данные.Субконто3,
	|	Данные.СтатьяДвиженияДенежныхСредств,
	|	Данные.НомерСтроки,
	|	Данные.ДоговорКонтрагента,
	|	Данные.СуммаПлатежа,
	|	Данные.СчетНаОплату,
	|	Данные.Приход,
	|	Данные.СсылкаПредставление,
	|	Данные.Ссылка.ПодразделениеОрганизации КАК Подразделение
	|ИЗ
	|	(ВЫБРАТЬ * ИЗ ПКО_Строки
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ * ИЗ РКО_Строки
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ * ИЗ РКО
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ * ИЗ ПКО
	|	) КАК Данные
	|
	|ГДЕ Данные.Ссылка.Проведен=ИСТИНА
	|	И Данные.Ссылка.ПодразделениеОрганизации В (&ОтборПодразделений)
	|	И Данные.Ссылка.СтатьяДвиженияДенежныхСредств В (&ОтборСтатейДДС)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Данные.Ссылка.Дата
	|";	
	
	Запрос.УстановитьПараметр("ИНН", Организация.ИНН);
	Запрос.УстановитьПараметр("начДата", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("конДата", КонецДня(ОкончаниеПериода));
	
	Запрос.УстановитьПараметр("ПоступлениеРасшифровкаПлатежа", ИБ.Документы.ПриходныйКассовыйОрдер.ПолучитьСписокВидовОперацийСРасшифровкойПлатежа());
	Запрос.УстановитьПараметр("СписаниеРасшифровкаПлатежа", ИБ.Документы.РасходныйКассовыйОрдер.ПолучитьСписокВидовОперацийСРасшифровкойПлатежа());
	
	Запрос.УстановитьПараметр("ОтборПодразделений", ОтборПодразделений);
	Запрос.УстановитьПараметр("ОтборСтатейДДС", ОтборСтатейДДС);
	
	Выборка=Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТочкаОформления = СоответствиеПодразделений.Получить(ИБ.XMLСтрока(Выборка.Подразделение));
		СтатьяБюджета = СоответствиеСтатейБюджета.Получить(ИБ.XMLСтрока(Выборка.СтатьяДвиженияДенежныхСредств));
		
		Если (ЗначениеЗаполнено(ТочкаОформления)=Ложь) ИЛИ (ЗначениеЗаполнено(СтатьяБюджета)=Ложь) Тогда
			Продолжить;			
		КонецЕсли; 
		
		НоваяСтрока = Данные.Добавить();
		
		НоваяСтрока.ПериодМесяц = НачалоМесяца(Выборка.Дата);
		НоваяСтрока.СтатьяБюджета = СтатьяБюджета;
		НоваяСтрока.Организация = Организация;
		НоваяСтрока.ТочкаОформления = ТочкаОформления;
		
		НоваяСтрока.ДокументИдентификатор = ИБ.XMLСтрока(Выборка.Ссылка)+?(Выборка.НомерСтроки=1,"","_"+ИБ.XMLСтрока(Выборка.НомерСтроки));
		НоваяСтрока.ДокументПредставление = Выборка.СсылкаПредставление;
		НоваяСтрока.ДокументНомер = Выборка.Номер;
		НоваяСтрока.ДокументДата = Выборка.Дата;
		
		НоваяСтрока.Показатель = Выборка.СуммаПлатежа;
		
		НоваяСтрока.ВидДвижения = Выборка.Приход;
	КонецЦикла;
	
	// Сохранение результатов
	//======================================================================================================================
	ПериодМесяц = НачалоМесяца(НачалоПериода);
	Пока КонецМесяца(ПериодМесяц)<=КонецМесяца(ОкончаниеПериода) Цикл
		НайденныеСтроки = Данные.НайтиСтроки(Новый Структура("ПериодМесяц", ПериодМесяц));
		
		НаборЗаписей = РегистрыСведений.ФинансовыйРезультатИмпорт.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Организация.Установить(Организация);
		НаборЗаписей.Отбор.ПериодМесяц.Установить(ПериодМесяц);
		
		Для каждого текСтрока Из НайденныеСтроки Цикл
			НоваяЗапись = НаборЗаписей.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяЗапись, текСтрока);			
		КонецЦикла; 
		
		Попытка
			НаборЗаписей.Записать(Истина);
		Исключение
			Результат = Результат+Символы.ПС+ОписаниеОшибки();
		КонецПопытки;
		
		ПериодМесяц = НачалоМесяца(ДобавитьМесяц(ПериодМесяц, 1));			
	КонецЦикла; 
	
	Возврат Результат;
КонецФункции

